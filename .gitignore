# Generated shell state/cache and OS cruft.
.DS_Store
*.zwc
*.bak

# Python bytecode/cache. The repo ships no python tool today, but a scratch
# script or an importing harness would leave these behind; keep them out of the
# tree (and out of the Makefile's bin/* globs).
__pycache__/
*.pyc

# `make smoke` / `make forkgate` hermetic scratch HOME/XDG trees (bin/smoke,
# bin/startup-fork-gate) - in-repo so nothing is written outside
# ~/.config/dotfiles; never tracked.
.forkgate/
.smoke/

# Machine-only `.local` layers: never tracked, never published.
# Covers `foo.local`, `gh-extensions.local.txt`, `alacritty.local.toml`, etc.
# The `.example` templates that document each layer stay committable (last match
# wins).
*.local
*.local.*
!*.local*.example

# Key and credential material, anywhere in the tree. Defense in depth behind
# `make secret-scan` and gitleaks: git itself refuses to stage a stray private
# key, certificate bundle or env file. tests/gitignore_test.sh pins the list and
# proves no tracked file matches it. A documented template keeps the `.example`
# suffix and stays committable (last match wins).
*.pem
*.key
*.p12
*.pfx
.env
.env.*
id_rsa*
id_ecdsa*
id_ed25519*
!*.example

# rclone/restic hold secrets and are NEVER linked; the repo keeps
# only README/*.example. Belt-and-suspenders: ignore everything in
# those dirs so a real `rclone.conf` / restic password can never be committed by
# accident, then re-include the README and templates. (Exclude the dir CONTENTS
# with `/*`, not the dir itself, so the re-includes below still take effect.)
config/rclone/*
config/restic/*
!config/rclone/README.md
!config/rclone/*.example
!config/restic/README.md
!config/restic/*.example
