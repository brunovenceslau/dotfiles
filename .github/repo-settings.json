{
  "$comment": "Expected GitHub settings for this repository. Change this file FIRST, then the live setting. tests/repo_settings_test.sh holds the docs and ci.yml to it; `make repo-settings-check` diffs it against the live repository. See docs/development.md, 'Repository settings'. Required checks pin no integration_id on purpose: the file records that none is set, so one appearing is drift.",
  "repository": "brunovenceslau/dotfiles",
  "repo": {
    "default_branch": "main",
    "allow_merge_commit": true,
    "allow_squash_merge": false,
    "allow_rebase_merge": false,
    "allow_update_branch": true,
    "allow_auto_merge": false,
    "delete_branch_on_merge": true,
    "has_wiki": false,
    "has_projects": false,
    "has_discussions": false
  },
  "private_vulnerability_reporting": {
    "enabled": true
  },
  "vulnerability_alerts": {
    "enabled": true
  },
  "actions_permissions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "actions_selected_actions": {
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": []
  },
  "actions_workflow": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_pr_contributor_approval": {
    "approval_policy": "all_external_contributors"
  },
  "rulesets": [
    {
      "name": "main-protection",
      "target": "branch",
      "enforcement": "active",
      "include": [
        "refs/heads/main"
      ],
      "exclude": [],
      "bypass_actors": [],
      "rules": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_signatures",
        "required_status_checks"
      ],
      "required_status_checks": [
        {
          "context": "local-ci (macos-arm64)"
        },
        {
          "context": "local-ci (macos-intel)"
        }
      ],
      "status_check_policy": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false
      },
      "pull_request": {
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": true
      }
    },
    {
      "name": "release-tags",
      "target": "tag",
      "enforcement": "active",
      "include": [
        "refs/tags/v*"
      ],
      "exclude": [],
      "bypass_actors": [],
      "rules": [
        "deletion",
        "non_fast_forward"
      ]
    }
  ]
}
