# SPDX-License-Identifier: GPL-3.0-or-later

#
# secret-scan - high-confidence secret-shaped content scanner.
#
# The automated backing for the repo's no-committed-secret rule:
# `make secret-scan` runs it over the tracked files.
#
# CONSERVATIVE BY DESIGN. It matches only HIGH-SIGNAL shapes - private-key
# material and provider credential tokens - never the mere WORDS "secret",
# "token" or "password" (which pepper this repo's docs and tests). That is
# what lets it scan the whole tree with zero false positives while still catching
# a real planted key. Public keys (ssh-rsa/ssh-ed25519)
# are NOT secrets and are never flagged.
#
# ALLOWLIST MARKER: a scanned line containing the literal `secret-scan:allow` is
# exempt - a deliberate, greppable, per-line waiver, and the same token
# `.gitleaks.toml` allowlists, so one marker answers both scanners. It is the
# LAST resort, not the first: this repository's own fixtures need a real secret
# SHAPE and get it by assembling the needle from fragments at run time
# (tests/secret_scan_test.sh), because a marker is honoured by these two
# scanners and by nothing on GitHub's side. tests/ is therefore fully scanned,
# and an UNmarked real key committed to a test file is still caught.
#
# Usage:
#   secret-scan [FILE...]        scan the given files
#   secret-scan --git [REPO]     scan REPO's tracked files       (default REPO: cwd)
# Exit: 0 clean; 1 secret-shaped content found (prints file:line:label); 2 usage.
#
# Runs on provisioned hosts/CI under a modern bash (not the 3.2 install surface),
# but kept dependency-free (grep + git only) for the supply-chain-minimal ethos.

set -euo pipefail

MARKER='secret-scan:allow'          # per-line waiver token (see header)

usage() {
  cat <<'EOF'
secret-scan - high-confidence secret-shaped content scanner.

Usage:
  secret-scan [FILE...]        scan the given files
  secret-scan --git [REPO]     scan REPO's tracked files       (default REPO: cwd)
Exit: 0 clean; 1 secret found (prints file:line:label); 2 usage.
EOF
}

# scan_one SCANPATH REPORTNAME - scan the bytes at SCANPATH, reporting hits as
# REPORTNAME:LINE:label (REPORTNAME names the tracked path in the report).
# Returns 0 clean, 1 if any secret was found.
scan_one() {
  local f="$1" name="$2" hits=0
  [ -f "$f" ] || return 0

  # 1. PEM / OpenSSH PRIVATE KEY blocks - highest-signal marker; a real key,
  #    never a placeholder (an example uses the literal word EXAMPLE, excluded).
  _sc_grep "$f" "$name" 'private-key-block' \
    '-----BEGIN( [A-Z0-9]+)* PRIVATE KEY-----' 'EXAMPLE' && hits=1
  # 2. AWS access key IDs (long-lived AKIA / temporary ASIA).
  _sc_grep "$f" "$name" 'aws-access-key-id' \
    '(^|[^[:alnum:]_])(AKIA|ASIA)[0-9A-Z]{16}([^[:alnum:]_]|$)' '' && hits=1
  # 3. GitHub tokens (ghp_/gho_/ghu_/ghs_/ghr_ + 36+ base62).
  _sc_grep "$f" "$name" 'github-token' \
    '(^|[^[:alnum:]_])gh[pousr]_[A-Za-z0-9]{36,}([^[:alnum:]_]|$)' '' && hits=1
  # 4. Slack tokens.
  _sc_grep "$f" "$name" 'slack-token' \
    '(^|[^[:alnum:]_])xox[baprs]-[0-9A-Za-z-]{10,}([^[:alnum:]_]|$)' '' && hits=1
  # 5. Google API keys.
  _sc_grep "$f" "$name" 'google-api-key' \
    '(^|[^[:alnum:]_])AIza[0-9A-Za-z_-]{35}([^[:alnum:]_]|$)' '' && hits=1
  # 6. A credential ASSIGNMENT with a real-looking value: a known secret key name,
  #    then = or :, then >=20 chars of base64/hex secret material. The EXCLUDE is
  #    anchored to the VALUE (everything after the `[:=]`), never the whole line -
  #    so a real secret cannot be waived by a placeholder WORD sitting in a trailing
  #    `# comment`. A value is excused only when it IS a placeholder (an in-value
  #    YOUR_…/EXAMPLE/CHANGE/PLACEHOLDER/xxxx token - the run before it is value
  #    chars, so a space-separated comment can never reach it), a $VAR, or a REAL
  #    path (leading ~/, ./, ../, an absolute /lowercase-word/ root, or a macOS
  #    /Users|Volumes|Applications|Library|System/ root). A base64 secret that
  #    merely begins with '/' and has a later '/' is NOT a path prefix and IS
  #    flagged. This keeps the rclone/restic *.example templates clean.
  _sc_grep "$f" "$name" 'credential-assignment' \
    '(aws_secret_access_key|secret_access_key|client_secret|api[_-]?key|password|passwd|access_token)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+=_.-]{20,}' \
    '[:=][[:space:]]*["'"'"']?([A-Za-z0-9/+=_.-]*(YOUR_|EXAMPLE|CHANGE|PLACEHOLDER|xxxx)|\$[A-Za-z{]|(~/|\./|\.\./|/[a-z][a-z]+/|/(Users|Volumes|Applications|Library|System)/)[^[:space:]"'"'"']*)' && hits=1

  return "$hits"
}

# _sc_grep FILE REPORTNAME LABEL PATTERN EXCLUDE - print matches of PATTERN in
# FILE as REPORTNAME:LINE:LABEL, dropping any line that matches the EXCLUDE ERE
# (empty = none) or carries the allowlist MARKER. `-I` skips true binaries.
# Commented lines are NOT auto-excluded - a real secret in a `# comment` leaks.
# Returns 0 if it printed at least one hit, 1 otherwise.
_sc_grep() {
  local f="$1" name="$2" label="$3" pat="$4" excl="$5" out
  out="$(grep -InE -- "$pat" "$f" 2>/dev/null || true)"
  [ -n "$out" ] || return 1
  if [ -n "$excl" ]; then
    out="$(printf '%s\n' "$out" | grep -vE -- "$excl" || true)"
  fi
  # Per-line allowlist waiver - a fixed-string drop so the marker needs no escaping.
  out="$(printf '%s\n' "$out" | grep -vF -- "$MARKER" || true)"
  [ -n "$out" ] || return 1
  # Reformat `LINE:content` -> `REPORTNAME:LINE:LABEL` - content withheld (never
  # echo the secret itself into logs). Leading field of `grep -n` is the line no.
  printf '%s\n' "$out" | while IFS= read -r line; do
    printf '%s:%s:%s\n' "$name" "${line%%:*}" "$label"
  done
  return 0
}

# --- Resolve mode + args ------------------------------------------------------
mode="files"
repo="."
paths=()          # scan_one SCANPATH<TAB>REPORTNAME records
case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  --git)    mode="git";    [ $# -ge 2 ] && repo="$2" ;;
  --) shift; for f in "$@"; do paths+=("$f"$'\t'"$f"); done ;;
  -*) echo "secret-scan: unknown option: $1" >&2; usage >&2; exit 2 ;;
  "") echo "secret-scan: no files or mode given" >&2; usage >&2; exit 2 ;;
  *)  for f in "$@"; do paths+=("$f"$'\t'"$f"); done ;;
esac

if [ "$mode" != "files" ]; then
  { [ -d "$repo/.git" ] || [ -f "$repo/.git" ]; } || { echo "secret-scan: not a git repo: $repo" >&2; exit 2; }
  while IFS= read -r -d '' rel; do
    case "$rel" in zsh/plugins/*) continue ;; esac
    [ -f "$repo/$rel" ] && paths+=("$repo/$rel"$'\t'"$rel")
  done < <(git -C "$repo" ls-files -z)
fi

# --- Scan ---------------------------------------------------------------------
rc=0
report=""
n=0
for entry in "${paths[@]:-}"; do
  [ -n "$entry" ] || continue
  n=$((n + 1))
  if out="$(scan_one "${entry%%$'\t'*}" "${entry#*$'\t'}")"; then :; else report="$report$out"$'\n'; rc=1; fi
done

if [ "$rc" -ne 0 ]; then
  echo "secret-scan: FAIL - secret-shaped content found:" >&2
  printf '%s' "$report" | grep -v '^$' | sed 's/^/  /' >&2
  exit 1
fi
echo "secret-scan: OK - no secret-shaped content in $n file(s)."
exit 0
