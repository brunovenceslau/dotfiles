#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Bruno Marques Venceslau de Souza <b@venceslau.dev>
#
# SPDX-License-Identifier: GPL-3.0-or-later

#
# repo-settings-check - diff the LIVE GitHub settings against
# .github/repo-settings.json and print one row per setting.
#
# The ONLINE half of the settings-vs-docs drift gate (the offline half is
# tests/repo_settings_test.sh, which holds the docs and ci.yml to the same file).
# It reads the live settings with `gh api` under the OPERATOR's own auth, so it
# is a maintainer-run `make repo-settings-check` and is deliberately NOT part of
# `make local-ci`: a pull request from a fork cannot run these calls without
# handing a token to untrusted code, and several endpoints need admin rights a
# CI token does not have.
#
# FAILS CLOSED. A setting is reported `ok` only when the live value was READ and
# equals the expected one. A failed call (no auth, 403, 404), a body that is not
# the JSON shape the endpoint documents, or a field the API omitted
# (bypass_actors and the merge settings are only returned to a caller with
# enough rights) is `UNREADABLE`, never `ok`.
#
# The named ruleset(s) alone do not prove what protects the default branch: a
# second ruleset (repository or organization) or a classic branch protection
# would add rules the file does not state. So the EFFECTIVE rules on the branch
# are read too, every one must come from the ruleset the file names for that
# branch, and classic protection must be absent.
#
# Endpoints (checked against GitHub's REST docs, 2026-09-25), all GET:
#   /repos/{o}/{r}
#     https://docs.github.com/en/rest/repos/repos#get-a-repository
#   /repos/{o}/{r}/private-vulnerability-reporting
#     https://docs.github.com/en/rest/repos/repos#check-if-private-vulnerability-reporting-is-enabled-for-a-repository
#   /repos/{o}/{r}/vulnerability-alerts
#     https://docs.github.com/en/rest/repos/repos#check-if-vulnerability-alerts-are-enabled-for-a-repository
#     Dependabot alerts, not private_vulnerability_reporting above: this
#     endpoint carries NO JSON body, ever. 204 means enabled, 404 means
#     disabled, so it cannot go through check_section's key/value comparison
#     and gets its own check_vulnerability_alerts.
#   /repos/{o}/{r}/actions/permissions            (enabled, allowed_actions,
#     sha_pinning_required)
#     https://docs.github.com/en/rest/actions/permissions#get-github-actions-permissions-for-a-repository
#   /repos/{o}/{r}/actions/permissions/selected-actions
#     https://docs.github.com/en/rest/actions/permissions#get-allowed-actions-and-reusable-workflows-for-a-repository
#     Only meaningful while allowed_actions == "selected"; read unconditionally
#     regardless, since the settings file states what is expected either way.
#   /repos/{o}/{r}/actions/permissions/workflow    (default_workflow_permissions,
#     can_approve_pull_request_reviews)
#     https://docs.github.com/en/rest/actions/permissions#get-default-workflow-permissions-for-a-repository
#   /repos/{o}/{r}/actions/permissions/fork-pr-contributor-approval
#     https://docs.github.com/en/rest/actions/permissions#get-fork-pr-contributor-approval-permissions-for-a-repository
#     approval_policy enum: first_time_contributors_new_to_github |
#     first_time_contributors | all_external_contributors
#   /repos/{o}/{r}/rulesets and /repos/{o}/{r}/rulesets/{id}
#     https://docs.github.com/en/rest/repos/rules#get-all-repository-rulesets
#     https://docs.github.com/en/rest/repos/rules#get-a-repository-ruleset
#     enforcement enum: disabled | active | evaluate; rules[].type values used
#     here: required_signatures, required_status_checks, pull_request,
#     non_fast_forward, deletion; required_status_checks parameters:
#     required_status_checks[] ({context, integration_id?}),
#     strict_required_status_checks_policy, do_not_enforce_on_create;
#     pull_request parameters used here: required_approving_review_count,
#     dismiss_stale_reviews_on_push, require_code_owner_review,
#     require_last_push_approval, required_review_thread_resolution,
#     require_extra_approval_for_unattributed_changes, allowed_merge_methods
#     (required_reviewers is returned too but not pinned - not part of the
#     policy the operator asked this gate to hold)
#   /repos/{o}/{r}/rules/branches/{branch}   (effective rules, every source;
#     each entry names its ruleset_id; paginated like the rulesets list)
#     https://docs.github.com/en/rest/repos/rules#get-rules-for-a-branch
#   /repos/{o}/{r}/branches/{branch}/protection   (classic protection; an
#     unprotected branch answers 404 "Branch not protected")
#     https://docs.github.com/en/rest/branches/branch-protection#get-branch-protection
#
# The settings file's .rulesets is an ARRAY: this repo runs more than one
# ruleset (a branch ruleset on main, a tag ruleset on release tags), matched
# by NAME rather than id so a ruleset can be recreated without a file edit.
# Each entry only lists the fields that apply to its own rules - a tag
# ruleset has no required_status_checks or pull_request policy - and
# check_one_ruleset checks exactly the keys present in that entry, the same
# "the file's keys are the checklist" idiom check_section uses.
#
# Usage: repo-settings-check [SETTINGS_FILE]   (default: the repo's own file)
# Exit: 0 every row ok; 1 at least one DRIFT; 2 nothing drifted but a setting
#       could not be read, or gh/jq/the settings file is unusable. No other
#       code: every jq that reads a response is guarded (see `project`).
#
# bin/ is not the 3.2 surface, but a maintainer's Mac may resolve `env bash` to
# /bin/bash 3.2, so this file stays 3.2-safe anyway (no associative arrays -
# the per-ruleset id, keyed by NAME, is stashed in a $tmp file instead).

# File-wide: every single-quoted $name here is a jq variable (--arg), never a
# shell expansion.
# shellcheck disable=SC2016

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
settings="${1:-$root/.github/repo-settings.json}"

die() { echo "repo-settings-check: ERROR: $*" >&2; exit 2; }

command -v jq >/dev/null 2>&1 || die "jq not installed (brew install jq)"
command -v gh >/dev/null 2>&1 || die "gh not installed (brew install gh), and it must be authenticated as a repository admin"
[ -r "$settings" ] || die "settings file not readable: $settings"
jq -e 'type == "object"' "$settings" >/dev/null 2>&1 || die "settings file is not a JSON object: $settings"

repo="$(jq -r '.repository // empty' "$settings")"
[ -n "$repo" ] || die "settings file has no .repository"
branch="$(jq -r '.repo.default_branch // empty' "$settings")"
[ -n "$branch" ] || die "settings file has no .repo.default_branch"

# The one ruleset entry that governs the default branch - check_branch
# attributes the branch's effective rules to it. A file with zero or more than
# one .target == "branch" entry cannot say what "the branch ruleset" means, so
# this is a startup error like the two above, not a live-data UNREADABLE.
branch_ruleset_name="$(jq -r '[.rulesets // [] | .[] | select(.target == "branch")]
  | if length == 1 then .[0].name else empty end' "$settings")"
[ -n "$branch_ruleset_name" ] || die "settings file must have exactly one .rulesets[] entry with target \"branch\""

# RS_FIELDS - every per-ruleset field rs_proj (below) knows how to project out
# of a live ruleset object. A settings-file key outside this set would fall
# through rs_proj's `case` with nothing to compare against, silently reading
# as an empty live projection - so it is refused HERE, at startup, as a
# configuration error, not left to surface as a live-data row.
RS_FIELDS="target enforcement include exclude bypass_actors rules required_status_checks status_check_policy pull_request"
unknown_ruleset_fields="$(jq -r --arg known "$RS_FIELDS" '
  ($known | split(" ")) as $known
  | .rulesets[]? | .name as $n | (keys_unsorted - ["name"] - $known)[] | "\($n).\(.)"
' "$settings")"
[ -z "$unknown_ruleset_fields" ] \
  || die "settings file has ruleset field(s) rs_proj does not handle: $(tr '\n' ' ' <<<"$unknown_ruleset_fields")"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

n_ok=0 n_drift=0 n_unread=0
rows=()
BADSHAPE="unexpected response (not the documented JSON shape)"

# row SETTING EXPECTED_JSON STATUS LIVE_TEXT
row() {
  rows+=("$3"$'\t'"$1"$'\t'"$2"$'\t'"$4")
  case "$3" in
    ok) n_ok=$((n_ok + 1)) ;;
    DRIFT) n_drift=$((n_drift + 1)) ;;
    *) n_unread=$((n_unread + 1)) ;;
  esac
}

# compare SETTING EXPECTED_JSON LIVE_JSON - both compact JSON; an empty LIVE
# means the field was absent from a successful response.
compare() {
  if [ -z "$3" ]; then
    row "$1" "$2" UNREADABLE "field not returned (needs admin rights?)"
  elif [ "$2" = "$3" ]; then
    row "$1" "$2" ok "$3"
  else
    row "$1" "$2" DRIFT "$3"
  fi
}

# expect FILTER - the expected value from the settings file, compact and sorted.
expect() { jq -cS "$1" "$settings"; }

# project FILE FILTER [jq args...] - apply FILTER to a RESPONSE, into $live.
# Returns 1 when the body is not JSON or the filter errors on its shape, so
# the caller reports UNREADABLE instead of jq aborting the run with rc 5.
live=""
project() {
  local f="$1" filter="$2"
  shift 2
  live="$(jq -cS "$@" "$filter" "$f" 2>/dev/null)" || { live=""; return 1; }
}

# fetch PATH OUTFILE - GET through gh. On failure the first stderr line is left
# in OUTFILE.err for the UNREADABLE rows. `gh api` exits non-zero on any
# HTTP >= 400, so a 403/404 body is never mistaken for settings.
fetch() {
  if gh api "$1" >"$2" 2>"$2.err"; then
    return 0
  fi
  local msg
  msg="$(sed -n 1p "$2.err")"
  printf '%s\n' "${msg:-gh api $1 failed}" >"$2.err"
  return 1
}

# fetch_list PATH OUTFILE - GET a LIST endpoint across EVERY page. Both list
# endpoints read here paginate (30 per page by default); reading only page 1
# would silently miss a foreign ruleset or rule on a later page and report ok.
# `gh api --paginate` follows the Link rel="next" chain and prints one JSON
# array per page, which `jq -s add` joins. A page that is not an array (an
# error body, a proxy page) makes the whole list UNREADABLE via OUTFILE.err.
fetch_list() {
  fetch_paginated "$1" "$2.pages" || { mv "$2.pages.err" "$2.err"; return 1; }
  if ! jq -cs 'if length > 0 and all(type == "array") then add else error("shape") end' \
      "$2.pages" >"$2" 2>/dev/null; then
    printf '%s\n' "$BADSHAPE" >"$2.err"
    return 1
  fi
}
fetch_paginated() {
  if gh api --paginate "$1" >"$2" 2>"$2.err"; then
    return 0
  fi
  local msg
  msg="$(sed -n 1p "$2.err")"
  printf '%s\n' "${msg:-gh api $1 failed}" >"$2.err"
  return 1
}

# check_section SECTION API_PATH - every key under .SECTION in the settings file
# is compared with the same key in the endpoint's response, so a new expected
# setting is a one-line JSON change, not a code change.
check_section() {
  local section="$1" path="$2" out="$tmp/$1.json" key exp err="" keys
  keys="$(jq -r --arg s "$section" '.[$s] // {} | keys_unsorted[]' "$settings")"
  [ -n "$keys" ] || return 0
  fetch "$path" "$out" || err="$(cat "$out.err")"
  while IFS= read -r key; do
    exp="$(jq -cS --arg s "$section" --arg k "$key" '.[$s][$k]' "$settings")"
    if [ -n "$err" ]; then
      row "$section.$key" "$exp" UNREADABLE "$err"
    elif ! project "$out" 'if type != "object" then error("shape") elif has($k) and .[$k] != null then .[$k] else empty end' --arg k "$key"; then
      row "$section.$key" "$exp" UNREADABLE "$BADSHAPE"
    else
      compare "$section.$key" "$exp" "$live"
    fi
  done <<<"$keys"
}

check_section repo "repos/$repo"
check_section private_vulnerability_reporting "repos/$repo/private-vulnerability-reporting"
check_section actions_permissions "repos/$repo/actions/permissions"
check_section actions_selected_actions "repos/$repo/actions/permissions/selected-actions"
check_section actions_workflow "repos/$repo/actions/permissions/workflow"
check_section fork_pr_contributor_approval "repos/$repo/actions/permissions/fork-pr-contributor-approval"

# check_vulnerability_alerts - Dependabot alerts. The endpoint has no JSON
# body: success (204) means enabled, and GitHub's documented disabled
# response is a 404, so absence of the field it would otherwise report is
# read from the HTTP outcome instead of from a JSON key.
check_vulnerability_alerts() {
  local exp out="$tmp/vulnerability_alerts.json" err
  exp="$(jq -cS '.vulnerability_alerts.enabled // empty' "$settings")"
  [ -n "$exp" ] || return 0
  if fetch "repos/$repo/vulnerability-alerts" "$out"; then
    compare "vulnerability_alerts.enabled" "$exp" "true"
  else
    err="$(cat "$out.err")"
    case "$err" in
      *"(HTTP 404)"*) compare "vulnerability_alerts.enabled" "$exp" "false" ;;
      *) row "vulnerability_alerts.enabled" "$exp" UNREADABLE "$err" ;;
    esac
  fi
}
check_vulnerability_alerts

# rs_proj FIELD - the jq filter that projects FIELD out of a full ruleset
# object (the /rulesets/{id} response). Arrays are compared as sorted sets,
# since neither rule order nor check order carries meaning.
rs_proj() {
  case "$1" in
    target) echo '.target' ;;
    enforcement) echo '.enforcement' ;;
    include) echo '.conditions.ref_name.include // empty | sort' ;;
    exclude) echo '.conditions.ref_name.exclude // empty | sort' ;;
    # Absent bypass_actors stays absent (empty), so it reads as UNREADABLE.
    bypass_actors) echo '.bypass_actors // empty | sort_by(.actor_type, .actor_id)' ;;
    rules) echo '[.rules[].type] | unique' ;;
    # Whole check objects, so an integration_id appearing on a check is drift
    # even though the file pins none.
    required_status_checks)
      echo '[.rules[] | select(.type == "required_status_checks")]
        | if length == 1 then .[0].parameters.required_status_checks | sort_by(.context) else error("rsc") end' ;;
    status_check_policy)
      echo '[.rules[] | select(.type == "required_status_checks")]
        | if length == 1 then .[0].parameters | {strict_required_status_checks_policy, do_not_enforce_on_create} else error("rsc") end' ;;
    # An explicit field list, like status_check_policy above: required_reviewers
    # is part of the live response but is not a policy this gate pins, so it is
    # dropped rather than compared.
    pull_request)
      echo '[.rules[] | select(.type == "pull_request")]
        | if length == 1 then .[0].parameters
          | {required_approving_review_count, dismiss_stale_reviews_on_push, require_code_owner_review,
             require_last_push_approval, required_review_thread_resolution,
             require_extra_approval_for_unattributed_changes, allowed_merge_methods}
          else error("pr") end' ;;
    # Unreachable in normal operation: the startup check above (RS_FIELDS)
    # already refuses any settings-file field this `case` does not list. Kept
    # so a caller of rs_proj can never silently get an empty filter (which
    # would make `project` compare against `.` - the WHOLE ruleset object -
    # instead of failing loudly) if that invariant is ever broken.
    *) echo 'error("rs_proj: unknown ruleset field")' ;;
  esac
}
# rs_exp IDX FIELD - the expected value of .rulesets[IDX].FIELD, compact and
# sorted; arrays are pre-sorted to match rs_proj's live-side sort.
rs_exp() { jq -cS ".rulesets[$1].$2 | if type == \"array\" then sort else . end" "$settings"; }

# check_one_ruleset IDX LIST_OK LIST_ERR - LIST_OK empty means the rulesets
# list itself could not be read (LIST_ERR holds the message): every field this
# entry states is then UNREADABLE, with no per-entry fetch attempted. The
# three branches below (list-unreadable, not-uniquely-found, detail-fetch-
# failed) each report a different subset of rows on purpose - see the
# "ruleset[NAME].name" and per-field rows they emit.
#
# Every row's SETTING label is "ruleset[$name].FIELD", never bare
# "ruleset.FIELD": two or more ruleset entries (main-protection, release-tags)
# would otherwise print identically-labelled rows for the same field name
# (both have a .rules, both have a .target, ...), and a reader - or a test
# asserting on a label - could not tell which entry a DRIFT row belongs to.
check_one_ruleset() {
  local idx="$1" list_ok="$2" list_err="$3" name label fields f id n err

  name="$(jq -r ".rulesets[$idx].name" "$settings")"
  label="ruleset[$name]"
  fields="$(jq -r ".rulesets[$idx] | keys_unsorted[] | select(. != \"name\")" "$settings")"

  if [ -z "$list_ok" ]; then
    for f in $fields; do row "$label.$f" "$(rs_exp "$idx" "$f")" UNREADABLE "$list_err"; done
    return 0
  fi

  if ! project "$tmp/rulesets.json" '[.[] | select(.name == $n) | .id]' --arg n "$name"; then
    row "$label.name" "\"$name\"" UNREADABLE "$BADSHAPE"
    return 0
  fi
  n="$(jq 'length' <<<"$live")"
  if [ "$n" != 1 ]; then
    # Zero is drift (the ruleset is gone or renamed); more than one is
    # ambiguous, and a guess could vouch for the wrong ruleset. Either way
    # the per-field rows below cannot be attributed to a single live ruleset,
    # so they are left unreported rather than guessed at.
    if [ "$n" = 0 ]; then
      row "$label.name" "\"$name\"" DRIFT "no ruleset named '$name'"
    else
      row "$label.name" "\"$name\"" UNREADABLE "$n rulesets named '$name'"
    fi
    return 0
  fi
  id="$(jq -r '.[0]' <<<"$live")"
  if ! fetch "repos/$repo/rulesets/$id" "$tmp/ruleset_$idx.json"; then
    err="$(cat "$tmp/ruleset_$idx.json.err")"
    for f in $fields; do row "$label.$f" "$(rs_exp "$idx" "$f")" UNREADABLE "$err"; done
    return 0
  fi
  # Stashed by NAME (no associative arrays under bash 3.2) so check_branch can
  # attribute the branch's effective rules to this ruleset's id.
  echo "$id" >"$tmp/ruleset_id.$name"
  row "$label.name" "\"$name\"" ok "\"$name\" (id $id)"
  for f in $fields; do
    if project "$tmp/ruleset_$idx.json" "$(rs_proj "$f")"; then
      compare "$label.$f" "$(rs_exp "$idx" "$f")" "$live"
    else
      row "$label.$f" "$(rs_exp "$idx" "$f")" UNREADABLE "$BADSHAPE"
    fi
  done
}

check_rulesets() {
  local count i err
  count="$(jq '.rulesets // [] | length' "$settings")"
  [ "$count" -gt 0 ] || return 0

  if fetch_list "repos/$repo/rulesets?per_page=100" "$tmp/rulesets.json"; then
    for i in $(seq 0 $((count - 1))); do check_one_ruleset "$i" yes ""; done
  else
    err="$(cat "$tmp/rulesets.json.err")"
    for i in $(seq 0 $((count - 1))); do check_one_ruleset "$i" "" "$err"; done
  fi
}
check_rulesets

# check_branch - what ACTUALLY applies to the default branch, attributed to
# $branch_ruleset_name (the settings file's one branch-targeting ruleset).
# The "ruleset[NAME]" value text below matches check_one_ruleset's row-label
# convention, so the same ruleset is named the same way everywhere this tool
# prints it.
check_branch() {
  local out="$tmp/branch_rules.json" exp_src exp_types err rid
  exp_types="$(jq -cS --arg n "$branch_ruleset_name" '(.rulesets[] | select(.name == $n) | .rules) | sort' "$settings")"
  exp_src="[\"ruleset[$branch_ruleset_name]\"]"
  rid="$(cat "$tmp/ruleset_id.$branch_ruleset_name" 2>/dev/null || true)"

  if ! fetch_list "repos/$repo/rules/branches/$branch?per_page=100" "$out"; then
    err="$(cat "$out.err")"
    row "branch.$branch.rule_sources" "$exp_src" UNREADABLE "$err"
    row "branch.$branch.rule_types" "$exp_types" UNREADABLE "$err"
  elif [ -z "$rid" ]; then
    # Without the expected ruleset's id there is nothing to attribute to.
    row "branch.$branch.rule_sources" "$exp_src" UNREADABLE "expected ruleset not read (see ruleset rows)"
    if project "$out" '[.[].type] | unique'; then
      compare "branch.$branch.rule_types" "$exp_types" "$live"
    else
      row "branch.$branch.rule_types" "$exp_types" UNREADABLE "$BADSHAPE"
    fi
  else
    # Every effective rule must come from the expected ruleset: any other
    # ruleset_id is a second ruleset (repo or org) acting on the branch.
    if project "$out" '[.[] | .ruleset_id | if . == $id then "ruleset[\($name)]" else "ruleset id \(.)" end] | unique' \
        --argjson id "$rid" --arg name "$branch_ruleset_name"; then
      compare "branch.$branch.rule_sources" "$exp_src" "${live:-[]}"
    else
      row "branch.$branch.rule_sources" "$exp_src" UNREADABLE "$BADSHAPE"
    fi
    if project "$out" '[.[].type] | unique'; then
      compare "branch.$branch.rule_types" "$exp_types" "$live"
    else
      row "branch.$branch.rule_types" "$exp_types" UNREADABLE "$BADSHAPE"
    fi
  fi

  # Classic protection must be ABSENT, and only the documented 404 message
  # proves absence: a bare 404 is also what a caller without rights gets.
  out="$tmp/protection.json"
  if fetch "repos/$repo/branches/$branch/protection" "$out"; then
    row "branch.$branch.classic_protection" '"none"' DRIFT "classic branch protection is configured"
  else
    err="$(cat "$out.err")"
    case "$err" in
      *"Branch not protected"*"404"*) row "branch.$branch.classic_protection" '"none"' ok '"none"' ;;
      *) row "branch.$branch.classic_protection" '"none"' UNREADABLE "$err" ;;
    esac
  fi
}
check_branch

echo "repo-settings-check: $repo vs ${settings#"$root"/}"
{
  printf 'STATUS\tSETTING\tEXPECTED\tLIVE\n'
  # Length guard: bash 3.2 treats an empty "${rows[@]}" as unbound under set -u.
  [ "${#rows[@]}" -eq 0 ] || printf '%s\n' "${rows[@]}"
} | column -t -s $'\t'
echo "repo-settings-check: $n_ok ok, $n_drift drift, $n_unread unreadable"

if [ "$n_drift" -gt 0 ]; then
  echo "repo-settings-check: FAIL - the live settings drifted from the file; fix the setting, or change the file and the docs together" >&2
  exit 1
fi
if [ "$n_unread" -gt 0 ]; then
  echo "repo-settings-check: FAIL - $n_unread setting(s) could not be read, so nothing is vouched for them; authenticate gh as a repository admin (gh auth login) and re-run" >&2
  exit 2
fi
echo "repo-settings-check: PASS"
