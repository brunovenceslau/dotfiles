#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Bruno Marques Venceslau de Souza <b@venceslau.dev>
#
# SPDX-License-Identifier: GPL-3.0-or-later

#
# check-patterns - static-pattern lint gate over the dotfiles' own surface.
#
# The static-pattern component that `make check-patterns` runs and
#   `make lint` includes. Twelve checks across our OWN runtime surface
#   (the SHA-pinned zsh plugin submodules are third-party and excluded by their
#   one exact path, zsh/plugins - we police our code, not upstream's):
#     (1) `curl|sh` / `wget|bash` runtime fetches - the static CI half of the
#         no-runtime-download rule (the startup-path half is the
#         fast-syntax-highlighting neutralization in zsh/zshrc).
#     (2) ad-hoc `uname -m` outside lib/os.sh - arch branching MUST go through
#         the is-arm64 / is-amd64 helpers.
#     (3) an unescaped `#` inside a Makefile `$(shell ...)` / `${shell ...}` - macOS's
#         system make (3.81) reads a bare `#` in a function argument as a comment and
#         aborts ("unterminated call to function shell"), which GNU make 4.x on Linux
#         silently tolerates; it MUST be escaped `\#`. A targeted, heuristic
#         check on the Makefile (excluded from the scan surface - its recipes legitimately
#         hold the very literals rules 1-2 forbid); a `#` after a nested `$(...)` or on a
#         `\`-continued line is not caught (the macOS CI leg's real make 3.81 backstops it).
#     (4) a drifted pinned-plugin shim premise in the SHA-pinned zsh plugins - the one pinned
#         `$(uname -a)` shape the startup fork-free path relies on; a bump that
#         reshapes it must re-verify the shim. It is the only startup fork a shim
#         covers - see the note above the check itself.
#     (5) a LONE `/opt/homebrew` - the Homebrew prefix MUST be resolved by directory
#         existence, so naming the Apple Silicon prefix without the Intel one on the
#         same line is the shape of a hardcode that breaks the Intel mac silently.
#     (6) a `brew shellenv` / `brew --prefix` fork - the other half of the same rule.
#     (7) bash 4 syntax in the bash-3.2 surface (install.sh + lib/*.sh) - the class
#         `make lint`'s `/bin/bash -n` pass cannot see in ANY bash, because
#         `declare -A` and `mapfile` are ordinary command invocations and `${var,,}`
#         fails at expansion, not at parse. This is their only gate.
#     (8) GNU-only regex escapes (`\s`, `\w`, `\b`, BRE `\|`) in the shell surface,
#         tests/ and the workflows included - BSD sed/grep on macOS silently read
#         them as something else, and no Linux run can see it. Inside tests/ ONLY,
#         `*.py` files are exempt by extension - the only content-independent
#         language exemption this arm has, never a marker or a parse of the file
#         (the arm's other two exclusions are the pinned plugins dir and this
#         script by name, both unrelated to language). Python's own `re` module
#         has a different regex dialect, where those escapes are portable, so
#         non-shell code lives in its own `.py` file under tests/ rather than a
#         heredoc inside a `.sh` script. bin/, lib/, zsh/, install.sh, the
#         Makefile and the workflows keep no such exemption: lib/link.sh's
#         _link_bin_tree links every bin/* file onto the live PATH by basename,
#         so a `.py` file there could still run as shell-adjacent code.
#     (9) an early-exit reader (`grep -q`/`-m`/`-l`, `head`) on the right of a
#         pipe in the pipefail surface - the writer can die of SIGPIPE when the
#         reader exits first, failing the pipeline at random.
#    (10) a `--` after the first operand of a file or text tool (`chmod -R go-w --`)
#         - BSD getopt on macOS stops at the first operand and reads the `--` as a
#         file, which GNU's argv permutation hides from every Linux run.
#    (11) the Unicode em dash (U+2014) anywhere in the repo's own prose - the
#         house style (CONTRIBUTING.md and .claude/rules/docs.md) is a plain
#         hyphen. Unlike arms 5-10 it does NOT strip comments first: a comment
#         is prose too, the same reasoning arms 1-2 use for curl|sh and
#         uname -m. Vendored legal text and one auto-generated lockfile are
#         allowlisted; see the arm itself.
#    (12) a symlink anywhere the arms above read, plus (when ROOT has its
#         own .git) any tracked symlink, or gitlink that is not a pinned
#         plugin, anywhere in the repo - a recursive scan never follows a
#         symlink it meets while walking a directory, so one there hides its
#         target from every arm that walks past it. It also refuses anything
#         under zsh/plugins/ that is not a pinned plugin, since no arm reads
#         there. See the arm itself for the passes and why each runs.
#
# FAILS CLOSED. The earlier inline Makefile recipe passed `$(PATTERN_SCAN)`
#   verbatim to grep, including the optional (and usually absent) `home/`. A
#   missing path makes grep exit 2, and bash's `if grep ...; then fail` reads a
#   non-zero exit as "no match" - so BOTH checks were silently disabled whenever
#   any scan path was absent (fail-OPEN: a real curl|sh would pass). This tool
#   fixes both halves: it scans only paths that EXIST (an absent optional dir is
#   skipped, not an error), and it treats a real grep error (exit >= 2) as a hard
#   failure, never a silent pass. Regression coverage: tests/check_patterns_test.sh.
#
# Bash 3.2 compatible (indexed arrays only; no assoc arrays, no
#   mapfile) so the macOS CI legs behave identically.
#
# Usage: check-patterns [ROOT]   (ROOT default: current directory)
#   ROOT MUST be a checkout you trust: arm (12) runs git inside it, and
#   although the one config key known to run a program on a read-only call
#   (core.fsmonitor) is forced off there, the repo's own .git/config is read.
#   Exit: 0 clean; 1 a forbidden pattern was found; 2 nothing to scan or a scan
#         error (fail closed).

set -euo pipefail
# An inherited BASHOPTS (bash 4.1+ imports it) can switch these on: failglob
# aborts on the first unmatched glob below with rc 1, which reads as "a
# violation"; dotglob makes `*` repeat the dot entries _scan_roots globs on
# its own, reporting each hit twice; nullglob and nocaseglob change what a
# glob returns; nocasematch makes every `case` below match any case. All five
# exist in bash 3.2 (failglob and nocasematch since 3.0 and 3.1).
shopt -u failglob dotglob nocaseglob nullglob nocasematch

root="${1:-.}"

# _scan_roots P... -> the global `roots`: "$root/P" for each P that exists,
# except that a real, listable directory "$root/zsh" is replaced by its own
# entries minus the pinned "$root/zsh/plugins". EVERY recursive arm takes its
# roots from here, and this is the ONE place the pinned plugins leave their
# scan. It cannot be a grep flag: GNU and BSD grep both match --exclude-dir
# against a BASE NAME at any depth, never a path, so `--exclude-dir=plugins`
# also hid first-party trees such as config/nvim/lua/plugins/ and
# lib/plugins/ (a curl|sh there passed).
#   - A symlinked (or non-directory) zsh stays a root as is: expanding
#     through a symlinked zsh would hand arm (12)'s find paths below the
#     link without the link itself.
#   - A zsh that is not both readable and searchable stays a root as is too:
#     its glob would come back empty and the scan would pass, where grep and
#     find on the directory itself error and fail closed.
#   - A SYMLINK entry of zsh (zsh/plugins included) goes to the global
#     `zsh_links`, never to `roots`: as a grep OPERAND, GNU grep -r follows
#     it (into the pinned plugins, or out of the surface) and a dangling one
#     errors, while BSD grep does not. Arm (12)'s find reads `zsh_links` and
#     reports each one, as it does any symlink met while walking.
#   - A zsh/plugins that is not a directory (a plain file) is scanned.
# -e alone misses a DANGLING symlink (it stats the target, not the link
# itself), silently dropping the entry from every arm below; -L catches it.
# `$root` is quoted in the globs, so its own glob characters stay literal.
_scan_roots() {
  roots=()
  zsh_links=()
  local p e
  for p in "$@"; do
    if [ "$p" = zsh ] && [ -d "$root/zsh" ] && [ ! -L "$root/zsh" ] \
        && [ -r "$root/zsh" ] && [ -x "$root/zsh" ]; then
      # `.[!.]*` and `..?*` add the dot entries `*` skips, never `.` or `..`.
      for e in "$root"/zsh/* "$root"/zsh/.[!.]* "$root"/zsh/..?*; do
        if [ -L "$e" ]; then
          zsh_links+=("$e")
          continue
        fi
        [ -e "$e" ] || continue  # an unmatched glob stays literal
        [ "$e" = "$root/zsh/plugins" ] && [ -d "$e" ] && continue
        roots+=("$e")
      done
    elif [ -e "$root/$p" ] || [ -L "$root/$p" ]; then
      roots+=("$root/$p")
    fi
  done
}

# Our own implementing surface. NEVER the Makefile itself (its recipes contain
# the very patterns they forbid), and the self-exclude on each grep below
# likewise skips THIS script, which necessarily spells out the forbidden literals
# in its grep patterns and docs. `home/` is optional - absent = skipped, not an
# error (that omission is the whole bug this tool fixes). A tree whose only
# content is the pinned zsh/plugins, or symlinks under zsh/, is a no-op scan
# too - and a recursive grep given NO operand would read the cwd or stdin.
_scan_roots install.sh lib bin zsh config packages security home
scan=(${roots[@]+"${roots[@]}"})
scan_links=(${zsh_links[@]+"${zsh_links[@]}"})
if [ "${#scan[@]}" -eq 0 ]; then
  echo "check-patterns: no scan paths exist under '$root' - refusing to pass a no-op scan" >&2
  exit 2
fi

bad=0

# --- code/comment split, used by arms (5)-(10) --------------------------------
# The comments that STATE these constraints necessarily spell the forbidden
# literals - install.sh's own "no associative arrays, no mapfile, no ${var,,}"
# header, and every `# never hardcode /opt/homebrew` a reader deserves beside the
# line it explains. CLAUDE.md REQUIRES those comments, so a gate that flagged
# them would forbid the repo from documenting its own rules. These arms therefore
# test CODE, not the raw line. Arms (1) and (2) deliberately do NOT: a `curl|sh`
# or a `uname -m` spelled anywhere is still a pattern we want out of the tree.
#
# _code_of splits one `PATH:NN:CONTENT` hit and returns CONTENT with its comment
# tail removed. A comment starts at a `#` that opens the line OR follows one of the
# characters that end a word for the shell - whitespace and the metacharacters
# `; & | ( )` - so `x=1;# note` is a comment too, and an earlier version that only
# knew about whitespace both missed a dodge and flagged a legitimate comment.
# `[^:]*` never crosses a colon, so the prefix strip lands on PATH:NN: exactly.
# PREMISES: no `:` in the scan root's path; and a `#` INSIDE a quoted string
# truncates the line early, which can cut a real violation (false negative) or cut
# the `/usr/local` half of arm 5's exempting pair (false positive). Both need a `#`
# inside a string on a line that also carries one of these patterns.
_code_of() {  # $1 = one "PATH:NN:CONTENT" hit -> its CODE on stdout
  printf '%s' "$1" | sed -E -e 's/^[^:]*:[0-9]+://' -e 's/(^|[[:space:];&|()])#.*$/\1/'
}

# _code_hits MATCH_ERE [EXEMPT_ERE] - read hits on stdin, re-test each hit's CODE,
# and print back the hits that still match MATCH_ERE and do not match EXEMPT_ERE.
# Both EREs see the CODE ALONE, never the PATH:NN: prefix: testing the whole line
# would let a scan ROOT whose own path contains the exempt text disable the arm
# for the entire tree, which is the fail-OPEN shape this tool exists to refuse.
# FAILS CLOSED on a broken ERE: a grep exit >= 2 is not "no match". An unusable
# pattern reports every hit instead of silently disabling the arm, and an unusable
# EXEMPT pattern exempts nothing, because the caller's `|| true` would otherwise
# swallow any status this function returned.
_code_hits() {
  local match="$1" exempt="${2:-}" hit code rc
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    code="$(_code_of "$hit")"
    [ -n "$code" ] || continue
    rc=0; grep -qE -- "$match" <<<"$code" || rc=$?
    if [ "$rc" -ge 2 ]; then
      echo "check-patterns: code re-test errored (exit $rc) on '$match' - failing closed" >&2
      printf '%s\n' "$hit"; continue
    fi
    [ "$rc" -eq 0 ] || continue
    if [ -n "$exempt" ]; then
      rc=0; grep -qE -- "$exempt" <<<"$code" || rc=$?
      if [ "$rc" -ge 2 ]; then
        echo "check-patterns: exemption re-test errored (exit $rc) on '$exempt' - exempting nothing" >&2
      elif [ "$rc" -eq 0 ]; then
        continue
      fi
    fi
    printf '%s\n' "$hit"
  done
  return 0
}

# (1) forbid curl|sh / wget|bash runtime fetches that EXECUTE the downloaded
# text on the same line. W below is curl or wget, optionally written with a path
# (`/usr/bin/curl`) or behind `command `, `env `, `sudo [options] ` or `\`.
# SHELL is sh, bash, zsh, ksh or dash, optionally quoted, with a path
# (`/bin/bash`), and behind any of `sudo [options] `, `env `, `command `,
# `exec `. Covered shapes:
#   * a pipe into a shell:  W ... | SHELL,  W ... |& bash,  W ... | sudo -E bash
#   * command substitution given to eval (also `eval --`), or to a SHELL whose
#     options include a c flag, as a cluster (-c, -lc, -ec) or apart from other
#     options (-l -c, --norc -c, -c --), with spaces allowed inside the quote:
#     eval "$(W ...)", bash -lc "$(W ...)", sh -c "  $(W ...)", sh -c `W ...`
#   * process substitution sourced, dotted or run, directly or redirected:
#     source <(W ...), . <(W ...), bash <(sudo W ...), bash < <(W ...)
# NOT covered, among others (a line-oriented grep cannot follow them all, so
# this list is illustrative, not exhaustive): a download saved to a file or
# variable and executed on a LATER line; one passed through another command
# first (`W ... | tee f | bash`); one fed through a here-string or /dev/stdin
# (`source /dev/stdin <<< "$(W ...)"`); W behind an assignment, `time` or a
# brace group inside the substitution (`eval "$(VAR=x W ...)"`,
# `bash -c "$(time W ...)"`, `bash -c "$({ W ...; })"`); a substitution that
# is not the start of the -c string (`sh -c "set -e; $(W ...)"`); a fetch
# through an alias or function; a shell reached through xargs or nohup; and
# fetch tools other than curl and wget.
# Capturing output into a variable (x="$(curl ...)") is not execution and is
# not flagged. The leading class keeps `eval`/`source`/`.` from matching inside
# a longer word (`medieval`, `file.sh`), and the trailing class keeps `sh` from
# matching `shasum`.
# rc 0 = match (violation); rc 1 = clean; rc >= 2 = scan error (fail closed).
# `-r`, NOT `-R`: -R follows symlinks, and a first-party link pointing into a
# third-party tree would drag the scan straight back into the pinned zsh/plugins
# that _scan_roots left out of `scan`. No `--exclude-dir`: it matches a base name
# at any depth, which would hide a FIRST-PARTY `plugins` directory as well.
sudo_='sudo([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]][^[:space:]]*)?)*'
fetcher="((command|env|$sudo_)[[:space:]]+|\\\\)?([^[:space:]\"'\`()\$]*/)?(curl|wget)"
runner="(($sudo_|env|command|exec)[[:space:]]+)*[\"']?([^[:space:]|;&\"']*/)?(sh|bash|zsh|ksh|dash)[\"']?"
opt='[[:space:]]+-[^[:space:]"'"'"'`$]*'
fetch_pipe="(curl|wget)[^|]*\\|&?[[:space:]]*$runner([^[:alnum:]_.-]|\$)"
fetch_subst="(^|[^[:alnum:]_.-])(eval([[:space:]]+--)?|$runner($opt)*[[:space:]]+-[[:alnum:]]*c[[:alnum:]]*($opt)*)[[:space:]]+[\"']?[[:space:]]*(\\\$\\(|\`)[[:space:]]*$fetcher"
fetch_procsub="(^|[^[:alnum:]_.-])(source|\\.|$runner)[[:space:]]+(<[[:space:]]*)?<\\([[:space:]]*$fetcher"
if out=$(grep -rInE --exclude=check-patterns \
    -e "$fetch_pipe" -e "$fetch_subst" -e "$fetch_procsub" "${scan[@]}" 2>&1); then
  printf '%s\n' "$out"
  echo "check-patterns: forbidden curl|sh runtime fetch" >&2
  bad=1
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    printf '%s\n' "$out" >&2
    echo "check-patterns: curl|sh scan errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# (2) forbid ad-hoc `uname -m` outside lib/os.sh (its sanctioned home). The grep
# prints paths as "<root>/lib/os.sh:...", so anchor the allow-line on the tail.
if out=$(grep -rIn --exclude=check-patterns 'uname -m' "${scan[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" | grep -vE '(^|/)lib/os\.sh:' || true)
  if [ -n "$viol" ]; then
    printf '%s\n' "$viol" >&2
    echo "check-patterns: ad-hoc 'uname -m' outside lib/os.sh - use is-arm64/is-amd64" >&2
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    printf '%s\n' "$out" >&2
    echo "check-patterns: uname scan errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# (3) forbid an UNESCAPED `#` inside a Makefile `$(shell ...)` / `${shell ...}`. macOS's system
# make (3.81) treats a bare `#` in a function argument as a comment, truncating the call
# ("unterminated call to function shell") - a real macos-intel CI failure that GNU make 4.x on
# Linux tolerates. The `#` MUST be escaped `\#` (make strips the backslash; the shell still
# receives `#`). The regex flags an unescaped `#` before the call's first closing `)`/`}`; an
# escaped `\#`, and a trailing `# comment` after the close (glued `)#` or spaced), are NOT
# flagged. HEURISTIC, not a make parser - it does NOT catch a `#` that sits after a NESTED
# `$(...)`'s `)`, nor one on a `\`-continued physical line (grep cannot paren-balance or join
# lines); the macOS CI leg's real make 3.81 is the backstop for those. The repo's only
# `$(shell)` (Makefile:20) is single-line, non-nested, and `\#`-escaped. Targeted at the
# Makefile, which is absent from the `want` scan surface above.
mk="$root/Makefile"
if [ -f "$mk" ]; then
  if out=$(grep -nE '\$[({]shell[^)}]*[^\\)}]#' "$mk" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "check-patterns: unescaped '#' inside a Makefile \$(shell ...)/\${shell ...} - macOS make 3.81 reads it as a comment; escape it as '\\#'" >&2
    bad=1
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      printf '%s\n' "$out" >&2
      echo "check-patterns: Makefile \$(shell ...) scan errored (exit $rc) - failing closed" >&2
      bad=1
    fi
  fi
fi

# (4) re-verify the pinned zsh-plugin startup fork the shim below neutralizes is STILL
# PRESENT, so a submodule pin bump re-checks the shim's premise instead of silently regressing.
# The forkgate measures EXECS, not the semantic shape a bump could change:
# fast-syntax-highlighting.plugin.zsh forks `$(uname -a)` at source time, answered by the zshrc
# `uname` function shim. If a bump removed or reshaped it, the shim would stop covering the real
# fork with no gate to notice, regressing the fork-free startup path. It is the only shim
# premise: the prompt (starship) and zoxide are cached at install time and fork nothing at
# startup, so they have no shape to re-verify here. This file lives
# in a SHA-pinned submodule EXCLUDED from the shared scan above, so reference it by explicit
# path; a present-but-missing shape fails closed, while an ABSENT file (uninitialized submodule)
# is a loud skip, STRICT-escalated.
_shim_shape() {  # $1=file  $2=fixed-string shape  $3=human description
  if [ -r "$1" ]; then
    if ! grep -qF -- "$2" "$1"; then
      echo "check-patterns: $3 - the pinned '$2' shape is GONE from ${1#"$root"/}; a submodule bump changed the shim's premise (re-verify the shim)" >&2
      bad=1
    fi
  elif [ -n "${STRICT:-}" ]; then
    echo "check-patterns: cannot verify $3 - ${1#"$root"/} absent (uninitialized submodule) and STRICT=1 - init submodules" >&2
    bad=1
  else
    echo "check-patterns: SKIP $3 - ${1#"$root"/} absent (uninitialized submodule); set STRICT=1 to fail closed" >&2
  fi
}
# shellcheck disable=SC2016  # the shapes are FIXED-STRING grep patterns: they MUST stay literal, not expand
_shim_shape "$root/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" '$(uname -a)' "f-sy-h uname probe (pinned-plugin shim premise)"

# _re_escape LITERAL -> LITERAL's ERE-escaped form on stdout, used by the
# exact-path exemptions below: `$root` is caller-supplied, not a literal this
# file controls, so it cannot be assumed free of ERE metacharacters. A `sed`
# bracket-expression class, not bash `${s//pat/repl}` substitution: a `}` in
# the REPLACEMENT half of that form closes the `${...}` construct itself,
# leaving a stray literal `}` in the result. `]` must be first in the class to
# read as literal instead of closing it, and `^` must not be first, to the
# same end; `\` needs no doubling, since a bracket expression is not an escape
# context.
_re_escape() {
  printf '%s' "$1" | sed -e 's/[].[(){}^$*+?|\]/\\&/g'
}

# (5) forbid a LONE `/opt/homebrew`. The prefix is /opt/homebrew on Apple Silicon and
# /usr/local on Intel, and it MUST be resolved by directory existence - a hardcoded
# arm64 prefix passes every gate on the Apple Silicon mac and breaks the Intel one
# silently, which is exactly the failure no local run can surface. The ARM64/INTEL
# PAIR ON ONE LINE is what distinguishes detection from a hardcode, so that is what
# the gate looks for: naming /opt/homebrew obliges you to name /usr/local beside it
# (zsh/zshrc's prefix loop and zsh/fzf.zsh's candidate list both already read that
# way). The check is deliberately ASYMMETRIC: /usr/local ALONE is never flagged,
# because it is a generic FHS path with non-Homebrew uses (zsh/zshenv's
# /usr/local/go/bin), while /opt/homebrew can only ever mean Homebrew.
# The pair must be two ADJACENT WORDS, which is what a candidate list or a detection
# loop looks like (`for prefix in /opt/homebrew /usr/local`). Anything looser exempts
# by coincidence: `PATH="/opt/homebrew/bin:/usr/local/bin"` names both inside ONE word
# and is an unconditional hardcode, and `[ -d /usr/local/go ] && P=/opt/homebrew` names
# both on one line while the /usr/local is about Go. The comment tail is removed before
# the test, so `=/opt/homebrew  # /usr/local on Intel` buys no exemption either.
# ALLOWLIST: config/gnupg/gpg-agent.conf, matched on the PATH field alone. gpg-agent.conf
# has no include directive and no variable expansion, so its pinentry path MUST be
# absolute and cannot be prefix-detected; that file's own header records how the Intel
# mac overrides it. Anchored to the EXACT path this scan reads it at (`$root/config/
# gnupg/gpg-agent.conf`, `_re_escape`d), never a substring or a bare suffix: either
# would exempt a decoy file elsewhere ending in the same segments (e.g.
# tests/config/gnupg/gpg-agent.conf) too - fail OPEN.
_gpg_agent_path=$(_re_escape "$root/config/gnupg/gpg-agent.conf")
if out=$(grep -rIn --exclude=check-patterns \
    -F '/opt/homebrew' "${scan[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" \
    | _code_hits '/opt/homebrew' '(/opt/homebrew[^[:space:]]*[[:space:]]+/usr/local|/usr/local[^[:space:]]*[[:space:]]+/opt/homebrew)' \
    | grep -vE "^${_gpg_agent_path}:[0-9]+:" || true)
  if [ -n "$viol" ]; then
    printf '%s\n' "$viol" >&2
    echo "check-patterns: hardcoded Homebrew prefix - '/opt/homebrew' with no '/usr/local' as the ADJACENT word; resolve the prefix by directory existence, and keep the arm64/Intel pair on one line" >&2
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    printf '%s\n' "$out" >&2
    echo "check-patterns: Homebrew-prefix scan errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# (6) forbid asking `brew` where IT lives - the other half of the same rule, and the
# form an internet snippet supplies. BOTH spellings: `brew shellenv` and a BARE
# `brew --prefix`. It is a FORK, so on the zsh startup path it also costs a subprocess
# on every prompt (make forkgate catches it there; this catches it in install.sh and
# lib/ too, where no forkgate runs). `--prefix` must END the word: `brew --prefix
# openssl@3` asks where a FORMULA lives, which is a different question this rule has
# no answer for, and flagging it would offer a remedy that does not apply. Every other
# brew call is untouched - lib/packages.sh's `brew bundle` is how packages install.
if out=$(grep -rIn --exclude=check-patterns \
    -E 'brew[[:space:]]+(shellenv|--prefix([[:space:]]*$|[[:space:]]*[^[:alnum:][:space:]_./@-]))' "${scan[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" | _code_hits 'brew[[:space:]]+(shellenv|--prefix([[:space:]]*$|[[:space:]]*[^[:alnum:][:space:]_./@-]))')
  if [ -n "$viol" ]; then
    printf '%s\n' "$viol" >&2
    echo "check-patterns: a 'brew shellenv' / 'brew --prefix' fork - resolve the Homebrew prefix by directory existence instead" >&2
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    printf '%s\n' "$out" >&2
    echo "check-patterns: brew-shellenv scan errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# (7) forbid bash 4 syntax in the bash-3.2 surface. macOS ships /bin/bash 3.2 and the
# installer runs under it. `make lint` parses this surface with the ABSOLUTE /bin/bash,
# but that pass is not a backstop for these three: `declare -A` and `mapfile` are
# ordinary command invocations and `${var,,}` fails at EXPANSION, so no bash of any
# version reports a parse error for them. The break would first appear at runtime on a
# real mac. This arm is their only gate, and it runs on every host.
# SURFACE: install.sh + lib/*.sh, the same subset as the Makefile's BASH32_FILES -
# bin/ is EXEMPT (its tools run only on a provisioned host or a CI runner). An absent
# file is skipped, not an error, the way `home/` is above. `-H` forces the PATH: prefix
# even for a single file, which _code_of's split depends on. The parameter class covers
# POSITIONALS, `@`/`*` and the `!` indirection, not just names: `${1,,}` on a function
# argument is the most idiomatic use of the construct and so the likeliest slip.
b32=()
[ -f "$root/install.sh" ] && b32+=("$root/install.sh")
for f in "$root"/lib/*.sh; do
  [ -f "$f" ] && b32+=("$f")
done
if [ "${#b32[@]}" -gt 0 ]; then
  b4='(declare|typeset|local)[[:space:]]+-[A-Za-z]*A'
  b4="$b4"'|(^|[^[:alnum:]_])(mapfile|readarray)([^[:alnum:]_]|$)'
  b4="$b4"'|\$\{!?([A-Za-z_][A-Za-z0-9_]*|[0-9][0-9]*|[@*])(\[[^]]*\])?(,|\^)'
  if out=$(grep -HnE "$b4" "${b32[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$b4")
    if [ -n "$viol" ]; then
      printf '%s\n' "$viol" >&2
      echo "check-patterns: bash 4 syntax in the bash-3.2 surface (install.sh, lib/) - no associative arrays, no mapfile/readarray, no \${var,,}" >&2
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      printf '%s\n' "$out" >&2
      echo "check-patterns: bash-3.2 scan errored (exit $rc) - failing closed" >&2
      bad=1
    fi
  fi
fi

# (8) forbid GNU-only regex escapes in the shell surface. BSD sed and grep (macOS)
# implement POSIX regex, where GNU's `\s \S \w \W \b \B \< \>` shorthands and its BRE
# `\| \+ \?` operators are undefined: on a mac the pattern silently means something
# else (a literal `s`, a literal `|`), so a substitution never matches and a guard
# never fires, with no error. Linux runs the GNU tools, so no Linux run of any gate
# sees the break. This arm is its static gate; the fix is always a POSIX class
# (`[[:space:]]`, `[[:alnum:]_]`, `(^|[^[:alnum:]_])`) or the ERE operator under -E.
# SURFACE: every file whose commands run on a mac - install.sh, lib/, bin/, zsh/,
# tests/, the Makefile and the workflows (the macOS runner executes their `run:`
# steps). config/ is NOT scanned: it holds editor configs whose own regex dialects
# (vim's `\s`) are legitimate. Pinned plugins are upstream's code, left out by
# their exact path (_scan_roots), and this script excludes itself by name -
# NEITHER is a language exemption, both are content-independent path
# exclusions of THIRD-PARTY or SELF-REFERENTIAL text.
# `*.py` FILES UNDER tests/ ONLY ARE EXEMPT BY EXTENSION - the only
# content-independent LANGUAGE exemption this arm has, and a fixed suffix,
# never a marker comment or a parse of what is inside the file: Python's `re`
# module is not the shell's regex dialect, GNU-style escapes are portable
# there, so non-shell code that needs one lives in its own `.py` file under
# tests/, never a heredoc embedded in a `.sh` script (a heredoc is still
# shell-surface text to this arm - it has no notion of an embedded language).
# The exemption stops at tests/: bin/, lib/, zsh/, install.sh, the Makefile and
# the workflows are still fully scanned, because lib/link.sh's _link_bin_tree
# links every bin/* file onto the live PATH by basename - a `bin/foo.py`
# holding a shell-adjacent GNU-only regex would run on a mac unscanned if this
# arm exempted it too. tests/ has no such path: nothing there is linked or run
# except through a `*_test.sh` harness, which stays fully scanned.
# TWO SHAPES, both tested on CODE only (the comment that explains the rule spells it):
#   - a shorthand class anywhere in code. It is NOT tied to a sed/grep call word,
#     because a gate's pattern often sits on a continuation line or in a variable
#     (bin/secret-scan's patterns do both); nothing in the surface uses these escapes
#     outside a regex. A `\\` before it is a literal backslash, not the escape.
#   - a BRE operator inside the first quoted argument of a sed/grep call whose flags
#     carry no -E/-r/-P. Under -E, `\|` is an ESCAPED literal bar and is portable.
# PREMISE: a flag group before the pattern is short options only (`-qi`, `-e`); a
# long option (`--posix`) in front of a BRE pattern hides it from the second shape.
_scan_roots install.sh lib bin zsh Makefile .github/workflows
gnu_rest=(${roots[@]+"${roots[@]}"})
_scan_roots tests
gnu_tests=(${roots[@]+"${roots[@]}"})
if [ "${#gnu_rest[@]}" -gt 0 ] || [ "${#gnu_tests[@]}" -gt 0 ]; then
  gnu_esc='(^|[^\\])\\[sSwWbB<>]'
  # The argument body excludes only its OWN closing quote: a `"` inside a
  # single-quoted pattern (or a `'` inside a double-quoted one) is pattern text.
  q="'"
  gnu_bre='(^|[^[:alnum:]_-])(grep|sed)([[:space:]]+-[A-DF-OQ-Za-qs-z]+)*[[:space:]]+'
  gnu_bre="$gnu_bre($q([^$q]*[^\\\\$q])?|\"([^\"]*[^\\\\\"])?)"'\\[|+?]'
  gnu_re="$gnu_esc|$gnu_bre"
  gnu_msg='check-patterns: a GNU-only regex escape - BSD sed/grep on macOS read \s \w \b \< \> and BRE \| \+ \? as something else; use a POSIX class ([[:space:]], [[:alnum:]_]) or the ERE operator under -E'
  # _gnu_scan PY_EXCLUDE ROOT... - one shared grep pass for this arm. PY_EXCLUDE
  # is the literal `*.py` glob for the tests/ call, or "" for every other root
  # (bin/, lib/, zsh/, install.sh, Makefile, workflows) - the `*.py` exemption
  # is tests/-ONLY, never a blanket one, because lib/link.sh's _link_bin_tree
  # links every bin/* file onto the live PATH by basename. On success (0),
  # prints hits already re-tested by _code_hits. On a scan error (2), prints
  # the RAW grep output for the CALLER to report - never a diagnostic of its
  # own, so a call site that stops reading this function's result also loses
  # the message (see _gnu_fail below, which couples that message to `bad=1`
  # as one call).
  # `out=$(...)` stays the DIRECT condition of the `if`, never a statement
  # inside its body, so a clean pass (grep exit 1, no match) does not trip
  # `set -e`.
  _gnu_scan() {
    local py="$1"; shift
    [ "$#" -gt 0 ] || return 1
    local -a exc=(--exclude=check-patterns)
    [ -n "$py" ] && exc+=(--exclude="$py")
    local out rc
    if out=$(grep -rHnIE "${exc[@]}" -- "$gnu_re" "$@" 2>&1); then
      printf '%s\n' "$out" | _code_hits "$gnu_re"
      return 0
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        printf '%s\n' "$out"
        return 2
      fi
      return 1
    fi
  }
  # _gnu_fail MSG - print MSG and set bad=1 as one call. A call site that
  # stops calling _gnu_fail loses its pass-specific message, which the two
  # arm-8 fixtures in tests/check_patterns_test.sh catch. That is the only
  # guarantee this gives: an inline reimplementation that keeps the printf
  # but drops `bad=1` is NOT caught by those fixtures.
  _gnu_fail() {
    printf '%s\n' "$1" >&2
    bad=1
  }
  gnu_viol=""
  if [ "${#gnu_rest[@]}" -gt 0 ]; then
    if out=$(_gnu_scan "" "${gnu_rest[@]}"); then
      [ -n "$out" ] && gnu_viol="${gnu_viol:+$gnu_viol$'\n'}$out"
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        _gnu_fail "$out"$'\n'"check-patterns: GNU-regex scan (non-tests/ pass) errored (exit $rc) - failing closed"
      fi
    fi
  fi
  if [ "${#gnu_tests[@]}" -gt 0 ]; then
    if out=$(_gnu_scan '*.py' "${gnu_tests[@]}"); then
      [ -n "$out" ] && gnu_viol="${gnu_viol:+$gnu_viol$'\n'}$out"
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        _gnu_fail "$out"$'\n'"check-patterns: GNU-regex scan (tests/ pass) errored (exit $rc) - failing closed"
      fi
    fi
  fi
  if [ -n "$gnu_viol" ]; then
    # LC_ALL=C sort (byte order, not a locale collation - identical on BSD and
    # GNU sort) by PATH then LINE NUMBER, the two fields grep -Hn always
    # produces first: a hit's printed position stays independent of both
    # which pass produced it and filesystem readdir order. check-patterns is
    # a lint tool, not a startup-path script, so this fork is fine.
    gnu_viol="$(printf '%s\n' "$gnu_viol" | LC_ALL=C sort -t: -k1,1 -k2,2n)"
    printf '%s\n' "$gnu_viol" >&2
    printf '%s\n' "$gnu_msg" >&2
    bad=1
  fi
fi

# (9) forbid an EARLY-EXIT reader on the right of a pipe in the pipefail surface.
# `grep -q` (and -m, -l, -L) stops reading at its first match and `head` at its
# last line, closing the pipe while the writer may still be writing. bash
# line-buffers a builtin printf, so `printf '%s\n' "$multi_line" | grep -q X` is
# one write(2) PER LINE, and whether the reader has exited before the next one is
# pure scheduling. When it has, the writer dies of SIGPIPE (or prints "printf:
# write error: Broken pipe" where SIGPIPE is ignored, as on a CI runner), and
# under pipefail the PIPELINE fails even though grep matched: an assertion goes
# red at random (tests/packages_test.sh on macOS CI, 2026-09-25), and a NEGATED
# one (`if cmd | grep -q X; then fail`) goes silently green. The fix is always to
# remove the concurrent writer - a here-string (`grep -q X <<<"$var"`,
# `grep -q X <<<"$(cmd)"`), `[ -n "$(find ...)" ]` - or a reader that drains its
# input (`sed -n 1p` for `head -1`).
# SURFACE: every file that runs under pipefail - install.sh and the lib/ it sources,
# bin/, tests/, and the workflows (GitHub's bash steps run `-eo pipefail`). zsh/ is
# interactive config with no pipefail, and the Makefile's recipes run without it.
# Covered: `|` and `|&`, and grep, egrep and fgrep, behind env assignments.
# NOT covered: an awk that `exit`s early, `sed ... q`, a reader behind a
# function or variable, and a pipe that ENDS a line with the reader on the next
# one (`cmd |` newline `grep -q x`) - a line-oriented grep cannot see those.
# (The LEADING-pipe continuation, `\` newline `| grep -q x`, is caught.)
# KNOWN FALSE POSITIVES, both from matching text, not parsing shell: the shape
# inside a quoted string (`echo "a | grep -q b"`), and a flag-looking pattern
# argument read as a flag (`cmd | grep -e -l y`). Rephrase the line; neither
# shape exists in the tree.
_scan_roots install.sh lib bin tests .github/workflows
eex=(${roots[@]+"${roots[@]}"})
if [ "${#eex[@]}" -gt 0 ]; then
  eex_re='(^|[^|])\|&?[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*'
  eex_re="$eex_re"'([ef]?grep([[:space:]]+-[^[:space:]]*)*[[:space:]]+(-[A-Za-z]*[qmlL][A-Za-z0-9]*|--(quiet|silent|max-count[=[:alnum:]]*|files-with(out)?-match(es)?))([^[:alnum:]_-]|$)|head([^[:alnum:]_-]|$))'
  if out=$(grep -rHnIE --exclude=check-patterns -- "$eex_re" "${eex[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$eex_re")
    if [ -n "$viol" ]; then
      printf '%s\n' "$viol" >&2
      echo "check-patterns: an early-exit reader (grep -q/-m/-l, head) on the right of a pipe - under pipefail the writer can die of SIGPIPE and fail the pipeline at random; feed it a here-string (grep -q PAT <<<\"\$var\") or use a reader that drains (sed -n 1p)" >&2
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      printf '%s\n' "$out" >&2
      echo "check-patterns: early-exit-reader scan errored (exit $rc) - failing closed" >&2
      bad=1
    fi
  fi
fi

# (10) forbid a `--` AFTER the first operand of a file or text tool. macOS's
# tools parse argv with BSD getopt, which stops at the first non-option: in
# `chmod -R go-w -- "$d"` the mode ends option parsing, so the `--` is a FILE
# operand ("chmod: --: No such file or directory", exit 1). GNU getopt permutes
# argv and accepts either order, so no Linux run sees the break, and a caller
# that swallows the exit code hides it on a mac too: install.sh's
# harden_plugin_perms warned on every mac install this way while the macOS CI
# legs stayed green (measured 2026-09-25). The fix is always to move `--` in
# front of the first operand: `chmod -R -- go-w "$d"`, `grep -q -- "$pat" "$f"`.
# SURFACE: the same files as arm 8 - everything that runs on a mac.
# SHAPE: a command word in command position (line start; after `; & | ( ) { ! `,
# the `)` covering a case arm `pat) cmd`; or behind a workflow `run:`,
# then/do/else/elif/if/while/until/time/sudo/command/exec/env/nohup; then env
# assignments, then optionally a path), then option tokens, then a token that
# does not start with `-` (the first operand), then any tokens, then a bare `--`.
# A token is unquoted text plus WHOLE quoted strings, so a ` -- ` inside a quoted
# pattern is not the delimiter. An option that takes an argument (`grep -e PAT`,
# `mkdir -m 700`) would make a separate argument read as the first operand, so
# each tool family names its argument-taking short letters. The FIRST such
# letter in a cluster takes the argument, as getopt does: the rest of the
# cluster when anything follows it (`-em` is `-e m`), else the next token
# (`-qe PAT`). Families: chmod chown chgrp rm rmdir cat (none); cp mv ln (S t,
# GNU); mkdir (m); touch (A d r t); grep egrep fgrep (A B C D d e f m); sed
# (e f i).
# NOT covered: other tools (find has no such `--`: its paths come first); a
# command behind `\` (`\rm`), `env` or `sudo` with options (`env -i`,
# `sudo -n`), `coproc`, `$CMD` indirection, `find -exec`, xargs, an alias or an
# `sh -c '...'` string; and a call split across `\` lines.
# KNOWN FALSE POSITIVES, from matching text, not parsing shell: a LONG option
# that takes a separate argument (`grep --regexp PAT -- f`) reads PAT as the
# first operand - write `--regexp=PAT`; a redirection before the `--`
# (`rm 2>/dev/null -- f`) reads as the first operand - put it last; and quoted
# prose or an unquoted `$(...)` argument holding a separator or keyword before a
# tool name and a later ` -- ` (`warn "x; rm it by hand -- see docs"`) reads as
# a call - rephrase it. None of these exists in the tree.
_scan_roots install.sh lib bin zsh tests Makefile .github/workflows
dd=(${roots[@]+"${roots[@]}"})
if [ "${#dd[@]}" -gt 0 ]; then
  dd_pos='((^|[;&|(){!`])[[:space:]]*'                   # after a separator; `)` ends a case pattern
  dd_pos="$dd_pos"'|(^|[^[:alnum:]_-])(run:|then|do|else|elif|if|while|until|time|sudo|command|exec|env|nohup)[[:space:]]+)'
  dd_pos="$dd_pos"'([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*'  # env assignments: LC_ALL=C grep
  dd_pos="$dd_pos"'([^[:space:];&|()]*/)?'                 # a path prefix: /bin/rm
  # A TOKEN is unquoted text plus whole quoted strings, so a ` -- ` INSIDE a quoted
  # pattern (`grep -qx 'install --pin v1 -- gh'`) is not read as the delimiter. It
  # never crosses `; & | ( )`: a `)` closes the `$(...)` the command sits in.
  q="'"
  dd_qs="${q}[^${q}]*${q}|\"[^\"]*\""
  dd_tok="([^[:space:];&|()$q\"]|$dd_qs)+"
  dd_tail="[[:space:]]+([^-[:space:];&|()$q\"]|$dd_qs)([^[:space:];&|()$q\"]|$dd_qs)*"
  dd_tail="$dd_tail([[:space:]]+$dd_tok)*[[:space:]]+--([[:space:];&|)]|\$)"
  # _dd_family TOOLS LETTERS -> one alternative: TOOLS, their options, the tail.
  _dd_family() {
    local opt='[[:space:]]+(--[^[:space:]]+|-[^[:space:]-]+)'
    if [ -n "$2" ]; then
      # A cluster with no argument letter; or one whose FIRST argument letter takes
      # the rest of the cluster (`-em`); or one ending at that letter, which takes
      # the next token (`-qe PAT`).
      opt="[[:space:]]+(--[^[:space:]]+|-[^[:space:]$2-]+|-[^[:space:]$2-]*[$2]$dd_tok|-[^[:space:]$2-]*[$2][[:space:]]+$dd_tok)"
    fi
    printf '%s' "$dd_pos($1)($opt)*$dd_tail"
  }
  dd_re="$(_dd_family 'chmod|chown|chgrp|rm|rmdir|cat' '')"
  dd_re="$dd_re|$(_dd_family 'cp|mv|ln' 'St')"
  dd_re="$dd_re|$(_dd_family 'mkdir' 'm')"
  dd_re="$dd_re|$(_dd_family 'touch' 'Adrt')"
  dd_re="$dd_re|$(_dd_family '[ef]?grep' 'ABCDdefm')"
  dd_re="$dd_re|$(_dd_family 'sed' 'efi')"
  if out=$(grep -rHnIE --exclude=check-patterns -- "$dd_re" "${dd[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$dd_re")
    if [ -n "$viol" ]; then
      printf '%s\n' "$viol" >&2
      echo "check-patterns: a '--' after the first operand - BSD getopt (macOS) stops at the first non-option, so the '--' becomes a file operand; put it before the first operand (chmod -R -- go-w \"\$d\")" >&2
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      printf '%s\n' "$out" >&2
      echo "check-patterns: '--' placement scan errored (exit $rc) - failing closed" >&2
      bad=1
    fi
  fi
fi

# (11) forbid the Unicode em dash (U+2014, UTF-8 bytes E2 80 94) in the repo's
# own prose. House style (CONTRIBUTING.md's community standards and
# .claude/rules/docs.md's documentation standard) is a plain hyphen; this arm
# looks for exactly that one character, nothing broader. The pattern is built
# at RUNTIME from its UTF-8 bytes via bash's ANSI-C quoting ($'\xe2\x80\x94'),
# never pasted as a literal em dash into this script. `LC_ALL=C` keeps the
# match byte-oriented on both grep flavors, independent of the runner's
# locale (a locale-aware BSD grep can otherwise mishandle a line that also
# holds unrelated malformed UTF-8, which would silently skip the match).
# SELF-EXCLUDE: this arm keeps `--exclude=check-patterns` on its RECURSIVE
# scan below like every other recursive arm, but for a DIFFERENT reason than
# arms (1)/(2)/(5)/(6)/(8)/(9)/(10) - their patterns spell the forbidden
# literal directly in this file's own comments and code, so their
# self-exclude prevents the arm from matching its own documentation. Arm 11's
# pattern is raw bytes assembled at RUNTIME ($'\xe2\x80\x94'), so nothing in
# THIS file's CURRENT source can match it either way. The flag is kept anyway
# for UNIFORMITY: tests/plugins_test.sh asserts, by shape and by count (not a
# fixed literal), that EVERY recursive grep line in this script carries
# `--exclude=check-patterns` and that none carries `--exclude-dir` - a
# project-wide invariant that lets a future arm's author copy the pattern
# without having to re-derive, case by case, whether their new arm happens to
# need it.
# On its own, that self-exclude would leave a gap for THIS arm: the recursive
# scan never reads this file, so a literal em dash pasted into a future edit
# of it would pass. Measured before the narrow scan below existed: appending
# an em dash to a scratch copy of this file and running the gate exited 0.
# So arm 11 adds a second, NARROW, NON-recursive scan of exactly
# "$root/bin/check-patterns" below - no `-r`/`-R` in its flags, so it neither
# adds to tests/plugins_test.sh's recursive-scan count nor needs its own
# self-exclude (there is nothing else at that exact path to exclude it from).
# UNLIKE arms (5)-(10), this one does NOT strip comments through
# _code_of/_code_hits: an em dash inside a COMMENT is exactly the shape this
# rule forbids - a shell or Markdown comment is still repo prose - the same
# reasoning arms (1)-(2) use for curl|sh and uname -m.
# SURFACE: the shared ${scan[@]} (install.sh, lib/, bin/, zsh/, config/,
# packages/, security/, home/) plus the rest of the repo's own prose that
# `want` does not cover - docs/, tests/, .github/, .claude/, Makefile, the
# top-level docs and metadata files, and the repo's own dotfiles
# (.gitignore, .gitmodules, REUSE.toml, cliff.toml, .gitleaks.toml). No
# `${#prose[@]}` emptiness guard here, unlike arms (7)-(10): `prose` starts as
# a copy of `${scan[@]}`, and the check at the top of this script already
# exits 2 before this point if `scan` is empty, so `prose` can never be empty
# either - a guard here would be dead code, not defensive.
# ALLOWLIST, both content-independent path exclusions, never a language or
# comment exemption:
#   - LICENSES/*.txt, COPYING and CODE_OF_CONDUCT.md are left OUT of the
#     surface entirely, rather than scanned-then-exempted: verbatim upstream
#     legal text this repo reproduces exactly and never edits for house style
#     (the GPL text in COPYING; the Apache-2.0/MIT/FSFAP/CC-BY-SA-4.0 texts in
#     LICENSES/; and CODE_OF_CONDUCT.md's Contributor Covenant, itself
#     CC-BY-SA-4.0 - see docs/development.md's REUSE section). There is no
#     first-party content in any of them to lose by the omission.
#   - config/nvim/lazy-lock.json sits INSIDE the otherwise-scanned config/, so
#     it is exempted the same way arm (5) exempts config/gnupg/gpg-agent.conf:
#     a grep -v on the hit list, not a directory omission. REUSE.toml already
#     records why: lazy.nvim rewrites the file wholesale on every plugin
#     update, so a fix landed here would not survive the next sync. The
#     exemption is ANCHORED to the EXACT path this scan reads it at
#     (`$root/config/nvim/lazy-lock.json`, `_re_escape`d - see arm (5) above),
#     never a substring or a bare suffix match: either would exempt a decoy
#     file elsewhere ending in the same segments (e.g.
#     tests/config/nvim/lazy-lock.json) too - fail OPEN.
em_dash=$'\xe2\x80\x94'
_scan_roots docs tests .github .claude Makefile REUSE.toml cliff.toml \
  .gitleaks.toml .gitignore .gitmodules CLAUDE.md CONTRIBUTING.md \
  SECURITY.md THIRD-PARTY-NOTICES.md README.md
prose=("${scan[@]}" ${roots[@]+"${roots[@]}"})
_lazy_lock_path=$(_re_escape "$root/config/nvim/lazy-lock.json")
if out=$(LC_ALL=C grep -rHIn --exclude=check-patterns \
    -F "$em_dash" "${prose[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" \
    | grep -vE "^${_lazy_lock_path}:[0-9]+:" || true)
  if [ -n "$viol" ]; then
    printf '%s\n' "$viol" >&2
    echo "check-patterns: an em dash (U+2014) in repo prose - house style is a plain '-'; replace it" >&2
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    printf '%s\n' "$out" >&2
    echo "check-patterns: em-dash scan errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# NARROW SELF-SCAN, non-recursive, no self-exclude: the recursive scan above
# never sees this exact path (`--exclude=check-patterns` skips it), so a
# literal em dash pasted into a future edit of check-patterns itself would
# otherwise never be caught. `-F`, no `-r`/`-R` - a single, explicit file, not
# a directory walk - so this line is invisible to
# tests/plugins_test.sh's recursive-grep invariant (confirmed: that test still
# passes with this scan in place). Absent (a fixture
# tree with no bin/check-patterns of its own) is a silent skip, the same as
# every other optional path in this script.
self_cp="$root/bin/check-patterns"
if [ -f "$self_cp" ]; then
  if out=$(LC_ALL=C grep -Fn -- "$em_dash" "$self_cp" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "check-patterns: an em dash (U+2014) in check-patterns' own source - house style is a plain '-'; replace it" >&2
    bad=1
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      printf '%s\n' "$out" >&2
      echo "check-patterns: check-patterns self-scan errored (exit $rc) - failing closed" >&2
      bad=1
    fi
  fi
fi

# (12) forbid a symlink where a recursive scan reads, plus (when `$root` has a
# .git of its own) a tracked symlink or a non-plugin gitlink anywhere in the
# repo. A recursive scan never follows a symlink it meets while walking a
# directory, so one there hides its target from every arm that walks past it.
#
# SURFACE: `prose`, arm (11)'s own surface (the widest above) - a single
# source, not a fourth hand-kept list - plus `scan_links`, the symlink
# entries of zsh/ that _scan_roots kept away from the grep arms. It holds no
# pinned zsh/plugins directory (_scan_roots left it out), so find never walks
# it either; a symlinked zsh/plugins is one of `scan_links` and is reported.
#
# ALWAYS: `find -type l` over that surface - what a recursive scan actually
# reads, tracked or not.
#
# ADDITIONALLY, since NO arm reads zsh/plugins/, anything there that is not a
# pinned plugin would hide from all of them:
#   - always: every direct child of a real zsh/plugins directory that is not
#     a directory (`find`), tracked or not. A plain directory there cannot be
#     told apart from an unpopulated submodule without git, so only the git
#     pass sees a file nested inside one;
#   - when `$root/.git` exists: every tracked entry under zsh/plugins/ whose
#     mode is not 160000 (a gitlink), and every other tracked non-gitlink
#     path that lands in zsh/plugins/ on disk anyway - its first two
#     segments spell zsh/plugins in another ASCII case, or the filesystem
#     resolves them to zsh/plugins (a case-insensitive filesystem, macOS's
#     default, folds more than ASCII) - in the repo-wide git pass below.
#
# ADDITIONALLY, when `$root/.git` exists: the WHOLE repository, tracked only,
# for what `find` cannot see - a tracked symlink outside `prose`, or a gitlink
# (mode 160000) that is not a pinned plugin. See `_git_symlink_pass`.
#
# FAILS CLOSED on any error from any pass, and when `$root/.git` exists but
# the git pass cannot run or resolve `$root` as its toplevel.
plugins_msg="check-patterns: an entry under zsh/plugins/ that is not a pinned plugin - no arm scans zsh/plugins/; move it out, or pin it as submodule.<name>.path = zsh/plugins/<name> in .gitmodules"
has_git=0
{ [ -e "$root/.git" ] || [ -L "$root/.git" ]; } && has_git=1
if out=$(find "${prose[@]}" ${scan_links[@]+"${scan_links[@]}"} -type l -print 2>&1); then
  viol="$out"
else
  rc=$?
  printf '%s\n' "$out" >&2
  echo "check-patterns: symlink scan (find) errored (exit $rc) - failing closed" >&2
  bad=1
  viol=""
fi
if [ -n "$viol" ]; then
  printf '%s\n' "$viol" >&2
  echo "check-patterns: a symlink where a recursive scan reads - its target is never scanned; remove it or replace it with the real file" >&2
  bad=1
fi

if [ -d "$root/zsh/plugins" ] && [ ! -L "$root/zsh/plugins" ]; then
  # -mindepth/-maxdepth: both GNU and BSD find. `! -type d` without -L
  # counts a symlink to a directory too.
  if out=$(find "$root/zsh/plugins" -mindepth 1 -maxdepth 1 ! -type d -print 2>&1); then
    if [ -n "$out" ]; then
      printf '%s\n' "$out" >&2
      echo "$plugins_msg" >&2
      bad=1
    fi
  else
    rc=$?
    printf '%s\n' "$out" >&2
    echo "check-patterns: zsh/plugins scan (find) errored (exit $rc) - failing closed" >&2
    bad=1
  fi
fi

# _git_symlink_pass - the repo-wide git pass; non-zero on a violation or any
# error. A subshell, so its EXIT trap removes the scratch dir on every path.
# Every status is checked by hand: the caller's `!` suspends `set -e` here.
#
# Every git call goes through `_git_clean`, which strips git's own local env
# vars first, so a leaked GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE cannot steer the
# probe or the listing at a different repository. That list comes from git
# itself, so an empty or failed answer, or one without GIT_DIR and
# GIT_INDEX_FILE, would strip nothing: it fails closed instead. Other ambient
# git tracing (the GIT_TRACE family, a trace2.* config key) cannot be
# enumerated, so stderr is kept apart from the NUL-delimited listing and ANY
# stderr from the listing fails closed; the probe's stderr is shown only when
# the probe itself fails.
#
# `-c core.fsmonitor=false` on every call that runs INSIDE `$root`: that key
# names a program, and git runs it even for a read-only ls-files.
_git_symlink_pass() (
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/check-patterns-sym.XXXXXX" 2>/dev/null) || {
    echo "check-patterns: could not create a scratch dir for the repo-wide symlink scan - failing closed" >&2
    exit 1
  }
  trap 'rm -rf "$tmpd"' EXIT

  git_unset=()
  lev_rc=0
  git rev-parse --local-env-vars >"$tmpd/lev" 2>"$tmpd/lev.err" || lev_rc=$?
  has_dir=0
  has_index=0
  while IFS= read -r v; do
    case "$v" in
      GIT_DIR) has_dir=1 ;;
      GIT_INDEX_FILE) has_index=1 ;;
    esac
    [ -n "$v" ] && git_unset+=("$v")
  done <"$tmpd/lev"
  if [ "$lev_rc" -ne 0 ] || [ "$has_dir" -ne 1 ] || [ "$has_index" -ne 1 ]; then
    cat "$tmpd/lev.err" >&2
    echo "check-patterns: symlink scan (git, repo-wide) could not list git's local env vars (git rev-parse --local-env-vars: exit $lev_rc, GIT_DIR listed: $has_dir, GIT_INDEX_FILE listed: $has_index) - failing closed" >&2
    exit 1
  fi
  _git_clean() {
    local -a e=()
    local v
    if [ "${#git_unset[@]}" -gt 0 ]; then
      for v in "${git_unset[@]}"; do
        e+=(-u "$v")
      done
    fi
    env ${e[@]+"${e[@]}"} git "$@"
  }

  # Defensive: --show-toplevel runs no fsmonitor today (an equivalent
  # mutant), kept so every git call inside `$root` carries the flag.
  if ! top=$(_git_clean -C "$root" -c core.fsmonitor=false rev-parse --show-toplevel 2>"$tmpd/probe.err"); then
    cat "$tmpd/probe.err" >&2
    echo "check-patterns: symlink scan (git, repo-wide) could not resolve the toplevel of '$root' - failing closed" >&2
    exit 1
  fi
  # -ef compares device and inode, so a case-variant or symlinked spelling of
  # $root (macOS) still matches. A core.worktree or gitfile can point the work
  # tree away from $root even when $root/.git exists.
  if ! [ "$top" -ef "$root" ]; then
    echo "check-patterns: symlink scan (git, repo-wide) resolved a different toplevel ('$top') for '$root' - failing closed" >&2
    exit 1
  fi

  # A pinned plugin is a `submodule.<name>.path` in .gitmodules AND a direct
  # child of zsh/plugins/ - read from .gitmodules, not a hand-kept list. Any
  # other `*.path` key, or a gitlink elsewhere, is not a pin.
  pinned=()
  if [ -f "$root/.gitmodules" ]; then
    gm_rc=0
    _git_clean config -f "$root/.gitmodules" --get-regexp '^submodule\..*\.path$' \
      >"$tmpd/gm" 2>"$tmpd/gm.err" || gm_rc=$?
    # exit 1 = no such key, an empty pin set; anything higher is an error.
    if [ "$gm_rc" -gt 1 ]; then
      cat "$tmpd/gm.err" >&2
      echo "check-patterns: symlink scan (git, repo-wide) could not read .gitmodules (exit $gm_rc) - failing closed" >&2
      exit 1
    fi
    while read -r _gm_key gm_path; do
      case "$gm_path" in
        zsh/plugins/*/*) ;;
        zsh/plugins/?*) pinned+=("$gm_path") ;;
      esac
    done <"$tmpd/gm"
  fi

  ls_rc=0
  _git_clean -C "$root" -c core.fsmonitor=false ls-files -s -z >"$tmpd/list" 2>"$tmpd/ls.err" || ls_rc=$?
  if [ "$ls_rc" -ne 0 ]; then
    cat "$tmpd/ls.err" >&2
    echo "check-patterns: symlink scan (git ls-files, repo-wide) errored (exit $ls_rc) - failing closed" >&2
    exit 1
  fi
  # ls-files' own stderr file: a traced probe above writes to stderr too.
  if [ -s "$tmpd/ls.err" ]; then
    cat "$tmpd/ls.err" >&2
    echo "check-patterns: symlink scan (git ls-files, repo-wide) wrote to stderr (a GIT_TRACE* variable, or a trace2.* config key?) - failing closed" >&2
    exit 1
  fi

  # `<mode> <oid> <stage><TAB><path>`, sha1 or sha256 oid. Anything else (a
  # trace aimed at stdout, say) fails closed rather than being skipped.
  rec_re=$'^[0-7]{6} [0-9a-f]{40,64} [0-3]\t.'
  git_viol=""
  plugins_viol=""
  entry=""
  while IFS= read -r -d '' entry; do
    if ! [[ $entry =~ $rec_re ]]; then
      echo "check-patterns: symlink scan (git ls-files, repo-wide) returned a malformed record - failing closed" >&2
      exit 1
    fi
    mode="${entry%% *}"
    gpath="${entry#*$'\t'}"
    case "$mode" in
      120000)
        git_viol="$git_viol$root/$gpath"$'\n'
        ;;
      160000)
        allowed=0
        if [ "${#pinned[@]}" -gt 0 ]; then
          for a in "${pinned[@]}"; do
            [ "$gpath" = "$a" ] && { allowed=1; break; }
          done
        fi
        [ "$allowed" -eq 1 ] \
          || git_viol="$git_viol$root/$gpath (gitlink, not a pinned plugin)"$'\n'
        ;;
      *)
        # Bracket classes, not `tr` (a fork per entry) or nocasematch (a
        # shell-wide switch): the exact spelling is matched first, so the
        # second pattern only ever sees another case of it. They cover ASCII
        # case only, the same on every filesystem.
        listed=0
        case "$gpath" in
          zsh/plugins/*)
            plugins_viol="$plugins_viol$root/$gpath (tracked, mode $mode)"$'\n'
            listed=1 ;;
          [zZ][sS][hH]/[pP][lL][uU][gG][iI][nN][sS]/* | [zZ][sS][hH]/[pP][lL][uU][gG][iI][nN][sS])
            if [ "$gpath" != zsh/plugins ]; then
              plugins_viol="$plugins_viol$root/$gpath (tracked; the path case-folds to zsh/plugins, which a case-insensitive filesystem puts under zsh/plugins/)"$'\n'
              listed=1
            fi ;;
        esac
        # Any other spelling of the first two segments that the FILESYSTEM
        # resolves to zsh/plugins (APFS also folds non-ASCII, e.g. U+017F to
        # `s`): asked with -ef (device and inode), since no name match can know
        # its folding rules. Only zsh/plugins: a path that lands elsewhere in
        # zsh/ is scanned by every grep arm there. The exact zsh/plugins/
        # spelling never reaches here: it is `listed` above. Parameter
        # expansion only, no fork per entry.
        if [ "$listed" -eq 0 ]; then
          case "$gpath" in
            */*/*)
              gdir="${gpath%%/*}"
              grest="${gpath#*/}"
              gsub="${grest%%/*}"
              if [ "$root/$gdir/$gsub" -ef "$root/zsh/plugins" ]; then
                plugins_viol="$plugins_viol$root/$gpath (tracked; on disk, '$gdir/$gsub' is the same directory as zsh/plugins)"$'\n'
              fi ;;
          esac
        fi
        ;;
    esac
    entry=""
  done <"$tmpd/list"
  # read returns non-zero on a trailing record with no NUL terminator.
  if [ -n "$entry" ]; then
    echo "check-patterns: symlink scan (git ls-files, repo-wide) returned a malformed record - failing closed" >&2
    exit 1
  fi

  rc=0
  if [ -n "$git_viol" ]; then
    printf '%s' "$git_viol" >&2
    echo "check-patterns: a tracked symlink, or a gitlink that is not a pinned plugin - remove it; a plugin is pinned as submodule.<name>.path = zsh/plugins/<name> in .gitmodules" >&2
    rc=1
  fi
  if [ -n "$plugins_viol" ]; then
    printf '%s' "$plugins_viol" >&2
    echo "$plugins_msg" >&2
    rc=1
  fi
  exit "$rc"
)

if [ "$has_git" -eq 1 ]; then
  if ! command -v git >/dev/null 2>&1; then
    echo "check-patterns: symlink scan (git, repo-wide) cannot run: git is not on PATH, yet '$root/.git' exists - failing closed" >&2
    bad=1
  elif ! _git_symlink_pass; then
    bad=1
  fi
fi

[ "$bad" -eq 0 ]
