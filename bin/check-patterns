#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Bruno Marques Venceslau de Souza <b@venceslau.dev>
#
# SPDX-License-Identifier: GPL-3.0-or-later

#
# check-patterns - static-pattern lint gate over the dotfiles' own surface.
#
# The static-pattern component that `make check-patterns` runs and
#   `make lint` includes. Fifteen checks across our OWN runtime surface
#   (the SHA-pinned zsh plugin submodules are third-party and excluded by their
#   one exact path, zsh/plugins - we police our code, not upstream's):
#     (1) a curl or wget download piped into sh or bash (or otherwise executed
#         on the same line) - the static CI half of the no-runtime-download
#         rule (the startup-path half is the fast-syntax-highlighting
#         neutralization in zsh/zshrc). It reads the shared surface plus the
#         Makefile and .github/, and this file through a narrow
#         self-scan (as arms 2 and 11 do).
#     (2) an ad-hoc uname with -m outside lib/os.sh - arch branching MUST go through
#         the is-arm64 / is-amd64 helpers.
#     (3) an unescaped `#` inside a Makefile `$(shell ...)` / `${shell ...}` - macOS's
#         system make (3.81) reads a bare `#` in a function argument as a comment and
#         aborts ("unterminated call to function shell"), which GNU make 4.x on Linux
#         silently tolerates; it MUST be escaped `\#`. A targeted, heuristic
#         check on the Makefile (off the shared scan surface; arms 1, 8 and
#         10-12 read it too); a `#` after a nested `$(...)` or on a
#         `\`-continued line is not caught (the macOS CI leg's real make 3.81 backstops it).
#     (4) a drifted pinned-plugin shim premise in the SHA-pinned zsh plugins - the one pinned
#         `$(uname -a)` shape the startup fork-free path relies on; a bump that
#         reshapes it must re-verify the shim. It is the only startup fork a shim
#         covers - see the note above the check itself.
#     (5) a LONE `/opt/homebrew` - the Homebrew prefix MUST be resolved by directory
#         existence, so naming the Apple Silicon prefix without the Intel one on the
#         same line is the shape of a hardcode that breaks the Intel mac silently.
#     (6) a `brew shellenv` / `brew --prefix` fork - the other half of the same rule.
#     (7) bash 4 syntax in the bash-3.2 surface (install.sh + lib/*.sh) - the class
#         `make lint`'s `/bin/bash -n` pass cannot see in ANY bash, because
#         `declare -A` and `mapfile` are ordinary command invocations and `${var,,}`
#         fails at expansion, not at parse. This is their only gate.
#     (8) GNU-only regex escapes (`\s`, `\w`, `\b`, BRE `\|`) in the shell surface,
#         tests/ and the workflows included - BSD sed/grep on macOS silently read
#         them as something else, and no Linux run can see it. Inside tests/ ONLY,
#         `*.py` files are exempt by extension - the only content-independent
#         language exemption this arm has, never a marker or a parse of the file
#         (the arm's other two exclusions are the pinned plugins dir and this
#         script by name, both unrelated to language). Python's own `re` module
#         has a different regex dialect, where those escapes are portable, so
#         non-shell code lives in its own `.py` file under tests/ rather than a
#         heredoc inside a `.sh` script. bin/, lib/, zsh/, install.sh, the
#         Makefile and the workflows keep no such exemption: lib/link.sh's
#         _link_bin_tree links every bin/* file onto the live PATH by basename,
#         so a `.py` file there could still run as shell-adjacent code.
#     (9) an early-exit reader (`grep -q`/`-m`/`-l`, `head`) on the right of a
#         pipe in the pipefail surface - the writer can die of SIGPIPE when the
#         reader exits first, failing the pipeline at random.
#    (10) a `--` after the first operand of a file or text tool (`chmod -R go-w --`)
#         - BSD getopt on macOS stops at the first operand and reads the `--` as a
#         file, which GNU's argv permutation hides from every Linux run.
#    (11) the Unicode em dash (U+2014) anywhere in the repo's own prose - the
#         house style (CONTRIBUTING.md and .claude/rules/docs.md) is a plain
#         hyphen. Unlike arms 5-10 it does NOT strip comments first: a comment
#         is prose too, the same reasoning arms 1-2 use for a fetch piped
#         into a shell and for uname with -m. Vendored legal text and one auto-generated lockfile are
#         allowlisted; see the arm itself.
#    (12) a symlink anywhere the arms above read, plus (when ROOT has its
#         own .git) any tracked symlink, or gitlink that is not a pinned
#         plugin, anywhere in the repo - a recursive scan never follows a
#         symlink it meets while walking a directory, so one there hides its
#         target from every arm that walks past it. It also refuses anything
#         under zsh/plugins/ that is not a pinned plugin, since no arm reads
#         there. See the arm itself for the passes and why each runs. The
#         same passes FAIL CLOSED (exit 2) on a file name the arms cannot
#         read (a `:`, LF or CR in it) or skip (`check-patterns` anywhere but
#         bin/).
#    (13) a raw readlink in install.sh or lib/ outside lib/link.sh's
#         _link_readlink - `$(readlink)` strips a target's trailing newline
#         and BSD readlink's terminator is not GNU's. The one exempt line is
#         the helper's own call, found inside its body at scan time, never
#         a line number kept here; an ambiguous helper fails closed. Text
#         matching, so the word in a string or as a name (`echo "readlink"`,
#         `readlink=x`) is flagged too.
#    (14) a local/typeset (declare, integer, float, readonly, private)
#         without -g, or a for/foreach/select loop variable, of zsh's path,
#         cdpath, fpath, manpath, module_path or their scalars in zsh/ -
#         a local copy keeps its tie and rewrites the command search path
#         for the whole call; a loop variable overwrites the global.
#    (15) a Markdown prose line over 80 columns, outside code, tables,
#         headings and HTML, and unless one unbreakable token (a URL, a
#         code span, a whole link) alone makes it long.
#
# FAILS CLOSED. The earlier inline Makefile recipe passed `$(PATTERN_SCAN)`
#   verbatim to grep, including the optional (and usually absent) `home/`. A
#   missing path makes grep exit 2, and bash's `if grep ...; then fail` reads a
#   non-zero exit as "no match" - so BOTH checks were silently disabled whenever
#   any scan path was absent (fail-OPEN: a real curl piped into sh would pass). This tool
#   fixes both halves: it scans only paths that EXIST (an absent optional dir is
#   skipped, not an error), and it treats a real grep error (exit >= 2) as a hard
#   failure, never a silent pass. Regression coverage: tests/check_patterns_test.sh.
#
# Bash 3.2 compatible (indexed arrays only; no assoc arrays, no
#   mapfile) so the macOS CI legs behave identically.
#
# Usage: check-patterns [ROOT]   (ROOT default: current directory)
#   ROOT MUST be a checkout you trust: arm (12) runs git inside it, and
#   although the one config key known to run a program on a read-only call
#   (core.fsmonitor) is forced off there, the repo's own .git/config is read.
#   Exit: 0 clean; 1 a forbidden pattern was found; 2 nothing to scan, a scan
#         error the gate detects (a tool failing, the report sanitizer
#         included; an unreadable file; a pinned-plugin file STRICT=1 cannot
#         verify), a file holding a NUL byte, or a file name arm (12) refuses
#         (fail closed). A command failing in the main shell where `set -e`
#         would stop the script exits 2 as well (the ERR trap below), never
#         with its own status, which a 1 would make read as "a violation".
#         Inside a `$(...)` that holds only where the failure surfaces as
#         its status in the main shell; see the trap. The git pass runs
#         under the caller's `||`, where neither `set -e` nor the trap acts:
#         only the statuses it checks by hand count, and a non-zero one it
#         returns reads as a violation (exit 1), or exit 2 when it is 2.

set -euo pipefail
# The C locale for this script and every tool it runs. In a multibyte locale
# (C.UTF-8, en_US.UTF-8) GNU grep's `[^|]*` does not match an invalid byte,
# so arm 1 missed a curl piped into sh whose URL held a 0xFF byte (exit 0 under
# LC_ALL=C.UTF-8, 1 under LC_ALL=C). Every pattern here is ASCII and every
# comparison is meant byte-wise (arm 8's sort, the sanitizer, arm 11's em
# dash bytes), so no arm wants the caller's locale. LC_ALL overrides LANG
# and every LC_* variable.
export LC_ALL=C
# BSD grep (macOS) prepends an inherited GREP_OPTIONS to every call's
# options, so a `-I` there would skip every file holding a NUL and a `-v`
# would invert every arm; GNU grep 3.6+ ignores the variable.
unset GREP_OPTIONS
# An inherited SHELLOPTS=xtrace would trace every expanded line, file names
# and contents included, to stderr raw, around the sanitizer below.
set +x
# An inherited BASHOPTS (bash 4.1+ imports it) can switch these on: failglob
# aborts on the first unmatched glob below with rc 1, which reads as "a
# violation"; dotglob makes `*` repeat the dot entries _scan_roots globs on
# its own, reporting each hit twice; nullglob and nocaseglob change what a
# glob returns; nocasematch makes every `case` below match any case. All five
# exist in bash 3.2 (failglob and nocasematch since 3.0 and 3.1).
shopt -u failglob dotglob nocaseglob nullglob nocasematch

cp_tmp=""  # the scratch dir, created below; _fatal_mark may run before
# _fatal_mark's last resort: a subshell that cannot leave its mark signals
# this shell instead, which exits 2 once the subshell it waits on is done.
# Only this script sends USR1 to itself.
trap 'exit 2' USR1

# --- terminal-safe report: ONE sanitizer every print path goes through --------
# The report echoes file NAMES and file CONTENT from the scanned tree, and
# either can carry terminal control sequences: OSC 52 writes the clipboard,
# CSI moves the cursor or clears the screen, a CR or BS overwrites what was
# already shown. _tty_safe rewrites them into a visible `\xHH`, per line:
#   - every C0 control (0x01-0x1F) but TAB and LF, and DEL (0x7F). TAB stays
#     raw: it only advances the cursor to the next tab stop, it cannot open
#     or carry a sequence, and the Makefile recipe lines the report quotes are
#     TAB-indented. LF is the record separator itself. NUL is DELETED first
#     (`tr -d`): no sed can name it portably in a pattern, and a shell string
#     cannot hold one, but _err_file's input (a tool's stderr) can.
#   - on a line that is NOT well-formed UTF-8, EVERY byte 0x80-0xFF. A stray
#     C1 byte (0x80-0x9F) is a control to an 8-bit terminal, and after an
#     invalid lead (E0 9B, FF 9B) or inside an overlong form (C0 9B, E0 82 9B)
#     it cannot be told from a continuation byte without decoding the whole
#     line, which is what the well-formedness test does (the RFC 3629 byte
#     grammar, as one ERE). The cost: a valid character on such a line prints
#     escaped too.
#   - on any line, the UTF-8 encoded C1 controls U+0080-U+009F (C2 80 - C2 9F),
#     which a UTF-8 terminal may honour as 8-bit controls (C2 9B is CSI).
# A well-formed line keeps every other character raw, so a name or a line
# in any script reads as itself. Residuals: a well-formed line still reaches
# an 8-bit (non-UTF-8) terminal with its continuation bytes, which such a
# terminal reads as C1 (the terminals this gate runs in - macOS Terminal,
# iTerm2, the CI log - are UTF-8); and printable characters that REORDER or
# hide text (the Unicode bidi overrides such as U+202E, zero-width ones) are
# not controls and pass as is.
# It changes only what is PRINTED: every arm decides on the raw data first,
# so no pass/fail outcome depends on it. One pass per line, every command a
# fixed `s///g` or the one well-formedness test: linear in the line length
# (an earlier re-run loop was quadratic, 39 s on a 32 KB line of 0x9B).
# One `s///` per byte, built once here with no fork (`printf -v`): sed cannot
# compute a byte's hex, and a byte range needs its own replacement. LC_ALL=C
# makes both GNU and BSD sed match single raw bytes, never decoded characters;
# BSD sed has no `\xHH` in a pattern, so each pattern holds the raw byte.
_tty_sed=()
_tty_byte() {  # $1 = byte value (decimal) -> the globals _tb (the byte), _th (hex)
  local oct
  printf -v oct '%03o' "$1"
  printf -v _th '%02x' "$1"
  # shellcheck disable=SC2059  # the format IS the octal escape that makes the byte
  printf -v _tb "\\$oct"
}
_tty_esc() {  # $1 = byte value (decimal); appends its escaping `s///g`
  _tty_byte "$1"
  _tty_sed+=(-e "s/$_tb/\\\\x$_th/g")
}
_tty_i=1
while [ "$_tty_i" -le 31 ]; do
  case "$_tty_i" in 9 | 10) ;; *) _tty_esc "$_tty_i" ;; esac
  _tty_i=$((_tty_i + 1))
done
_tty_esc 127
# The well-formed UTF-8 line, from its bytes. After the C0 pass above, the
# ASCII left on a line is TAB and 0x20-0x7E.
_tty_byte 128; _tty_x80="$_tb"; _tty_byte 143; _tty_x8f="$_tb"
_tty_byte 144; _tty_x90="$_tb"; _tty_byte 159; _tty_x9f="$_tb"
_tty_byte 160; _tty_xa0="$_tb"; _tty_byte 191; _tty_xbf="$_tb"
_tty_byte 194; _tty_xc2="$_tb"; _tty_byte 223; _tty_xdf="$_tb"
_tty_byte 224; _tty_xe0="$_tb"; _tty_byte 225; _tty_xe1="$_tb"
_tty_byte 236; _tty_xec="$_tb"; _tty_byte 237; _tty_xed="$_tb"
_tty_byte 238; _tty_xee="$_tb"; _tty_byte 239; _tty_xef="$_tb"
_tty_byte 240; _tty_xf0="$_tb"; _tty_byte 241; _tty_xf1="$_tb"
_tty_byte 243; _tty_xf3="$_tb"; _tty_byte 244; _tty_xf4="$_tb"
_tty_c="[$_tty_x80-$_tty_xbf]"
_tty_u8="[	 -~]|[$_tty_xc2-$_tty_xdf]$_tty_c"
_tty_u8="$_tty_u8|${_tty_xe0}[$_tty_xa0-$_tty_xbf]$_tty_c"
_tty_u8="$_tty_u8|[$_tty_xe1-$_tty_xec$_tty_xee$_tty_xef]$_tty_c$_tty_c"
_tty_u8="$_tty_u8|${_tty_xed}[$_tty_x80-$_tty_x9f]$_tty_c"
_tty_u8="$_tty_u8|${_tty_xf0}[$_tty_x90-$_tty_xbf]$_tty_c$_tty_c"
_tty_u8="$_tty_u8|[$_tty_xf1-$_tty_xf3]$_tty_c$_tty_c$_tty_c"
_tty_u8="$_tty_u8|${_tty_xf4}[$_tty_x80-$_tty_x8f]$_tty_c$_tty_c"
_tty_sed+=(-e "/^($_tty_u8)*\$/!{")
_tty_i=128
while [ "$_tty_i" -le 255 ]; do _tty_esc "$_tty_i"; _tty_i=$((_tty_i + 1)); done
_tty_sed+=(-e '}')
_tty_i=128
while [ "$_tty_i" -le 159 ]; do
  _tty_byte "$_tty_i"
  _tty_sed+=(-e "s/$_tty_xc2$_tb/\\\\xc2\\\\x$_th/g")
  _tty_i=$((_tty_i + 1))
done
unset _tty_i _tb _th
# _tty_safe - stdin -> stdout, control bytes escaped. The ONLY writer of the
# report: _err, _out and _err_file below are its callers. Every `>&2` in this
# file sits on one of those helper lines, and every `find` sends its stderr
# into a capture or a scratch file that _err_file prints, never straight to
# the terminal (tests/check_patterns_test.sh asserts both statically).
# A sanitizer that fails would drop the report while the exit code still said
# "clean" or "violation", so it fails CLOSED: exit 2 with a fixed message,
# plus a mark in the scratch dir, which the last line of this script reads,
# so the exit is 2 even when the failure happened inside a `$(...)`.
_tty_safe() { LC_ALL=C tr -d '\000' | LC_ALL=C sed -E "${_tty_sed[@]}"; }
# A mark that cannot be written (the scratch dir gone, the disk full) would
# let a fail-closed event inside a `$(...)` whose status the caller drops
# (arm 8's _gnu_scan returns 0 after its _code_hits pipeline) exit 0, so
# that failure is fatal too: a fixed message, USR1 to the main shell (the
# trap above), and exit 2 here. Before the scratch dir exists no `$(...)`
# has run a check, and every caller exits 2 on its own.
_fatal_mark() {
  [ -n "$cp_tmp" ] || return 0
  if ! : 2>/dev/null >"$cp_tmp/fatal"; then
    printf 'check-patterns: could not write the fail-closed mark - failing closed\n' >&2 || :
    kill -USR1 "$$" 2>/dev/null || :
    exit 2
  fi
}
_tty_fail() { printf 'check-patterns: the report sanitizer (tr | sed) failed - failing closed\n' >&2 || :; _fatal_mark; exit 2; }
_err() { printf '%s\n' "$@" | _tty_safe >&2 || _tty_fail; }        # each arg a stderr line
_out() { printf '%s\n' "$@" | _tty_safe || _tty_fail; }            # each arg a stdout line
_err_file() { _tty_safe <"$1" >&2 || _tty_fail; }                  # a file's bytes to stderr

# An UNCHECKED failure - a command failing where `set -e` would stop the
# script - exits 2, a scan error, never the command's own status: a failing
# sed or sort exits 1, which reads as "a violation" and comes with no report.
# `set -E` carries the trap into functions, where most of the work runs. It
# acts in the main shell only (BASH_SUBSHELL 0): bash 3.2 fires ERR in a
# `$(...)` even when the caller checks the status (`x=$(cmd) || rc=$?`), so
# exiting there would fail a checked call closed (measured on bash 3.2.57:
# without this guard a clean tree exits 2). A subshell's failure surfaces
# as its status in the main shell instead, where the caller checks it or
# this trap fires. Everything above this line is shell builtins and
# function definitions, so nothing there can fail before the trap exists.
# The _err inside cannot re-enter it: bash does not run the ERR trap while
# the trap itself runs.
# RESIDUAL: a `$(...)` does not inherit `set -e` (no inherit_errexit here;
# a `( )` subshell does), so a failure there that is not its last command
# is not seen at all: `v=$(false; echo after)` sets v and succeeds. The
# `$(...)` bodies in this file end in the command whose status matters, or
# check the ones before it by hand, with one deliberate exception:
# _gnu_scan ends in `return 0` after its _code_hits pipeline, whose errors
# the fatal mark carries instead.
_unchecked() {  # $1 = the failed command's status, $2 = its line
  [ "${BASH_SUBSHELL:-0}" -eq 0 ] || return 0
  _err "check-patterns: a command failed where the gate does not check its status (exit $1, line $2) - failing closed"
  exit 2
}
set -E
trap '_unchecked "$?" "$LINENO"' ERR

# The scratch dir every pass shares (find's stderr, the NUL pass's list, the
# fatal mark). No mktemp means no fail-closed evidence can be kept: exit 2.
cp_tmp=$(mktemp -d "${TMPDIR:-/tmp}/check-patterns.XXXXXX" 2>/dev/null) || {
  _err "check-patterns: could not create a scratch dir - failing closed"
  exit 2
}
# `|| :`: a scratch dir that cannot be removed is not a scan result, and
# without it the ERR trap would turn the 0 or 1 already decided into 2.
trap 'rm -rf "$cp_tmp" || :' EXIT

root="${1:-.}"
# A relative ROOT starting with `-` reaches every tool as "$root/..." in
# operand position, where find (paths come before its `--`-less expression)
# and arm 3's grep (GNU permutes argv) read it as an option. `./` in front
# makes it a path everywhere and names the same directory.
case "$root" in -*) root="./$root" ;; esac
# A `:`, LF or CR in the ROOT's path breaks the PATH:NN: split every arm
# reads, the same way arm 12's file-name rule describes: measured, a real
# `chmod -R go-w --` under '/tmp/r:1: #' passed. No arm result stands, so this
# fails closed before any runs. Bash 3.2 reads `$'...'` in a case pattern.
case "$root" in
  *:* | *$'\n'* | *$'\r'*)
    printf -v _root_q '%q' "$root"
    _err "check-patterns: the scan root $_root_q holds a \":\", a newline or a CR - every arm reads a hit as PATH:NN:, so such a path can hide a violation; scan it through a path without one"
    exit 2 ;;
esac

# _scan_roots P... -> the global `roots`: "$root/P" for each P that exists,
# except that a real, listable directory "$root/zsh" is replaced by its own
# entries minus the pinned "$root/zsh/plugins". EVERY recursive arm takes its
# roots from here, and this is the ONE place the pinned plugins leave their
# scan. It cannot be a grep flag: GNU and BSD grep both match --exclude-dir
# against a BASE NAME at any depth, never a path, so `--exclude-dir=plugins`
# also hid first-party trees such as config/nvim/lua/plugins/ and
# lib/plugins/ (a curl piped into sh there passed).
#   - A symlinked (or non-directory) zsh stays a root as is: expanding
#     through a symlinked zsh would hand arm (12)'s find paths below the
#     link without the link itself.
#   - A zsh that is not both readable and searchable stays a root as is too:
#     its glob would come back empty and the scan would pass, where grep and
#     find on the directory itself error and fail closed.
#   - A SYMLINK entry of zsh (zsh/plugins included) goes to the global
#     `zsh_links`, never to `roots`: as a grep OPERAND, GNU grep -r follows
#     it (into the pinned plugins, or out of the surface) and a dangling one
#     errors, while BSD grep does not. Arm (12)'s find reads `zsh_links` and
#     reports each one, as it does any symlink met while walking.
#   - A zsh/plugins that is not a directory (a plain file) is scanned.
# -e alone misses a DANGLING symlink (it stats the target, not the link
# itself), silently dropping the entry from every arm below; -L catches it.
# `$root` is quoted in the globs, so its own glob characters stay literal.
_scan_roots() {
  roots=()
  zsh_links=()
  local p e
  for p in "$@"; do
    if [ "$p" = zsh ] && [ -d "$root/zsh" ] && [ ! -L "$root/zsh" ] \
        && [ -r "$root/zsh" ] && [ -x "$root/zsh" ]; then
      # `.[!.]*` and `..?*` add the dot entries `*` skips, never `.` or `..`.
      for e in "$root"/zsh/* "$root"/zsh/.[!.]* "$root"/zsh/..?*; do
        if [ -L "$e" ]; then
          zsh_links+=("$e")
          continue
        fi
        [ -e "$e" ] || continue  # an unmatched glob stays literal
        [ "$e" = "$root/zsh/plugins" ] && [ -d "$e" ] && continue
        roots+=("$e")
      done
    elif [ -e "$root/$p" ] || [ -L "$root/$p" ]; then
      roots+=("$root/$p")
    fi
  done
}

# Our own implementing surface, shared by arms 2, 5 and 6 (arm 1 widens it
# below, arms 7-12 build their own). The Makefile is not on it (its comments
# state the rules and spell arm 2's literal), and the self-exclude on each
# recursive grep below skips THIS script, which spells the forbidden literals
# in its patterns and docs; arms 1, 2 and 11 re-read it through a narrow
# self-scan instead. `home/` is optional - absent = skipped, not an
# error (that omission is the whole bug this tool fixes). A tree whose only
# content is the pinned zsh/plugins, or symlinks under zsh/, is a no-op scan
# too - and a recursive grep given NO operand would read the cwd or stdin.
_scan_roots install.sh lib bin zsh config packages security home
scan=(${roots[@]+"${roots[@]}"})
scan_links=(${zsh_links[@]+"${zsh_links[@]}"})
if [ "${#scan[@]}" -eq 0 ]; then
  _err "check-patterns: no scan paths exist under '$root' - refusing to pass a no-op scan"
  exit 2
fi

bad=0
# fatal=1: a scan ERROR (a tool failed, a name no arm can read): exit 2, not 1,
# so a caller can tell "the gate could not look" from "it found a violation".
fatal=0

# NARROW SELF-SCAN target: exactly this file, which every recursive arm skips
# by base name (--exclude=check-patterns). Arms 1, 2 and 11 grep it again on
# their own, non-recursively, so tests/plugins_test.sh's recursive-grep
# invariant does not count those calls and they need no self-exclude. Absent
# (a fixture tree without bin/check-patterns) is a silent skip, like every
# optional path.
self_cp="$root/bin/check-patterns"
# _self_scan RC OUT GREP_ARGS... - fold the self-scan of $self_cp into one
# arm's recursive result: sets the globals `rc` (2 if EITHER grep errored, so
# the arm fails closed; else 0 if either matched; else 1) and `out` (both
# outputs, recursive first). GREP_ARGS are the arm's options and patterns,
# never -r.
_self_scan() {
  local src=0 sout="" lf=$'\n'
  rc="$1"; out="$2"; shift 2
  [ -f "$self_cp" ] || return 0
  sout=$(grep "$@" -- "$self_cp" 2>&1) || src=$?
  [ -z "$sout" ] || out="${out:+$out$lf}$sout"
  if [ "$rc" -ge 2 ] || [ "$src" -ge 2 ]; then
    rc=2
  elif [ "$rc" -eq 0 ] || [ "$src" -eq 0 ]; then
    rc=0
  else
    rc=1
  fi
}
# The literals arms 1 and 2 forbid, as their messages print them. Assembled
# from pieces, as the em dash of arm 11 is, so that the self-scans find
# nothing in this file: there is NO exemption list, and any line that spells
# either shape - code, string or comment - fails the gate. That is why the
# prose in this file writes them as "a curl piped into sh" and "uname with -m".
bar='|'
lit_fetch="curl${bar}sh"
lit_uname="uname"' -m'

# --- code/comment split, used by arms (5)-(10), (13) and (14) ---------------
# The comments that STATE these constraints necessarily spell the forbidden
# literals - install.sh's own "no associative arrays, no mapfile, no ${var,,}"
# header, and every `# never hardcode /opt/homebrew` a reader deserves beside the
# line it explains. CLAUDE.md REQUIRES those comments, so a gate that flagged
# them would forbid the repo from documenting its own rules. These arms therefore
# test CODE, not the raw line. Arms (1) and (2) deliberately do NOT: a curl piped
# into sh, or a uname with -m, spelled anywhere is still a pattern we want out of the tree.
#
# _code_of splits one `PATH:NN:CONTENT` hit and returns CONTENT with its comment
# tail removed. A comment starts at a `#` that opens the line OR follows one of the
# characters that end a word for the shell - whitespace and the metacharacters
# `; & | ( )` - so `x=1;# note` is a comment too, and an earlier version that only
# knew about whitespace both missed a dodge and flagged a legitimate comment.
# `[^:]*` never crosses a colon, so the prefix strip lands on PATH:NN: exactly.
# PATH holds no `:`: a root holding one fails closed at the top, and a file
# NAME holding one fails closed in arm 12. PREMISE: a `#` INSIDE a quoted string
# truncates the line early, which can cut a real violation (false negative) or cut
# the `/usr/local` half of arm 5's exempting pair (false positive). Both need a `#`
# inside a string on a line that also carries one of these patterns.
_code_of() {  # $1 = one "PATH:NN:CONTENT" hit -> its CODE on stdout
  printf '%s' "$1" | sed -E -e 's/^[^:]*:[0-9]+://' -e 's/(^|[[:space:];&|()])#.*$/\1/'
}

# _code_hits MATCH_ERE [EXEMPT_ERE] - read hits on stdin, re-test each hit's CODE,
# and print back the hits that still match MATCH_ERE and do not match EXEMPT_ERE.
# Both EREs see the CODE ALONE, never the PATH:NN: prefix: testing the whole line
# would let a scan ROOT whose own path contains the exempt text disable the arm
# for the entire tree, which is the fail-OPEN shape this tool exists to refuse.
# FAILS CLOSED on a broken ERE: a grep exit >= 2 is not "no match". An unusable
# pattern reports every hit instead of silently disabling the arm, and an unusable
# EXEMPT pattern exempts nothing. It runs inside the caller's `$(...)`, and
# returns 0 either way: the fatal mark carries the error out (arm 8's
# _gnu_scan drops the pipeline's status; for arms 5-7, 9, 10, 13 and 14 a subshell
# that exits 2 on its own also fails the `viol=$(...)`, which the ERR trap
# turns into 2).
# Each re-test is `printf | grep -c`, never a here-string: bash 3.2 backs
# `<<<` with a temp file (in TMPDIR, else /tmp), and one that cannot be
# created (a full or unwritable /tmp) makes the command return 1 without
# running it, which would read as "no match" and drop the hit (reasoned from
# bash's redirection rules; a failing /tmp was not staged). A
# re-test stands only as a count grep printed: 0 with rc 1 is "no match", a
# positive count with rc 0 a match, anything else an error. `-c` reads its
# whole input, so the pipe has no early-exit reader (arm 9).
# FAILS CLOSED the same way when _code_of itself fails: its empty answer would
# otherwise read as "a comment-only line" and drop the hit (measured: a sed
# failing only there passed `P=/opt/homebrew` with exit 0 and no output).
# _retest ERE TEXT -> the global rc: 0 TEXT matches, 1 it does not, 2 or
# more an error (grep's own, or a count that is not grep's answer: empty,
# not all digits, or not agreeing with the status). A non-numeric count
# such as `1x` read as a match would EXEMPT the hit on the exemption
# re-test, so it is checked first.
_retest() {
  local n
  rc=0
  n=$(printf '%s\n' "$2" | grep -cE -- "$1") || rc=$?
  case "$rc:$n" in
    *: | *:*[!0-9]*) rc=2 ;;
    0:[1-9]*) rc=0 ;;
    1:0) rc=1 ;;
    0:* | 1:*) rc=2 ;;
  esac
}
_code_hits() {
  local match="$1" exempt="${2:-}" hit code rc
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    rc=0; code="$(_code_of "$hit")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      _err "check-patterns: the code/comment split (sed) errored (exit $rc) on a hit - failing closed"
      _fatal_mark
      printf '%s\n' "$hit"; continue
    fi
    [ -n "$code" ] || continue
    _retest "$match" "$code"
    if [ "$rc" -ge 2 ]; then
      _err "check-patterns: code re-test errored (exit $rc) on '$match' - failing closed"
      _fatal_mark
      printf '%s\n' "$hit"; continue
    fi
    [ "$rc" -eq 0 ] || continue
    if [ -n "$exempt" ]; then
      _retest "$exempt" "$code"
      if [ "$rc" -ge 2 ]; then
        _err "check-patterns: exemption re-test errored (exit $rc) on '$exempt' - exempting nothing"
        _fatal_mark
      elif [ "$rc" -eq 0 ]; then
        continue
      fi
    fi
    printf '%s\n' "$hit"
  done
  return 0
}

# _drop_hits HITS ERE LABEL - HITS (lines) minus the lines matching ERE, on
# stdout: the path exemptions of arms 2, 5, 11 and 13. grep -v exits 1 when it
# drops every line, a legitimate answer, so 0 and 1 both stand; 2 or more is
# an error, and a filter that cannot run exempts NOTHING: HITS print whole,
# the error is reported, and the fatal mark carries the exit 2 out of the
# caller's `$(...)` (the earlier `grep -v ... || true` read an error as
# "every hit exempted" and passed the violation with exit 0). grep's stderr
# goes to a scratch file printed through the sanitizer, since ERE holds the
# caller-supplied root. That redirect is on a group that records whether
# grep RAN: when the file cannot be opened (the scratch dir gone, the disk
# or quota full, no free descriptor) bash skips the command and returns 1,
# grep's own "every line dropped" (measured: a directory in its place
# passed violations in arms 2, 5 and 11 with exit 0). The hits go in
# through a pipe, not a here-string, for the reason _code_hits gives.
_drop_hits() {
  local rc=0 ran=0
  [ -n "$1" ] || return 0
  { ran=1; printf '%s\n' "$1" | grep -vE -- "$2" || rc=$?; } 2>"$cp_tmp/drop.err" || :
  [ "$ran" -eq 1 ] || rc=2
  if [ "$rc" -ge 2 ]; then
    if [ -f "$cp_tmp/drop.err" ]; then
      _err_file "$cp_tmp/drop.err"
    fi
    _err "check-patterns: the $3 exemption filter (grep -v) errored (exit $rc) - failing closed"
    _fatal_mark
    printf '%s\n' "$1"
  fi
  return 0
}

# (1) forbid a curl / wget runtime fetch that EXECUTES the downloaded text on
# the same line. W below is curl or wget, optionally written with a path
# (`/usr/bin/curl`) or behind `command `, `env `, `sudo [options] ` or `\`.
# SHELL is sh, bash, zsh, ksh or dash, optionally quoted, with a path
# (`/bin/bash`), and behind any of `sudo [options] `, `env `, `command `,
# `exec `. Covered shapes:
#   * a pipe into a shell:  W ... | SHELL,  W ... |& bash,  W ... | sudo -E bash
#   * command substitution given to eval (also `eval --`), or to a SHELL whose
#     options include a c flag, as a cluster (-c, -lc, -ec) or apart from other
#     options (-l -c, --norc -c, -c --), with spaces allowed inside the quote:
#     eval "$(W ...)", bash -lc "$(W ...)", sh -c "  $(W ...)", sh -c `W ...`
#   * process substitution sourced, dotted or run, directly or redirected:
#     source <(W ...), . <(W ...), bash <(sudo W ...), bash < <(W ...)
# NOT covered, among others (a line-oriented grep cannot follow them all, so
# this list is illustrative, not exhaustive): a download saved to a file or
# variable and executed on a LATER line; one passed through another command
# first (`W ... | tee f | bash`); one fed through a here-string or /dev/stdin
# (`source /dev/stdin <<< "$(W ...)"`); W behind an assignment, `time` or a
# brace group inside the substitution (`eval "$(VAR=x W ...)"`,
# `bash -c "$(time W ...)"`, `bash -c "$({ W ...; })"`); a substitution that
# is not the start of the -c string (`sh -c "set -e; $(W ...)"`); a fetch
# through an alias or function; a shell reached through xargs or nohup; and
# fetch tools other than curl and wget.
# Capturing output into a variable (x="$(curl ...)") is not execution and is
# not flagged. The leading class keeps `eval`/`source`/`.` from matching inside
# a longer word (`medieval`, `file.sh`), and the trailing class keeps `sh` from
# matching `shasum`.
# rc 0 = match (violation); rc 1 = clean; rc >= 2 = scan error (fail closed).
# `-r`, NOT `-R`: -R follows symlinks, and a first-party link pointing into a
# third-party tree would drag the scan straight back into the pinned zsh/plugins
# that _scan_roots left out of `scan`. No `--exclude-dir`: it matches a base name
# at any depth, which would hide a FIRST-PARTY `plugins` directory as well.
sudo_='sudo([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]][^[:space:]]*)?)*'
fetcher="((command|env|$sudo_)[[:space:]]+|\\\\)?([^[:space:]\"'\`()\$]*/)?(curl|wget)"
runner="(($sudo_|env|command|exec)[[:space:]]+)*[\"']?([^[:space:]|;&\"']*/)?(sh|bash|zsh|ksh|dash)[\"']?"
opt='[[:space:]]+-[^[:space:]"'"'"'`$]*'
fetch_pipe="(curl|wget)[^|]*\\|&?[[:space:]]*$runner([^[:alnum:]_.-]|\$)"
fetch_subst="(^|[^[:alnum:]_.-])(eval([[:space:]]+--)?|$runner($opt)*[[:space:]]+-[[:alnum:]]*c[[:alnum:]]*($opt)*)[[:space:]]+[\"']?[[:space:]]*(\\\$\\(|\`)[[:space:]]*$fetcher"
fetch_procsub="(^|[^[:alnum:]_.-])(source|\\.|$runner)[[:space:]]+(<[[:space:]]*)?<\\([[:space:]]*$fetcher"
# SURFACE: the shared `scan` roots plus the Makefile and the whole .github/ -
# a recipe line, a workflow `run:` step and a composite action's step
# execute on every CI leg exactly as a line in lib/ does. tests/, docs/ and .claude/ stay OUT: tests/ plants
# real fetch shapes as fixtures, and docs/ and .claude/ are prose that names
# them. tests/check_patterns_test.sh's surface-coverage section derives this
# from the gate's own grep calls. Plus the narrow self-scan of this file.
_scan_roots install.sh lib bin zsh config packages security home Makefile .github
fetch_scan=(${roots[@]+"${roots[@]}"})
rc=0
out=$(grep -rHnaE --exclude=check-patterns \
  -e "$fetch_pipe" -e "$fetch_subst" -e "$fetch_procsub" -- "${fetch_scan[@]}" 2>&1) || rc=$?
_self_scan "$rc" "$out" -HnaE -e "$fetch_pipe" -e "$fetch_subst" -e "$fetch_procsub"
if [ "$rc" -eq 0 ]; then
  _out "$out"
  _err "check-patterns: forbidden $lit_fetch runtime fetch"
  bad=1
elif [ "$rc" -ge 2 ]; then
  _err "$out" \
    "check-patterns: $lit_fetch scan errored (exit $rc) - failing closed"
  bad=1; fatal=1
fi

# (2) forbid an ad-hoc uname with -m outside lib/os.sh (its sanctioned home). The grep
# prints paths as "<root>/lib/os.sh:...", so anchor the allow-line on the tail.
# The pattern's one space is written as the class `[ ]`, the same match, so
# the pattern line does not spell the literal it looks for (see lit_uname).
rc=0
out=$(grep -rHna --exclude=check-patterns -e 'uname[ ]-m' -- "${scan[@]}" 2>&1) || rc=$?
_self_scan "$rc" "$out" -Hna -e 'uname[ ]-m'
if [ "$rc" -eq 0 ]; then
  viol=$(_drop_hits "$out" '(^|/)lib/os\.sh:' "lib/os.sh")
  if [ -n "$viol" ]; then
    _err "$viol" \
      "check-patterns: ad-hoc '$lit_uname' outside lib/os.sh - use is-arm64/is-amd64"
    bad=1
  fi
elif [ "$rc" -ge 2 ]; then
  _err "$out" \
    "check-patterns: uname scan errored (exit $rc) - failing closed"
  bad=1; fatal=1
fi

# (3) forbid an UNESCAPED `#` inside a Makefile `$(shell ...)` / `${shell ...}`. macOS's system
# make (3.81) treats a bare `#` in a function argument as a comment, truncating the call
# ("unterminated call to function shell") - a real macos-intel CI failure that GNU make 4.x on
# Linux tolerates. The `#` MUST be escaped `\#` (make strips the backslash; the shell still
# receives `#`). The regex flags an unescaped `#` before the call's first closing `)`/`}`; an
# escaped `\#`, and a trailing `# comment` after the close (glued `)#` or spaced), are NOT
# flagged. HEURISTIC, not a make parser - it does NOT catch a `#` that sits after a NESTED
# `$(...)`'s `)`, nor one on a `\`-continued physical line (grep cannot paren-balance or join
# lines); the macOS CI leg's real make 3.81 is the backstop for those. The repo's only
# `$(shell)` (Makefile:20) is single-line, non-nested, and `\#`-escaped. Targeted at the
# Makefile, which is absent from the shared `scan` surface above.
mk="$root/Makefile"
if [ -f "$mk" ]; then
  if out=$(grep -nE '\$[({]shell[^)}]*[^\\)}]#' "$mk" 2>&1); then
    _err "$out" \
      "check-patterns: unescaped '#' inside a Makefile \$(shell ...)/\${shell ...} - macOS make 3.81 reads it as a comment; escape it as '\\#'"
    bad=1
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: Makefile \$(shell ...) scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (4) re-verify the pinned zsh-plugin startup fork the shim below neutralizes is STILL
# PRESENT, so a submodule pin bump re-checks the shim's premise instead of silently regressing.
# The forkgate measures EXECS, not the semantic shape a bump could change:
# fast-syntax-highlighting.plugin.zsh forks `$(uname -a)` at source time, answered by the zshrc
# `uname` function shim. If a bump removed or reshaped it, the shim would stop covering the real
# fork with no gate to notice, regressing the fork-free startup path. It is the only shim
# premise: the prompt (starship) and zoxide are cached at install time and fork nothing at
# startup, so they have no shape to re-verify here. This file lives
# in a SHA-pinned submodule EXCLUDED from the shared scan above, so reference it by explicit
# path; a present-but-missing shape fails closed, while an ABSENT file (uninitialized submodule)
# is a loud skip, STRICT-escalated.
# grep's stderr is captured and printed through the sanitizer: an error names
# the file. An absent file under STRICT=1 is a check that could not run, a
# scan error (exit 2) like any other, not a violation.
_shim_shape() {  # $1=file  $2=fixed-string shape  $3=human description
  local sout src=0
  if [ -r "$1" ]; then
    sout=$(grep -qF -- "$2" "$1" 2>&1) || src=$?
    if [ "$src" -ge 2 ]; then
      _err "$sout" \
        "check-patterns: $3 - reading ${1#"$root"/} errored (exit $src) - failing closed"
      bad=1; fatal=1
    elif [ "$src" -eq 1 ]; then
      _err "check-patterns: $3 - the pinned '$2' shape is GONE from ${1#"$root"/}; a submodule bump changed the shim's premise (re-verify the shim)"
      bad=1
    fi
  elif [ -n "${STRICT:-}" ]; then
    _err "check-patterns: cannot verify $3 - ${1#"$root"/} absent (uninitialized submodule) and STRICT=1 - init submodules"
    bad=1; fatal=1
  else
    _err "check-patterns: SKIP $3 - ${1#"$root"/} absent (uninitialized submodule); set STRICT=1 to fail closed"
  fi
}
# shellcheck disable=SC2016  # the shapes are FIXED-STRING grep patterns: they MUST stay literal, not expand
_shim_shape "$root/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" '$(uname -a)' "f-sy-h uname probe (pinned-plugin shim premise)"

# _re_escape LITERAL -> LITERAL's ERE-escaped form on stdout, used by the
# exact-path exemptions below: `$root` is caller-supplied, not a literal this
# file controls, so it cannot be assumed free of ERE metacharacters. A `sed`
# bracket-expression class, not bash `${s//pat/repl}` substitution: a `}` in
# the REPLACEMENT half of that form closes the `${...}` construct itself,
# leaving a stray literal `}` in the result. `]` must be first in the class to
# read as literal instead of closing it, and `^` must not be first, to the
# same end; `\` needs no doubling, since a bracket expression is not an escape
# context.
_re_escape() {
  printf '%s' "$1" | sed -e 's/[].[(){}^$*+?|\]/\\&/g'
}

# (5) forbid a LONE `/opt/homebrew`. The prefix is /opt/homebrew on Apple Silicon and
# /usr/local on Intel, and it MUST be resolved by directory existence - a hardcoded
# arm64 prefix passes every gate on the Apple Silicon mac and breaks the Intel one
# silently, which is exactly the failure no local run can surface. The ARM64/INTEL
# PAIR ON ONE LINE is what distinguishes detection from a hardcode, so that is what
# the gate looks for: naming /opt/homebrew obliges you to name /usr/local beside it
# (zsh/zshrc's prefix loop and zsh/fzf.zsh's candidate list both already read that
# way). The check is deliberately ASYMMETRIC: /usr/local ALONE is never flagged,
# because it is a generic FHS path with non-Homebrew uses (zsh/zshenv's
# /usr/local/go/bin), while /opt/homebrew can only ever mean Homebrew.
# The pair must be two ADJACENT WORDS, which is what a candidate list or a detection
# loop looks like (`for prefix in /opt/homebrew /usr/local`). Anything looser exempts
# by coincidence: `PATH="/opt/homebrew/bin:/usr/local/bin"` names both inside ONE word
# and is an unconditional hardcode, and `[ -d /usr/local/go ] && P=/opt/homebrew` names
# both on one line while the /usr/local is about Go. The comment tail is removed before
# the test, so `=/opt/homebrew  # /usr/local on Intel` buys no exemption either.
# ALLOWLIST: config/gnupg/gpg-agent.conf, matched on the PATH field alone. gpg-agent.conf
# has no include directive and no variable expansion, so its pinentry path MUST be
# absolute and cannot be prefix-detected; that file's own header records how the Intel
# mac overrides it. Anchored to the EXACT path this scan reads it at (`$root/config/
# gnupg/gpg-agent.conf`, `_re_escape`d), never a substring or a bare suffix: either
# would exempt a decoy file elsewhere ending in the same segments (e.g.
# tests/config/gnupg/gpg-agent.conf) too - fail OPEN.
_gpg_agent_path=$(_re_escape "$root/config/gnupg/gpg-agent.conf")
if out=$(grep -rna --exclude=check-patterns \
    -F '/opt/homebrew' "${scan[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" \
    | _code_hits '/opt/homebrew' '(/opt/homebrew[^[:space:]]*[[:space:]]+/usr/local|/usr/local[^[:space:]]*[[:space:]]+/opt/homebrew)')
  viol=$(_drop_hits "$viol" "^${_gpg_agent_path}:[0-9]+:" "gpg-agent.conf")
  if [ -n "$viol" ]; then
    _err "$viol" \
      "check-patterns: hardcoded Homebrew prefix - '/opt/homebrew' with no '/usr/local' as the ADJACENT word; resolve the prefix by directory existence, and keep the arm64/Intel pair on one line"
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    _err "$out" \
      "check-patterns: Homebrew-prefix scan errored (exit $rc) - failing closed"
    bad=1; fatal=1
  fi
fi

# (6) forbid asking `brew` where IT lives - the other half of the same rule, and the
# form an internet snippet supplies. BOTH spellings: `brew shellenv` and a BARE
# `brew --prefix`. It is a FORK, so on the zsh startup path it also costs a subprocess
# on every prompt (make forkgate catches it there; this catches it in install.sh and
# lib/ too, where no forkgate runs). `--prefix` must END the word: `brew --prefix
# openssl@3` asks where a FORMULA lives, which is a different question this rule has
# no answer for, and flagging it would offer a remedy that does not apply. Every other
# brew call is untouched - lib/packages.sh's `brew bundle` is how packages install.
if out=$(grep -rna --exclude=check-patterns \
    -E 'brew[[:space:]]+(shellenv|--prefix([[:space:]]*$|[[:space:]]*[^[:alnum:][:space:]_./@-]))' "${scan[@]}" 2>&1); then
  viol=$(printf '%s\n' "$out" | _code_hits 'brew[[:space:]]+(shellenv|--prefix([[:space:]]*$|[[:space:]]*[^[:alnum:][:space:]_./@-]))')
  if [ -n "$viol" ]; then
    _err "$viol" \
      "check-patterns: a 'brew shellenv' / 'brew --prefix' fork - resolve the Homebrew prefix by directory existence instead"
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    _err "$out" \
      "check-patterns: brew-shellenv scan errored (exit $rc) - failing closed"
    bad=1; fatal=1
  fi
fi

# (7) forbid bash 4 syntax in the bash-3.2 surface. macOS ships /bin/bash 3.2 and the
# installer runs under it. `make lint` parses this surface with the ABSOLUTE /bin/bash,
# but that pass is not a backstop for these three: `declare -A` and `mapfile` are
# ordinary command invocations and `${var,,}` fails at EXPANSION, so no bash of any
# version reports a parse error for them. The break would first appear at runtime on a
# real mac. This arm is their only gate, and it runs on every host.
# SURFACE: install.sh + lib/*.sh, the same subset as the Makefile's BASH32_FILES -
# bin/ is EXEMPT (its tools run only on a provisioned host or a CI runner). An absent
# file is skipped, not an error, the way `home/` is above. `-H` forces the PATH: prefix
# even for a single file, which _code_of's split depends on. The parameter class covers
# POSITIONALS, `@`/`*` and the `!` indirection, not just names: `${1,,}` on a function
# argument is the most idiomatic use of the construct and so the likeliest slip.
b32=()
[ -f "$root/install.sh" ] && b32+=("$root/install.sh")
for f in "$root"/lib/*.sh; do
  [ -f "$f" ] && b32+=("$f")
done
if [ "${#b32[@]}" -gt 0 ]; then
  b4='(declare|typeset|local)[[:space:]]+-[A-Za-z]*A'
  b4="$b4"'|(^|[^[:alnum:]_])(mapfile|readarray)([^[:alnum:]_]|$)'
  b4="$b4"'|\$\{!?([A-Za-z_][A-Za-z0-9_]*|[0-9][0-9]*|[@*])(\[[^]]*\])?(,|\^)'
  if out=$(grep -HnE "$b4" "${b32[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$b4")
    if [ -n "$viol" ]; then
      _err "$viol" \
        "check-patterns: bash 4 syntax in the bash-3.2 surface (install.sh, lib/) - no associative arrays, no mapfile/readarray, no \${var,,}"
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: bash-3.2 scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (8) forbid GNU-only regex escapes in the shell surface. BSD sed and grep (macOS)
# implement POSIX regex, where GNU's `\s \S \w \W \b \B \< \>` shorthands and its BRE
# `\| \+ \?` operators are undefined: on a mac the pattern silently means something
# else (a literal `s`, a literal `|`), so a substitution never matches and a guard
# never fires, with no error. Linux runs the GNU tools, so no Linux run of any gate
# sees the break. This arm is its static gate; the fix is always a POSIX class
# (`[[:space:]]`, `[[:alnum:]_]`, `(^|[^[:alnum:]_])`) or the ERE operator under -E.
# SURFACE: every file whose commands run on a mac - install.sh, lib/, bin/, zsh/,
# tests/, the Makefile and the workflows (the macOS runner executes their `run:`
# steps). config/ is NOT scanned: it holds editor configs whose own regex dialects
# (vim's `\s`) are legitimate. Pinned plugins are upstream's code, left out by
# their exact path (_scan_roots), and this script excludes itself by name -
# NEITHER is a language exemption, both are content-independent path
# exclusions of THIRD-PARTY or SELF-REFERENTIAL text.
# `*.py` FILES UNDER tests/ ONLY ARE EXEMPT BY EXTENSION - the only
# content-independent LANGUAGE exemption this arm has, and a fixed suffix,
# never a marker comment or a parse of what is inside the file: Python's `re`
# module is not the shell's regex dialect, GNU-style escapes are portable
# there, so non-shell code that needs one lives in its own `.py` file under
# tests/, never a heredoc embedded in a `.sh` script (a heredoc is still
# shell-surface text to this arm - it has no notion of an embedded language).
# The exemption stops at tests/: bin/, lib/, zsh/, install.sh, the Makefile and
# the workflows are still fully scanned, because lib/link.sh's _link_bin_tree
# links every bin/* file onto the live PATH by basename - a `bin/foo.py`
# holding a shell-adjacent GNU-only regex would run on a mac unscanned if this
# arm exempted it too. tests/ has no such path: nothing there is linked or run
# except through a `*_test.sh` harness, which stays fully scanned.
# TWO SHAPES, both tested on CODE only (the comment that explains the rule spells it):
#   - a shorthand class anywhere in code. It is NOT tied to a sed/grep call word,
#     because a gate's pattern often sits on a continuation line or in a variable
#     (bin/secret-scan's patterns do both); nothing in the surface uses these escapes
#     outside a regex. A `\\` before it is a literal backslash, not the escape.
#   - a BRE operator inside the first quoted argument of a sed/grep call whose flags
#     carry no -E/-r/-P. Under -E, `\|` is an ESCAPED literal bar and is portable.
# PREMISE: a flag group before the pattern is short options only (`-qi`, `-e`); a
# long option (`--posix`) in front of a BRE pattern hides it from the second shape.
_scan_roots install.sh lib bin zsh Makefile .github/workflows
gnu_rest=(${roots[@]+"${roots[@]}"})
_scan_roots tests
gnu_tests=(${roots[@]+"${roots[@]}"})
if [ "${#gnu_rest[@]}" -gt 0 ] || [ "${#gnu_tests[@]}" -gt 0 ]; then
  gnu_esc='(^|[^\\])\\[sSwWbB<>]'
  # The argument body excludes only its OWN closing quote: a `"` inside a
  # single-quoted pattern (or a `'` inside a double-quoted one) is pattern text.
  q="'"
  gnu_bre='(^|[^[:alnum:]_-])(grep|sed)([[:space:]]+-[A-DF-OQ-Za-qs-z]+)*[[:space:]]+'
  gnu_bre="$gnu_bre($q([^$q]*[^\\\\$q])?|\"([^\"]*[^\\\\\"])?)"'\\[|+?]'
  gnu_re="$gnu_esc|$gnu_bre"
  gnu_msg='check-patterns: a GNU-only regex escape - BSD sed/grep on macOS read \s \w \b \< \> and BRE \| \+ \? as something else; use a POSIX class ([[:space:]], [[:alnum:]_]) or the ERE operator under -E'
  # _gnu_scan PY_EXCLUDE ROOT... - one shared grep pass for this arm. PY_EXCLUDE
  # is the literal `*.py` glob for the tests/ call, or "" for every other root
  # (bin/, lib/, zsh/, install.sh, Makefile, workflows) - the `*.py` exemption
  # is tests/-ONLY, never a blanket one, because lib/link.sh's _link_bin_tree
  # links every bin/* file onto the live PATH by basename. On success (0),
  # prints hits already re-tested by _code_hits. On a scan error (2), prints
  # the RAW grep output for the CALLER to report - never a diagnostic of its
  # own, so a call site that stops reading this function's result also loses
  # the message (see _gnu_fail below, which couples that message to `bad=1`
  # as one call).
  # `out=$(...)` stays the DIRECT condition of the `if`, never a statement
  # inside its body, so a clean pass (grep exit 1, no match) does not trip
  # `set -e`.
  _gnu_scan() {
    local py="$1"; shift
    [ "$#" -gt 0 ] || return 1
    local -a exc=(--exclude=check-patterns)
    [ -n "$py" ] && exc+=(--exclude="$py")
    local out rc
    if out=$(grep -rHnaE "${exc[@]}" -- "$gnu_re" "$@" 2>&1); then
      printf '%s\n' "$out" | _code_hits "$gnu_re"
      return 0
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        printf '%s\n' "$out"
        return 2
      fi
      return 1
    fi
  }
  # _gnu_fail MSG - print MSG and set bad=1 (and fatal=1) as one call. A call site that
  # stops calling _gnu_fail loses its pass-specific message, which the two
  # arm-8 fixtures in tests/check_patterns_test.sh catch. That is the only
  # guarantee this gives: an inline reimplementation that keeps the printf
  # but drops `bad=1` is NOT caught by those fixtures.
  _gnu_fail() {
    _err "$1"
    bad=1; fatal=1
  }
  gnu_viol=""
  if [ "${#gnu_rest[@]}" -gt 0 ]; then
    if out=$(_gnu_scan "" "${gnu_rest[@]}"); then
      [ -n "$out" ] && gnu_viol="${gnu_viol:+$gnu_viol$'\n'}$out"
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        _gnu_fail "$out"$'\n'"check-patterns: GNU-regex scan (non-tests/ pass) errored (exit $rc) - failing closed"
      fi
    fi
  fi
  if [ "${#gnu_tests[@]}" -gt 0 ]; then
    if out=$(_gnu_scan '*.py' "${gnu_tests[@]}"); then
      [ -n "$out" ] && gnu_viol="${gnu_viol:+$gnu_viol$'\n'}$out"
    else
      rc=$?
      if [ "$rc" -ge 2 ]; then
        _gnu_fail "$out"$'\n'"check-patterns: GNU-regex scan (tests/ pass) errored (exit $rc) - failing closed"
      fi
    fi
  fi
  if [ -n "$gnu_viol" ]; then
    # LC_ALL=C sort (byte order, not a locale collation - identical on BSD and
    # GNU sort) by PATH then LINE NUMBER, the two fields grep -Hn always
    # produces first: a hit's printed position stays independent of both
    # which pass produced it and filesystem readdir order. `-t:` keys on PATH
    # exactly because PATH holds no `:`: the gate fails closed on a root or a
    # file name holding one (see _code_of). check-patterns
    # is a lint tool, not a startup-path script, so this fork is fine.
    gnu_viol="$(printf '%s\n' "$gnu_viol" | LC_ALL=C sort -t: -k1,1 -k2,2n)"
    _err "$gnu_viol" \
      "$gnu_msg"
    bad=1
  fi
fi

# (9) forbid an EARLY-EXIT reader on the right of a pipe in the pipefail surface.
# `grep -q` (and -m, -l, -L) stops reading at its first match and `head` at its
# last line, closing the pipe while the writer may still be writing. bash
# line-buffers a builtin printf, so `printf '%s\n' "$multi_line" | grep -q X` is
# one write(2) PER LINE, and whether the reader has exited before the next one is
# pure scheduling. When it has, the writer dies of SIGPIPE (or prints "printf:
# write error: Broken pipe" where SIGPIPE is ignored, as on a CI runner), and
# under pipefail the PIPELINE fails even though grep matched: an assertion goes
# red at random (tests/packages_test.sh on macOS CI, 2026-09-25), and a NEGATED
# one (`if cmd | grep -q X; then fail`) goes silently green. The fix is always to
# remove the concurrent writer - a here-string (`grep -q X <<<"$var"`,
# `grep -q X <<<"$(cmd)"`), `[ -n "$(find ...)" ]` - or a reader that drains its
# input (`sed -n 1p` for `head -1`).
# SURFACE: every file that runs under pipefail - install.sh and the lib/ it sources,
# bin/, tests/, and the workflows (GitHub's bash steps run `-eo pipefail`). zsh/ is
# interactive config with no pipefail, and the Makefile's recipes run without it.
# Covered: `|` and `|&`, and grep, egrep and fgrep, behind env assignments.
# NOT covered: an awk that `exit`s early, `sed ... q`, a reader behind a
# function or variable, and a pipe that ENDS a line with the reader on the next
# one (`cmd |` newline `grep -q x`) - a line-oriented grep cannot see those.
# (The LEADING-pipe continuation, `\` newline `| grep -q x`, is caught.)
# KNOWN FALSE POSITIVES, both from matching text, not parsing shell: the shape
# inside a quoted string (`echo "a | grep -q b"`), and a flag-looking pattern
# argument read as a flag (`cmd | grep -e -l y`). Rephrase the line; neither
# shape exists in the tree.
_scan_roots install.sh lib bin tests .github/workflows
eex=(${roots[@]+"${roots[@]}"})
if [ "${#eex[@]}" -gt 0 ]; then
  eex_re='(^|[^|])\|&?[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*'
  eex_re="$eex_re"'([ef]?grep([[:space:]]+-[^[:space:]]*)*[[:space:]]+(-[A-Za-z]*[qmlL][A-Za-z0-9]*|--(quiet|silent|max-count[=[:alnum:]]*|files-with(out)?-match(es)?))([^[:alnum:]_-]|$)|head([^[:alnum:]_-]|$))'
  if out=$(grep -rHnaE --exclude=check-patterns -- "$eex_re" "${eex[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$eex_re")
    if [ -n "$viol" ]; then
      _err "$viol" \
        "check-patterns: an early-exit reader (grep -q/-m/-l, head) on the right of a pipe - under pipefail the writer can die of SIGPIPE and fail the pipeline at random; use a reader that drains its input (grep -c PAT, sed -n 1p)"
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: early-exit-reader scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (10) forbid a `--` AFTER the first operand of a file or text tool. macOS's
# tools parse argv with BSD getopt, which stops at the first non-option: in
# `chmod -R go-w -- "$d"` the mode ends option parsing, so the `--` is a FILE
# operand ("chmod: --: No such file or directory", exit 1). GNU getopt permutes
# argv and accepts either order, so no Linux run sees the break, and a caller
# that swallows the exit code hides it on a mac too: install.sh's
# harden_plugin_perms warned on every mac install this way while the macOS CI
# legs stayed green (measured 2026-09-25). The fix is always to move `--` in
# front of the first operand: `chmod -R -- go-w "$d"`, `grep -q -- "$pat" "$f"`.
# SURFACE: the same files as arm 8 - everything that runs on a mac.
# SHAPE: a command word in command position (line start; after `; & | ( ) { ! `,
# the `)` covering a case arm `pat) cmd`; or behind a workflow `run:`,
# then/do/else/elif/if/while/until/time/sudo/command/exec/env/nohup; then env
# assignments, then optionally a path), then option tokens, then a token that
# does not start with `-` (the first operand), then any tokens, then a bare `--`.
# A token is unquoted text plus WHOLE quoted strings, so a ` -- ` inside a quoted
# pattern is not the delimiter. An option that takes an argument (`grep -e PAT`,
# `mkdir -m 700`) would make a separate argument read as the first operand, so
# each tool family names its argument-taking short letters. The FIRST such
# letter in a cluster takes the argument, as getopt does: the rest of the
# cluster when anything follows it (`-em` is `-e m`), else the next token
# (`-qe PAT`). Families: chmod chown chgrp rm rmdir cat (none); cp mv ln (S t,
# GNU); mkdir (m); touch (A d r t); grep egrep fgrep (A B C D d e f m); sed
# (e f i).
# NOT covered: other tools (find has no such `--`: its paths come first); a
# command behind `\` (`\rm`), `env` or `sudo` with options (`env -i`,
# `sudo -n`), `coproc`, `$CMD` indirection, `find -exec`, xargs, an alias or an
# `sh -c '...'` string; and a call split across `\` lines.
# KNOWN FALSE POSITIVES, from matching text, not parsing shell: a LONG option
# that takes a separate argument (`grep --regexp PAT -- f`) reads PAT as the
# first operand - write `--regexp=PAT`; a redirection before the `--`
# (`rm 2>/dev/null -- f`) reads as the first operand - put it last; and quoted
# prose or an unquoted `$(...)` argument holding a separator or keyword before a
# tool name and a later ` -- ` (`warn "x; rm it by hand -- see docs"`) reads as
# a call - rephrase it. None of these exists in the tree.
_scan_roots install.sh lib bin zsh tests Makefile .github/workflows
dd=(${roots[@]+"${roots[@]}"})
if [ "${#dd[@]}" -gt 0 ]; then
  dd_pos='((^|[;&|(){!`])[[:space:]]*'                   # after a separator; `)` ends a case pattern
  dd_pos="$dd_pos"'|(^|[^[:alnum:]_-])(run:|then|do|else|elif|if|while|until|time|sudo|command|exec|env|nohup)[[:space:]]+)'
  dd_pos="$dd_pos"'([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*'  # env assignments: LC_ALL=C grep
  dd_pos="$dd_pos"'([^[:space:];&|()]*/)?'                 # a path prefix: /bin/rm
  # A TOKEN is unquoted text plus whole quoted strings, so a ` -- ` INSIDE a quoted
  # pattern (`grep -qx 'install --pin v1 -- gh'`) is not read as the delimiter. It
  # never crosses `; & | ( )`: a `)` closes the `$(...)` the command sits in.
  q="'"
  dd_qs="${q}[^${q}]*${q}|\"[^\"]*\""
  dd_tok="([^[:space:];&|()$q\"]|$dd_qs)+"
  dd_tail="[[:space:]]+([^-[:space:];&|()$q\"]|$dd_qs)([^[:space:];&|()$q\"]|$dd_qs)*"
  dd_tail="$dd_tail([[:space:]]+$dd_tok)*[[:space:]]+--([[:space:];&|)]|\$)"
  # _dd_family TOOLS LETTERS -> one alternative: TOOLS, their options, the tail.
  _dd_family() {
    local opt='[[:space:]]+(--[^[:space:]]+|-[^[:space:]-]+)'
    if [ -n "$2" ]; then
      # A cluster with no argument letter; or one whose FIRST argument letter takes
      # the rest of the cluster (`-em`); or one ending at that letter, which takes
      # the next token (`-qe PAT`).
      opt="[[:space:]]+(--[^[:space:]]+|-[^[:space:]$2-]+|-[^[:space:]$2-]*[$2]$dd_tok|-[^[:space:]$2-]*[$2][[:space:]]+$dd_tok)"
    fi
    printf '%s' "$dd_pos($1)($opt)*$dd_tail"
  }
  dd_re="$(_dd_family 'chmod|chown|chgrp|rm|rmdir|cat' '')"
  dd_re="$dd_re|$(_dd_family 'cp|mv|ln' 'St')"
  dd_re="$dd_re|$(_dd_family 'mkdir' 'm')"
  dd_re="$dd_re|$(_dd_family 'touch' 'Adrt')"
  dd_re="$dd_re|$(_dd_family '[ef]?grep' 'ABCDdefm')"
  dd_re="$dd_re|$(_dd_family 'sed' 'efi')"
  if out=$(grep -rHnaE --exclude=check-patterns -- "$dd_re" "${dd[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$dd_re")
    if [ -n "$viol" ]; then
      _err "$viol" \
        "check-patterns: a '--' after the first operand - BSD getopt (macOS) stops at the first non-option, so the '--' becomes a file operand; put it before the first operand (chmod -R -- go-w \"\$d\")"
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: '--' placement scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (11) forbid the Unicode em dash (U+2014, UTF-8 bytes E2 80 94) in the repo's
# own prose. House style (CONTRIBUTING.md, .claude/rules/docs.md) is a plain
# hyphen; this arm matches exactly that one character.
# The pattern is built at RUNTIME from its bytes ($'\xe2\x80\x94'), never
# pasted as a literal, so this file stays clean under its own self-scan below.
# `LC_ALL=C` keeps the match byte-oriented on both grep flavors: a
# locale-aware BSD grep can mishandle a line that also holds malformed UTF-8
# and silently skip the match.
# `-H`: grep drops the PATH prefix when it gets ONE operand (a tree whose
# only prose root is a single file), and both the report and the lazy-lock
# anchor below read that PATH.
# `--exclude=check-patterns` is not needed to keep this arm off its own
# pattern (nothing in the source spells it), but stays for uniformity:
# tests/plugins_test.sh asserts that EVERY recursive grep line here carries
# it and none carries `--exclude-dir`. It hides this file from the recursive
# scan, so a literal em dash pasted into it would pass (measured: exit 0);
# the narrow self-scan below closes that gap.
# Comments are NOT stripped (no _code_of/_code_hits, unlike arms 5-10): a
# comment is prose, the reasoning arms 1-2 use too.
# SURFACE: `${scan[@]}` plus the prose roots it lacks (docs/, tests/,
# .github/, .claude/, Makefile, the top-level docs and metadata files, and
# the repo's own dotfiles). No emptiness guard: `prose` contains `scan`, and
# an empty `scan` already exited 2 at the top.
# ALLOWLIST, content-independent path exclusions only:
#   - LICENSES/, COPYING and CODE_OF_CONDUCT.md are left OUT of the surface:
#     verbatim upstream legal text (GPL, the LICENSES/ texts, the Contributor
#     Covenant) never edited for house style, with no first-party content to
#     lose (see docs/development.md, "The gates", the paragraphs after the
#     gate table on files that cannot carry a header).
#   - config/nvim/lazy-lock.json, inside the scanned config/, is dropped from
#     the hit list: lazy.nvim rewrites it wholesale on every plugin update
#     (REUSE.toml), so a fix would not survive the next sync. The grep -v is
#     anchored to the EXACT path this scan reads it at, `_re_escape`d (see
#     arm 5): a substring or suffix match would also exempt a decoy such as
#     tests/config/nvim/lazy-lock.json - fail OPEN.
em_dash=$'\xe2\x80\x94'
_scan_roots docs tests .github .claude Makefile REUSE.toml cliff.toml \
  .gitleaks.toml .gitignore .gitmodules CLAUDE.md CONTRIBUTING.md \
  SECURITY.md THIRD-PARTY-NOTICES.md README.md
prose=("${scan[@]}" ${roots[@]+"${roots[@]}"})
_lazy_lock_path=$(_re_escape "$root/config/nvim/lazy-lock.json")
if out=$(LC_ALL=C grep -rHna --exclude=check-patterns \
    -F "$em_dash" "${prose[@]}" 2>&1); then
  viol=$(_drop_hits "$out" "^${_lazy_lock_path}:[0-9]+:" "lazy-lock.json")
  if [ -n "$viol" ]; then
    _err "$viol" \
      "check-patterns: an em dash (U+2014) in repo prose - house style is a plain '-'; replace it"
    bad=1
  fi
else
  rc=$?
  if [ "$rc" -ge 2 ]; then
    _err "$out" \
      "check-patterns: em-dash scan errored (exit $rc) - failing closed"
    bad=1; fatal=1
  fi
fi

# NARROW SELF-SCAN of exactly this file (self_cp, defined above arm 1),
# which the recursive scan above excludes by name.
if [ -f "$self_cp" ]; then
  if out=$(LC_ALL=C grep -Fna -- "$em_dash" "$self_cp" 2>&1); then
    _err "$out" \
      "check-patterns: an em dash (U+2014) in check-patterns' own source - house style is a plain '-'; replace it"
    bad=1
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: check-patterns self-scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (12) forbid a symlink where a recursive scan reads, plus (when `$root` has a
# .git of its own) a tracked symlink or a non-plugin gitlink anywhere in the
# repo. A recursive scan never follows a symlink it meets while walking a
# directory, so one there hides its target from every arm that walks past it.
#
# SURFACE: `prose`, arm (11)'s own surface (the widest above) - a single
# source, not a fourth hand-kept list - plus `scan_links`, the symlink
# entries of zsh/ that _scan_roots kept away from the grep arms. It holds no
# pinned zsh/plugins directory (_scan_roots left it out), so find never walks
# it either; a symlinked zsh/plugins is one of `scan_links` and is reported.
#
# ALWAYS: `find -type l` over that surface - what a recursive scan actually
# reads, tracked or not.
#
# ADDITIONALLY, since NO arm reads zsh/plugins/, anything there that is not a
# pinned plugin would hide from all of them:
#   - always: every direct child of a real zsh/plugins directory that is not
#     a directory (`find`), tracked or not. A plain directory there cannot be
#     told apart from an unpopulated submodule without git, so only the git
#     pass sees a file nested inside one;
#   - when `$root/.git` exists: every tracked entry under zsh/plugins/ whose
#     mode is not 160000 (a gitlink), and every other tracked non-gitlink
#     path that lands in zsh/plugins/ on disk anyway - its first two
#     segments spell zsh/plugins in another ASCII case, or the filesystem
#     resolves them to zsh/plugins (a case-insensitive filesystem, macOS's
#     default, folds more than ASCII) - in the repo-wide git pass below.
#
# ADDITIONALLY, when `$root/.git` exists: the WHOLE repository, tracked only,
# for what `find` cannot see - a tracked symlink outside `prose`, or a gitlink
# (mode 160000) that is not a pinned plugin. See `_git_symlink_pass`.
#
# FAILS CLOSED on any error from any pass, and when `$root/.git` exists but
# the git pass cannot run or resolve `$root` as its toplevel.
plugins_msg="check-patterns: an entry under zsh/plugins/ that is not a pinned plugin - no arm scans zsh/plugins/; move it out, or pin it as submodule.<name>.path = zsh/plugins/<name> in .gitmodules"
has_git=0
{ [ -e "$root/.git" ] || [ -L "$root/.git" ]; } && has_git=1
if out=$(find "${prose[@]}" ${scan_links[@]+"${scan_links[@]}"} -type l -print 2>&1); then
  viol="$out"
else
  rc=$?
  _err "$out" \
    "check-patterns: symlink scan (find) errored (exit $rc) - failing closed"
  bad=1; fatal=1
  viol=""
fi
if [ -n "$viol" ]; then
  _err "$viol" \
    "check-patterns: a symlink where a recursive scan reads - its target is never scanned; remove it or replace it with the real file"
  bad=1
fi

# NUL-BEARING FILES where the arms read: FAIL CLOSED (exit 2). grep reads a
# file with a NUL byte as binary, and with `-I` (the arms' old flag) skipped
# it whole, so a NUL anywhere in a file hid every violation in it (measured:
# `printf '# \000\n'` appended to this script beside a planted fetch piped
# into sh passed, exit 0). The arms now pass `-a` (read a binary file as
# text, GNU and BSD alike, which also stops GNU's UTF-8-locale habit of
# calling a file with an invalid byte binary), but a line tool's reading of
# a NUL is still not a contract, and no first-party file here needs one:
# refuse the file instead. The surface is `prose`, the widest the grep arms
# read (every arm's roots, this file included, lie inside it).
# Detection is bash's own `read -d ''`, which returns 0 only when it met a
# NUL delimiter: no fork per file, and a NUL at any offset counts (GNU grep's
# binary test samples the start of a large file and missed a late NUL,
# measured on an 800 KB file). An unreadable file fails closed too: its bytes
# were never checked. That is decided by the redirect itself, not an earlier
# `-r` test, so a file that turns unreadable after such a test cannot read
# as "no NUL": `nul_st` keeps `open-failed` unless the group behind the
# redirect ran.
# Cost, unmeasured: bash 3.2's `read -d ''` may read one byte per syscall.
# That matters only if `env bash` resolves to a 3.2 (the gate keeps to its
# syntax but runs on a modern bash in practice), and then only for time,
# never for the outcome.
nul_msg="check-patterns: a file holding a NUL byte where the arms read - grep reads it as binary, so no arm can be trusted to check it; remove the NUL byte or move the file out of the scanned surface"
nul_found=""
nul_lf=$'\n'
nul_rc=0
find "${prose[@]}" -type f -print0 >"$cp_tmp/nul-list" 2>"$cp_tmp/nul-find.err" || nul_rc=$?
if [ "$nul_rc" -ne 0 ]; then
  _err_file "$cp_tmp/nul-find.err"
  _err "check-patterns: NUL-byte scan (find) errored (exit $nul_rc) - failing closed"
  bad=1; fatal=1
else
  while IFS= read -r -d '' f; do
    nul_st=open-failed
    # read's status alone: 0 only when it met a NUL delimiter.
    { nul_st=none; IFS= read -r -d '' _ && nul_st=nul; } 2>/dev/null <"$f" || :
    case "$nul_st" in
      nul)
        printf -v q '%q' "$f"
        nul_found="$nul_found$q"$'\n' ;;
      open-failed)
        printf -v q '%q' "$f"
        _err "check-patterns: NUL-byte scan cannot read $q - failing closed"
        bad=1; fatal=1 ;;
    esac
  done <"$cp_tmp/nul-list"
  if [ -n "$nul_found" ]; then
    _err "${nul_found%"$nul_lf"}" "$nul_msg"
    bad=1; fatal=1
  fi
fi

# FILE NAMES the arms cannot read or skip, over the same surface as the find
# above, and (tracked) repo-wide in the git pass below. Each FAILS CLOSED with
# exit 2, since no arm result stands for such a tree:
#   - a `:`, LF or CR in a name. Every arm reports a hit as PATH:NN:CONTENT,
#     _code_of strips that prefix with `[^:]*:[0-9]+:`, and arm 8 sorts with
#     `-t:`; a line tool also splits on LF and CR. Measured: in `bin/q:1: #`
#     the strip leaves ` #...`, which empties every hit of arms 5-10.
#   - a file named `check-patterns` other than exactly $root/bin/check-patterns:
#     every recursive arm passes `--exclude=check-patterns`, a BASE-NAME match
#     at any depth, so nothing in it is ever scanned (measured: a curl piped into
#     sh in lib/sub/check-patterns passed). A directory of that name is still walked.
# zsh/plugins stays out for the reason every arm leaves it out: its contents
# are upstream's and no arm reads them. Names print `%q`-quoted, so a LF or
# CR in one shows as `$'...'`, not as a broken line.
nl=$'\n'
cr=$'\r'
names_msg="check-patterns: a file name holding ':', a newline or a CR - every arm reads a hit as PATH:NN:, so such a name can hide a violation; rename it"
stray_msg="check-patterns: a file named check-patterns outside bin/ - every recursive arm excludes that base name, so nothing in it is scanned; rename or remove it"
# _quote_nul EXCEPT - NUL-separated paths on stdin -> each one but EXCEPT,
# `%q`-quoted, one per line.
_quote_nul() {
  local p
  while IFS= read -r -d '' p; do
    [ "$p" = "$1" ] && continue
    printf '%q\n' "$p"
  done
}
# _name_pass MSG EXCEPT PREDICATE... - find over the surface; any match but
# EXCEPT prints with MSG and sets fatal=1, and the quoted list is left in
# `name_out` so the git pass below skips what it already printed. find's
# stderr cannot share the NUL stream, so it goes to a scratch file that
# _err_file prints: an error names the path it failed on, and that name is
# as hostile as any other (an unreadable dir named with OSC 52). A find error
# fails closed. `name_out` holds ONLY what was printed: on a find error the
# partial list is dropped, or the git pass would skip a tracked name nobody
# reported.
_name_pass() {
  local msg="$1" except="$2" names="" rc=0
  shift 2
  name_out=""
  names=$(find "${prose[@]}" ${scan_links[@]+"${scan_links[@]}"} \( "$@" \) -print0 2>"$cp_tmp/name-find.err" \
    | _quote_nul "$except") || rc=$?
  if [ "$rc" -ne 0 ]; then
    _err_file "$cp_tmp/name-find.err"
    _err "check-patterns: file-name scan (find) errored (exit $rc) - failing closed"
    bad=1; fatal=1
  elif [ -n "$names" ]; then
    _err "$names" \
      "$msg"
    fatal=1
    name_out="$names"
  fi
}
_name_pass "$names_msg" "" -name '*:*' -o -name "*$nl*" -o -name "*$cr*"
names_found="$name_out"
_name_pass "$stray_msg" "$root/bin/check-patterns" -name check-patterns ! -type d
stray_found="$name_out"

if [ -d "$root/zsh/plugins" ] && [ ! -L "$root/zsh/plugins" ]; then
  # -mindepth/-maxdepth: both GNU and BSD find. `! -type d` without -L
  # counts a symlink to a directory too.
  if out=$(find "$root/zsh/plugins" -mindepth 1 -maxdepth 1 ! -type d -print 2>&1); then
    if [ -n "$out" ]; then
      _err "$out" \
        "$plugins_msg"
      bad=1
    fi
  else
    rc=$?
    _err "$out" \
      "check-patterns: zsh/plugins scan (find) errored (exit $rc) - failing closed"
    bad=1; fatal=1
  fi
fi

# _git_symlink_pass - the repo-wide git pass; non-zero on a violation or any
# error. A subshell, so its EXIT trap removes the scratch dir on every path.
# Every status is checked by hand: the caller's `||` suspends `set -e` here.
#
# Every git call goes through `_git_clean`, which strips git's own local env
# vars first, so a leaked GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE cannot steer the
# probe or the listing at a different repository. That list comes from git
# itself, so an empty or failed answer, or one without GIT_DIR and
# GIT_INDEX_FILE, would strip nothing: it fails closed instead. Other ambient
# git tracing (the GIT_TRACE family, a trace2.* config key) cannot be
# enumerated, so stderr is kept apart from the NUL-delimited listing and ANY
# stderr from the listing fails closed; the probe's stderr is shown only when
# the probe itself fails.
#
# `-c core.fsmonitor=false` on every call that runs INSIDE `$root`: that key
# names a program, and git runs it even for a read-only ls-files.
_git_symlink_pass() (
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/check-patterns-sym.XXXXXX" 2>/dev/null) || {
    _err "check-patterns: could not create a scratch dir for the repo-wide symlink scan - failing closed"
    exit 2
  }
  trap 'rm -rf "$tmpd"' EXIT

  git_unset=()
  lev_rc=0
  git rev-parse --local-env-vars >"$tmpd/lev" 2>"$tmpd/lev.err" || lev_rc=$?
  has_dir=0
  has_index=0
  while IFS= read -r v; do
    case "$v" in
      GIT_DIR) has_dir=1 ;;
      GIT_INDEX_FILE) has_index=1 ;;
    esac
    [ -n "$v" ] && git_unset+=("$v")
  done <"$tmpd/lev"
  if [ "$lev_rc" -ne 0 ] || [ "$has_dir" -ne 1 ] || [ "$has_index" -ne 1 ]; then
    _err_file "$tmpd/lev.err"
    _err "check-patterns: symlink scan (git, repo-wide) could not list git's local env vars (git rev-parse --local-env-vars: exit $lev_rc, GIT_DIR listed: $has_dir, GIT_INDEX_FILE listed: $has_index) - failing closed"
    exit 2
  fi
  _git_clean() {
    local -a e=()
    local v
    if [ "${#git_unset[@]}" -gt 0 ]; then
      for v in "${git_unset[@]}"; do
        e+=(-u "$v")
      done
    fi
    env ${e[@]+"${e[@]}"} git "$@"
  }

  # Defensive: --show-toplevel runs no fsmonitor today (an equivalent
  # mutant), kept so every git call inside `$root` carries the flag.
  if ! top=$(_git_clean -C "$root" -c core.fsmonitor=false rev-parse --show-toplevel 2>"$tmpd/probe.err"); then
    _err_file "$tmpd/probe.err"
    _err "check-patterns: symlink scan (git, repo-wide) could not resolve the toplevel of '$root' - failing closed"
    exit 2
  fi
  # -ef compares device and inode, so a case-variant or symlinked spelling of
  # $root (macOS) still matches. A core.worktree or gitfile can point the work
  # tree away from $root even when $root/.git exists.
  if ! [ "$top" -ef "$root" ]; then
    _err "check-patterns: symlink scan (git, repo-wide) resolved a different toplevel ('$top') for '$root' - failing closed"
    exit 2
  fi

  # A pinned plugin is a `submodule.<name>.path` in .gitmodules AND a direct
  # child of zsh/plugins/ - read from .gitmodules, not a hand-kept list. Any
  # other `*.path` key, or a gitlink elsewhere, is not a pin.
  pinned=()
  if [ -f "$root/.gitmodules" ]; then
    gm_rc=0
    _git_clean config -f "$root/.gitmodules" --get-regexp '^submodule\..*\.path$' \
      >"$tmpd/gm" 2>"$tmpd/gm.err" || gm_rc=$?
    # exit 1 = no such key, an empty pin set; anything higher is an error.
    if [ "$gm_rc" -gt 1 ]; then
      _err_file "$tmpd/gm.err"
      _err "check-patterns: symlink scan (git, repo-wide) could not read .gitmodules (exit $gm_rc) - failing closed"
      exit 2
    fi
    while read -r _gm_key gm_path; do
      case "$gm_path" in
        zsh/plugins/*/*) ;;
        zsh/plugins/?*) pinned+=("$gm_path") ;;
      esac
    done <"$tmpd/gm"
  fi

  ls_rc=0
  _git_clean -C "$root" -c core.fsmonitor=false ls-files -s -z >"$tmpd/list" 2>"$tmpd/ls.err" || ls_rc=$?
  if [ "$ls_rc" -ne 0 ]; then
    _err_file "$tmpd/ls.err"
    _err "check-patterns: symlink scan (git ls-files, repo-wide) errored (exit $ls_rc) - failing closed"
    exit 2
  fi
  # ls-files' own stderr file: a traced probe above writes to stderr too.
  if [ -s "$tmpd/ls.err" ]; then
    _err_file "$tmpd/ls.err"
    _err "check-patterns: symlink scan (git ls-files, repo-wide) wrote to stderr (a GIT_TRACE* variable, or a trace2.* config key?) - failing closed"
    exit 2
  fi

  # `<mode> <oid> <stage><TAB><path>`, sha1 or sha256 oid. Anything else (a
  # trace aimed at stdout, say) fails closed rather than being skipped.
  rec_re=$'^[0-7]{6} [0-9a-f]{40,64} [0-3]\t.'
  git_viol=""
  plugins_viol=""
  names_viol=""
  stray_viol=""
  entry=""
  while IFS= read -r -d '' entry; do
    if ! [[ $entry =~ $rec_re ]]; then
      _err "check-patterns: symlink scan (git ls-files, repo-wide) returned a malformed record - failing closed"
      exit 2
    fi
    mode="${entry%% *}"
    gpath="${entry#*$'\t'}"
    # The file-name rules above, for every tracked path: outside the surface
    # too, which keeps this pass free of a copy of it. Not the exact
    # zsh/plugins/ spelling, left out as the find leaves it out.
    case "$gpath" in
      zsh/plugins/*) ;;
      *)
        case "$gpath" in
          *:* | *"$nl"* | *"$cr"*)
            printf -v q '%q' "$root/$gpath"
            case "$nl$names_found$nl" in
              *"$nl$q$nl"*) ;;  # the find above already printed it
              *) names_viol="$names_viol$q"$'\n' ;;
            esac ;;
        esac
        if [ "$mode" != 160000 ] && [ "${gpath##*/}" = check-patterns ] \
            && [ "$gpath" != bin/check-patterns ]; then
          printf -v q '%q' "$root/$gpath"
          case "$nl$stray_found$nl" in
            *"$nl$q$nl"*) ;;
            *) stray_viol="$stray_viol$q"$'\n' ;;
          esac
        fi ;;
    esac
    case "$mode" in
      120000)
        git_viol="$git_viol$root/$gpath"$'\n'
        ;;
      160000)
        allowed=0
        if [ "${#pinned[@]}" -gt 0 ]; then
          for a in "${pinned[@]}"; do
            [ "$gpath" = "$a" ] && { allowed=1; break; }
          done
        fi
        [ "$allowed" -eq 1 ] \
          || git_viol="$git_viol$root/$gpath (gitlink, not a pinned plugin)"$'\n'
        ;;
      *)
        # Bracket classes, not `tr` (a fork per entry) or nocasematch (a
        # shell-wide switch): the exact spelling is matched first, so the
        # second pattern only ever sees another case of it. They cover ASCII
        # case only, the same on every filesystem.
        listed=0
        case "$gpath" in
          zsh/plugins/*)
            plugins_viol="$plugins_viol$root/$gpath (tracked, mode $mode)"$'\n'
            listed=1 ;;
          [zZ][sS][hH]/[pP][lL][uU][gG][iI][nN][sS]/* | [zZ][sS][hH]/[pP][lL][uU][gG][iI][nN][sS])
            if [ "$gpath" != zsh/plugins ]; then
              plugins_viol="$plugins_viol$root/$gpath (tracked; the path case-folds to zsh/plugins, which a case-insensitive filesystem puts under zsh/plugins/)"$'\n'
              listed=1
            fi ;;
        esac
        # Any other spelling of the first two segments that the FILESYSTEM
        # resolves to zsh/plugins (APFS also folds non-ASCII, e.g. U+017F to
        # `s`): asked with -ef (device and inode), since no name match can know
        # its folding rules. Only zsh/plugins: a path that lands elsewhere in
        # zsh/ is scanned by every grep arm there. The exact zsh/plugins/
        # spelling never reaches here: it is `listed` above. Parameter
        # expansion only, no fork per entry.
        if [ "$listed" -eq 0 ]; then
          case "$gpath" in
            */*/*)
              gdir="${gpath%%/*}"
              grest="${gpath#*/}"
              gsub="${grest%%/*}"
              if [ "$root/$gdir/$gsub" -ef "$root/zsh/plugins" ]; then
                plugins_viol="$plugins_viol$root/$gpath (tracked; on disk, '$gdir/$gsub' is the same directory as zsh/plugins)"$'\n'
              fi ;;
          esac
        fi
        ;;
    esac
    entry=""
  done <"$tmpd/list"
  # read returns non-zero on a trailing record with no NUL terminator.
  if [ -n "$entry" ]; then
    _err "check-patterns: symlink scan (git ls-files, repo-wide) returned a malformed record - failing closed"
    exit 2
  fi

  rc=0
  if [ -n "$git_viol" ]; then
    _err "${git_viol%"$nl"}" \
      "check-patterns: a tracked symlink, or a gitlink that is not a pinned plugin - remove it; a plugin is pinned as submodule.<name>.path = zsh/plugins/<name> in .gitmodules"
    rc=1
  fi
  if [ -n "$plugins_viol" ]; then
    _err "${plugins_viol%"$nl"}" \
      "$plugins_msg"
    rc=1
  fi
  # 2, not 1: the caller turns it into the fail-closed exit.
  if [ -n "$names_viol" ]; then
    _err "${names_viol%"$nl"}" \
      "$names_msg"
    rc=2
  fi
  if [ -n "$stray_viol" ]; then
    _err "${stray_viol%"$nl"}" \
      "$stray_msg"
    rc=2
  fi
  exit "$rc"
)

if [ "$has_git" -eq 1 ]; then
  if ! command -v git >/dev/null 2>&1; then
    _err "check-patterns: symlink scan (git, repo-wide) cannot run: git is not on PATH, yet '$root/.git' exists - failing closed"
    bad=1; fatal=1
  else
    git_rc=0
    _git_symlink_pass || git_rc=$?
    [ "$git_rc" -eq 0 ] || bad=1
    [ "$git_rc" -ne 2 ] || fatal=1
  fi
fi

# (13) forbid a raw readlink of a link target in install.sh and lib/ outside
# the one helper that reads it exactly, lib/link.sh's _link_readlink.
# `$(readlink X)` strips every trailing newline of the target, so a target
# "T<newline>" reads as "T"; and the terminator itself is not portable (GNU
# readlink always appends one, BSD readlink only when the target does not
# already end in one), so no stripping after the fact can undo it. The
# helper's comment has the detail. The link engine decides "is this OUR link"
# on that answer, so a raw call there lets a crafted target pass for a repo
# path.
# SURFACE: install.sh (it sources lib/link.sh) and lib/, where the link
# engine and the uninstaller read link targets. bin/ is not scanned: its
# tools do not decide link ownership.
# SHAPE: the word readlink (or greadlink, coreutils' name on a Homebrew mac)
# in CODE, comments stripped (_code_hits): a bare call, a `$(readlink`, a
# path `/usr/bin/readlink`, `command readlink`. `_link_readlink` itself does
# not match: `_` is a word character, so the word boundary fails there.
# EXEMPTION, ONE line, found by awk at scan time, never a line number kept
# here: the line inside the body of the one `_link_readlink() {` definition
# in exactly $root/lib/link.sh whose text is exactly the helper's
# `t="$(readlink -n "$1" && printf x)" || return 1` (any indentation). The
# body is the lines after that definition up to the next line that is
# exactly `}` at column 0 (lib/'s function style). So the helper can move
# and stay exempt, while any other readlink - in another function of
# link.sh, in a same-named function elsewhere, in another shape inside the
# helper - is not. The awk answer is one line number, dropped by
# _drop_hits on the EXACT `_re_escape`d path (see arm 5), so a decoy
# lib/sub/link.sh does not share it.
#   - no definition (or no lib/link.sh): nothing to exempt; every hit is a
#     violation (exit 1). Not ambiguous: there is no helper to trust.
#   - more than one definition-shaped line (`_link_readlink()` or `function
#     _link_readlink`, comment lines aside), heredoc or string text included,
#     or the one not written exactly `_link_readlink() {`: which body is the
#     helper is ambiguous, so the gate FAILS CLOSED (exit 2) and exempts
#     nothing.
#   - a body that meets any other column-0 line before its `}` (`} # end`,
#     `} 2>/dev/null`, a new function), or never closes: void, exempts
#     nothing, so its hits are violations (exit 1). An indented `}` never
#     closes the body, and voids nothing on its own.
# FAILS CLOSED: an awk that fails, or answers anything but one line number
# (or nothing), exempts nothing and exits 2, like a failing grep.
# NOT covered: a readlink behind a variable (`$RL`), an alias, `stat -f %Y`,
# `realpath`, or `find -printf %l`. KNOWN FALSE POSITIVES, from matching text,
# not parsing shell: the word inside a string or as a name (`echo
# "readlink"`, `readlink=x`); rephrase it.
_scan_roots install.sh lib
rl_scan=(${roots[@]+"${roots[@]}"})
if [ "${#rl_scan[@]}" -gt 0 ]; then
  rl_re='(^|[^[:alnum:]_-])g?readlink([^[:alnum:]_-]|$)'
  rl_msg="check-patterns: a raw readlink in install.sh or lib/ outside lib/link.sh's _link_readlink - \$(readlink) strips a target's trailing newline and BSD readlink's terminator is not GNU's; call _link_readlink (or _link_target_is)"
  if out=$(grep -rHnaE --exclude=check-patterns -e "$rl_re" -- "${rl_scan[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$rl_re")
    rl_file="$root/lib/link.sh"
    if [ -n "$viol" ] && [ -f "$rl_file" ]; then
      # Bracket classes, never a backslash escape (`\(`, `\|`), whose meaning
      # in an awk ERE differs between BSD awk, mawk and gawk; `[ \t]`, not
      # `[[:space:]]`, for the same reason. The answer is ONE line: a line
      # number, nothing, or `refuse <reason>` for the fail-closed cases.
      rc=0
      rl_lines=$(awk '
        {
          code = $0
          sub(/^[ \t]*#.*/, "", code)
          isdef = (code ~ /(^|[^A-Za-z0-9_])(function[ \t]+_link_readlink([^A-Za-z0-9_]|$)|_link_readlink[ \t]*[(][ \t]*[)])/)
          if (isdef) {
            ndef++
            if ($0 !~ /^_link_readlink[(][)][ \t]*[{][ \t]*$/) badform = NR
            if (ndef == 1 && !badform) { inb = 1; next }
          }
          if (inb) {
            if ($0 ~ /^[}][ \t]*$/) { inb = 0; closed = 1; next }
            if ($0 ~ /^[^ \t]/) { inb = 0; voided = 1; next }
            if (!cand && $0 ~ /^[ \t]*t="[$][(]readlink -n "[$]1" && printf x[)]" [|][|] return 1[ \t]*$/) cand = NR
          }
        }
        END {
          if (ndef > 1) { print "refuse " ndef " definition-shaped _link_readlink lines"; exit }
          if (badform) { print "refuse line " badform " is not the exact `_link_readlink() {` form"; exit }
          if (closed && !voided && cand) print cand
        }
      ' "$rl_file" 2>"$cp_tmp/rl-awk.err") || rc=$?
      # rc 0 with an empty answer: nothing exempt. One line number: exempt
      # it. `refuse ...`: fail closed. Anything else is not awk's answer.
      rl_why=""
      case "$rc:$rl_lines" in
        0:) ;;
        0:refuse\ *) rl_why="${rl_lines#refuse }"; rc=2 ;;
        0:0* | 0:*[!0-9]*) rl_why="an unexpected answer from awk"; rc=2 ;;
        0:*) viol=$(_drop_hits "$viol" "^$(_re_escape "$rl_file"):$rl_lines:" "_link_readlink line") ;;
        *) rl_why="awk exited $rc" ;;
      esac
      if [ "$rc" -ne 0 ]; then
        if [ -f "$cp_tmp/rl-awk.err" ]; then
          _err_file "$cp_tmp/rl-awk.err"
        fi
        _err "check-patterns: the _link_readlink exemption lookup (awk) cannot trust lib/link.sh ($rl_why) - exempting nothing, failing closed"
        bad=1; fatal=1
      fi
    fi
    if [ -n "$viol" ]; then
      _err "$viol" \
        "$rl_msg"
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: raw-readlink scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (14) forbid a LOCALIZING declaration, or a loop variable, of zsh's
# command-search specials: the tied arrays path, cdpath, fpath, manpath,
# module_path and their scalars PATH, CDPATH, FPATH, MANPATH, MODULE_PATH.
# Inside a function `local path` (or `typeset`, `declare`, `integer`,
# `float`, `readonly`, `private`, all local there unless given -g, `-x`
# included) creates a function-local copy that KEEPS its special tie:
# assigning it rewrites $PATH for the rest of the call, so every command the
# function runs is looked up in the wrong place (zsh/functions.zsh's up()
# names its variable `target` for exactly this reason); a localized
# module_path steers zmodload the same way. A `for`, `foreach` or `select`
# loop variable of one of these names is not local at all: it overwrites the
# global.
# SURFACE: zsh/ (_scan_roots, so the pinned zsh/plugins leave by their exact
# path), the only zsh sources the framework ships.
# "INSIDE A FUNCTION": a line-based grep cannot tell a function body from the
# top level (a `{` may open a function, a brace group or an anonymous
# function). So this flags EVERY such declaration anywhere in the surface
# unless it carries -g, including a top-level one where zsh would make it
# global anyway: the fix there costs a `-g`, and the rule stays one a reader
# can apply without parsing. `local` is flagged with any options, `-g`
# included: zsh's local takes no -g. A plain assignment (`path=(...)`,
# zsh/zshrc) declares nothing and does not match; `export` is always global
# and is not a keyword here.
# SHAPE, on CODE (_code_hits): a keyword after a line start, whitespace, one
# of `; & | ( ) { } !` or a backtick, then EITHER
#   - a declaration: option words (`-x`, `+g`, `--`), none holding a `g` for
#     the -g-able keywords; then any names (not starting with `-` or `+`, so
#     an option word holding `g` cannot pass as one); then one of the ten
#     names, ended by `=`, whitespace, `; & | ) }` or end of line. `-g` is
#     tested per option word, so `typeset -Ug path`, `typeset -xg path` and
#     `typeset -U -g path` all pass, and a `g` in a later NAME buys nothing;
#   - a loop: `for`, `foreach` or `select`, then identifiers other than `in`,
#     then one of the ten names, ended by whitespace, `; & | ( )` or end of
#     line: `for path in ...`, `for x path (...)`. A name AFTER `in` is a
#     loop WORD, not the variable (`for d in path fpath`), and passes.
# NOT covered - a name word holding `(`, `)`, `;`, `&` or `|` ends the scan
# of that line, and quoting or escaping hides a name; each one is pinned as
# uncaught in tests/check_patterns_test.sh, so a widening is noticed:
# `local foo=$(pwd) path`, `local -a arr=() path`, `local x='a;b' path`,
# `local "path"`, `local p\ath`, `\local path`, `local {path,x}`; also a
# declaration split across `\` lines, a name built by expansion, mailpath
# (a localized one steers only mail checks), and the other writers of a
# global - `for (( path=0; ... ))`, `read path`, `getopts a: path` - which
# are assignments, excluded by design like `path=(...)`. KNOWN FALSE
# POSITIVE, from matching text, not parsing shell: the shape inside quoted
# prose followed by a space (`print "a local path here"`, `print "use for
# path lookup"`; `print "a local path"` does not fire, the `"` ends the
# name); rephrase it.
_scan_roots zsh
tied_scan=(${roots[@]+"${roots[@]}"})
if [ "${#tied_scan[@]}" -gt 0 ]; then
  tied_names='(path|cdpath|fpath|manpath|module_path|PATH|CDPATH|FPATH|MANPATH|MODULE_PATH)'
  tied_word='[^[:space:];&|)]'
  # An identifier other than `in`: `i`, one not starting with `i`, or one
  # starting with `i` that is not exactly `in`.
  tied_ident='(i|[A-Za-hj-z_][A-Za-z0-9_]*|i[A-Za-mo-z0-9_][A-Za-z0-9_]*|in[A-Za-z0-9_]+)'
  tied_re='(^|[[:space:];&|(){}!`])((local([[:space:]]+[-+]'"$tied_word"'*)*'
  tied_re="$tied_re"'|(typeset|declare|integer|float|readonly|private)([[:space:]]+(-[^[:space:];&|)g]*|[+]'"$tied_word"'*))*)'
  tied_re="$tied_re"'([[:space:]]+[^-+[:space:];&|)]'"$tied_word"'*)*'
  tied_re="$tied_re"'[[:space:]]+'"$tied_names"'(=|[[:space:];&|)}]|$)'
  tied_re="$tied_re"'|(for|foreach|select)([[:space:]]+'"$tied_ident"')*[[:space:]]+'"$tied_names"'([[:space:];&|()]|$))'
  if out=$(grep -rHnaE --exclude=check-patterns -e "$tied_re" -- "${tied_scan[@]}" 2>&1); then
    viol=$(printf '%s\n' "$out" | _code_hits "$tied_re")
    if [ -n "$viol" ]; then
      _err "$viol" \
        "check-patterns: a local/typeset without -g, or a for/foreach/select loop variable, of zsh's path, cdpath, fpath, manpath or module_path (or PATH, CDPATH, FPATH, MANPATH, MODULE_PATH) - a local copy keeps its tie and rewrites the command search path for the whole call, and a loop variable overwrites the global; rename the variable, or declare it -g"
      bad=1
    fi
  else
    rc=$?
    if [ "$rc" -ge 2 ]; then
      _err "$out" \
        "check-patterns: tied-path declaration scan errored (exit $rc) - failing closed"
      bad=1; fatal=1
    fi
  fi
fi

# (15) hold the prose of every Markdown file to 80 columns. A long line is
# unreadable in a terminal, a side-by-side diff and a review comment, and a
# paragraph rewrapped by hand drifts past the limit one edit at a time.
# SURFACE: every `*.md` file under `prose`, arm (11)'s surface, so
# CODE_OF_CONDUCT.md (verbatim upstream text) is out, and the pinned
# zsh/plugins with it. No Markdown file is generated today (release notes
# exist only on the GitHub release, see cliff.toml); a generated one must
# leave by its exact path, the way arm (11) drops lazy-lock.json.
# WIDTH is characters, not bytes. Under LC_ALL=C gawk, mawk and the
# classic onetrue awk (macOS) count bytes, so the UTF-8 continuation bytes
# (0x80-0xBF) are deleted before length(). The second-edition onetrue awk
# (2023 on) decodes UTF-8 whatever the locale: there length() already
# counts characters, and `[\200-\277]` would name U+0080-U+00BF (the micro,
# degree and section signs among them) instead of bytes. So BEGIN measures
# which kind of awk runs, by the length of a two-byte "e acute", and picks.
# A TAB counts as ONE column: the rule measures what a reflow can move, and
# no house doc indents prose with tabs. A CR before the LF (a CRLF file) is
# not a column: it is stripped before anything else reads the line, so a
# `---` CRLF front-matter line is still recognized.
# AN UNCLOSED FENCE runs to the end of its file, as GitHub renders it, so the
# rest of that file is code. UNCLOSED FRONT MATTER is not front matter: GitHub
# renders the `---` as a rule and the rest as prose, so the held lines are
# checked when the file ends. Every per-file state resets on its first line
# (FNR == 1), so it never leaks into the next file of the same awk run.
# BEGIN also self-tests the width probe on three two-byte characters and
# exits 2 (fail closed) on an awk and locale that count them wrong.
# EXEMPT, because a reflow cannot fix them or would change what renders:
#   - YAML front matter (a first line `---`, up to the next `---`);
#   - a fenced code block, fences included, at any indent (a fence inside a
#     list item sits past column 3); it closes on the same character, at
#     least as long, alone on its line;
#   - a table row (first non-blank character `|`), a heading (`#` to
#     `######`), a link reference definition (`[ref]: target`), an HTML
#     comment (the SPDX header), and a line opening with an HTML tag;
#   - a line that holds ONE unbreakable token once its indent, `>` quote
#     markers and list marker are set aside. A token runs from one space to
#     the next, except that a code span and a whole link or image
#     (`[text](dest)`) never break: wrapping one spills a command or a URL
#     across lines. So a long URL, code span or link alone on its line
#     passes, and one sharing its line with other words fails, since moving
#     it to its own line fixes the overflow.
# A line with two or more tokens over the limit can always be rewrapped, so
# every hit is fixable by a pure reflow with no word changed.
# Read as prose, so held to the limit: a Setext heading's text line, a line
# inside a multi-line HTML block that does not itself open with a tag, and an
# indented (4-space) code block.
md_width=80
# shellcheck disable=SC2016  # an awk program: its `$0` is awk's, never the shell's
md_width_awk='
BEGIN {
  u8 = (length("\303\251") == 1)
  # Self-test of the probe: an e acute, a micro and a degree sign are three
  # characters. Any awk and locale that the probe misreads fails closed.
  if (cols("\303\251\302\265\302\260") != 3) {
    print "awk: miscounts UTF-8 characters (the width probe self-test failed)"
    exit 2
  }
}
function cols(s,   t) {
  if (u8) return length(s)
  t = s; gsub(/[\200-\277]/, "", t); return length(t)
}
function skipcode(s, i, n,   run, j, r) {
  run = 0
  while (i <= n && substr(s, i, 1) == "`") { run++; i++ }
  j = i
  while (j <= n) {
    if (substr(s, j, 1) == "`") {
      r = 0
      while (j <= n && substr(s, j, 1) == "`") { r++; j++ }
      if (r == run) return j
    } else j++
  }
  return i
}
# pairs: ONE pass over the line, pairing each `[` with its `]` (pb) and each
# `(` with its `)` (pp) on two stacks, outside code spans and past a
# backslash escape. skiplink then looks a partner up instead of scanning,
# so a line of many brackets, nested or never closed, stays linear.
function pairs(s, n,   i, c, nb, np) {
  split("", pb); split("", pp); split("", sb); split("", sp)
  nb = 0; np = 0; i = 1
  while (i <= n) {
    c = substr(s, i, 1)
    if (c == "`") { i = skipcode(s, i, n); continue }
    if (c == "\\") { i += 2; continue }
    if (c == "[") sb[++nb] = i
    else if (c == "]") { if (nb) pb[sb[nb--]] = i }
    else if (c == "(") sp[++np] = i
    else if (c == ")") { if (np) pp[sp[np--]] = i }
    i++
  }
}
# skiplink: the index after a whole link or image `[text](dest)` opening at
# i, or 0 when it is not one.
function skiplink(s, i,   j) {
  if (substr(s, i, 1) == "!") i++
  if (!(i in pb)) return 0
  j = pb[i] + 1
  if (substr(s, j, 1) != "(" || !(j in pp)) return 0
  return pp[j] + 1
}
function tokens(s,   i, n, c, a, intok, j) {
  sub(/^[ \t]+/, "", s)
  while (match(s, /^>[ \t]*/)) s = substr(s, RLENGTH + 1)
  if (match(s, /^([-*+]|[0-9]+[.)])[ \t]+/)) s = substr(s, RLENGTH + 1)
  n = length(s); a = 0; intok = 0; i = 1
  pairs(s, n)
  while (i <= n) {
    c = substr(s, i, 1)
    if (c == " " || c == "\t") { intok = 0; i++; continue }
    if (!intok) { a++; intok = 1 }
    if (c == "`") { i = skipcode(s, i, n); continue }
    if (c == "[" || (c == "!" && substr(s, i + 1, 1) == "[")) {
      j = skiplink(s, i)
      if (j) { i = j; continue }
    }
    i++
  }
  return a
}
# check: one line of one file, after front matter is settled.
function check(line, file, nr,   f) {
  if (fence != "") {
    if (match(line, /^[ \t]*(```+|~~~+)[ \t]*$/)) {
      f = line; gsub(/[ \t]/, "", f)
      if (substr(f, 1, 1) == substr(fence, 1, 1) && length(f) >= length(fence)) fence = ""
    }
    return
  }
  if (match(line, /^[ \t]*(```+|~~~+)/)) {
    f = substr(line, RSTART, RLENGTH); gsub(/[ \t]/, "", f); fence = f; return
  }
  if (cmt) { if (index(line, "-->")) cmt = 0; return }
  if (line ~ /^[ \t]*<!--/) { if (!index(line, "-->")) cmt = 1; return }
  if (line ~ /^[ \t]*<\/?[A-Za-z][A-Za-z0-9-]*([ \t>\/]|$)/) return
  if (line ~ /^[ \t]*[|]/) return
  if (line ~ /^ {0,3}#{1,6}([ \t]|$)/) return
  if (line ~ /^ {0,3}\[[^]]+\]:/) return
  if (cols(line) > W && tokens(line) > 1) print file ":" nr ":" line
}
# flush: a front matter that never closed is not front matter (GitHub
# renders the `---` as a rule and the rest as prose), so its held lines are
# checked as prose after all.
function flush(   k) {
  if (!fm) return
  fm = 0
  check("---", fmfile, 1)
  for (k = 1; k <= nheld; k++) check(held[k], fmfile, k + 1)
}
{ sub(/\r$/, "") }
FNR == 1 {
  flush()
  fence = ""; cmt = 0; nheld = 0
  if ($0 == "---") { fm = 1; fmfile = FILENAME; next }
}
fm {
  if ($0 == "---") fm = 0
  else held[++nheld] = $0
  next
}
{ check($0, FILENAME, FNR) }
END { flush() }
'
if out=$(find "${prose[@]}" -type f -name '*.md' \
    -exec awk -v W="$md_width" "$md_width_awk" {} + 2>&1); then
  if [ -n "$out" ]; then
    _err "$out" \
      "check-patterns: a Markdown prose line over $md_width columns - rewrap the paragraph (a table row, heading, fenced block, HTML line, or a line holding one unbreakable URL, code span or link is exempt)"
    bad=1
  fi
else
  rc=$?
  _err "$out" \
    "check-patterns: Markdown line-width scan errored (exit $rc) - failing closed"
  bad=1; fatal=1
fi

# The fatal mark: a sanitizer failure or a re-test error inside a `$(...)`
# subshell, which cannot set `fatal` here.
[ ! -e "$cp_tmp/fatal" ] || fatal=1
[ "$fatal" -eq 0 ] || exit 2
# An explicit exit, not a bare failing test, which the ERR trap would turn
# into 2.
[ "$bad" -eq 0 ] || exit 1
