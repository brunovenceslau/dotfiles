# repo.env.example - template for ONE restic repository, as used by the
# restic-pass-cli / restic-op wrappers in zsh/restic.zsh.
#
# Copy it to $XDG_CONFIG_HOME/restic/<repo>.env (untracked, never committed -
# config/restic is gitignored except README.md and *.example, and the link engine
# never links this directory anywhere). The wrappers then take the <repo> part as
# their first argument:
#
#     cp config/restic/repo.env.example ~/.config/restic/photos_b2.env
#     $EDITOR ~/.config/restic/photos_b2.env
#     restic-pass-cli photos_b2 snapshots
#
# Naming convention: <repository-id>_<remote-id>.env, so one repository backed up
# to two places reads as two files that differ only in the remote half.
#
# EVERY VALUE IS A REFERENCE, NEVER A SECRET. `pass-cli run --env-file` (or
# `op run --env-file`) resolves each pass:// URI at call time and puts the result
# ONLY in restic's own environment - nothing is written to disk in the clear and
# nothing is exported into your shell. That is what makes these files safe to
# keep as plain text, and it is why a literal value here would be a mistake even
# though the file is untracked.

# Object-store credentials, when the repository is an S3-compatible remote.
# Omit both for a local or sftp repository.
AWS_ACCESS_KEY_ID="pass://vault/BACKUP/EXAMPLE_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="pass://vault/BACKUP/EXAMPLE_ACCESS_KEY_SECRET"

# The repository location. A local path may be given literally; a remote URL is
# a reference like everything else when it names a bucket you would rather not
# publish.
RESTIC_REPOSITORY="pass://vault/BACKUP/EXAMPLE_REPOSITORY"

# The repository password. ALWAYS a reference.
RESTIC_PASSWORD="pass://vault/BACKUP/EXAMPLE_PASSWORD"
