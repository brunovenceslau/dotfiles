# restic.env.example - placeholder template ONLY.
#
# This is NOT read by restic. Copy it to an unmanaged, local-only location and
# fill in real values, then source it (never commit the filled-in copy):
#     cp config/restic/restic.env.example ~/.config/restic/env
#     $EDITOR ~/.config/restic/env
#     chmod 600 ~/.config/restic/env
#     set -a; source ~/.config/restic/env; set +a
#
# Carries no real repository, remote, or password - safe to commit. Never put a
# real secret in a *.example file: that suffix stays tracked by design.

# Repository to back up to. Can be a local path, an sftp/rest URL, or an rclone
# remote (rclone:<remote>:<bucket>/<path>) - see config/rclone/README.md.
export RESTIC_REPOSITORY="rclone:example-remote:my-bucket/backups"

# Path to a file (mode 0600) containing ONLY the repository password. Preferred
# over RESTIC_PASSWORD so the secret never sits in the environment/process table.
export RESTIC_PASSWORD_FILE="$HOME/.config/restic/password"
