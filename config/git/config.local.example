# config/git/config.local.example - the shape of ~/.config/git/config.local,
# this host's untracked git config. ~/.config/git/config includes it with a
# relative path, so it belongs right there. Untracked, never published, never
# uninstalled. Holds THIS host's identity, its dedicated SSH signing key, and
# anything host-specific or secret.
#
# Pick one way to fill it, not both:
#   - run `./install.sh identity --name "Full Name"` from the checkout. It
#     writes user.name, user.email, user.signingkey, tag.gpgsign and
#     gpg.ssh.allowedSignersFile from this host's allowed-signers file and
#     ssh-agent, never overwriting a value already set (and commit.gpgsign
#     too, on a host where git does not read the tracked config). No copy
#     is needed;
#   - or copy this file and set every value by hand:
#         cp ~/.config/dotfiles/config/git/config.local.example ~/.config/git/config.local
#     then uncomment and edit each line below.
# The identity values are commented out on purpose: a placeholder left active
# (you@example.com) is a value already set, and the identity step keeps it
# and writes nothing beside it. (~/.config/git is a real directory the
# installer writes, not a link into this checkout, so the example is not
# beside it.) The rule the step follows is documented once, in
# docs/shell-reference.md ("install.sh identity"); rotating, revoking and
# opting a host out are in docs/signing-key.md.

# The tracked config sets user.useConfigOnly = true, so git refuses every
# commit until user.name and user.email are set here; it never invents them
# from this account and host name.
#
# Set by install.sh identity; uncomment only to set by hand.
# [user]
# 	name = Your Name
# 	email = you@example.com
# 	# The dedicated per-host SSH signing key's PUBLIC key. git signs with the
# 	# matching private key through the ssh-agent.
# 	signingkey = ~/.ssh/id_signing.pub

# The tracked config already sets commit.gpgsign = true, so with no
# user.signingkey above every commit fails. Opting this host out of signing
# is not a line to uncomment here: it is a decision, made on purpose with
#     git config --file ~/.config/git/config.local commit.gpgsign false
# git reads that false after the tracked true, the automatic step then
# writes and prints nothing, and `install.sh doctor --verbose` says so.
# Leave tag.gpgsign below commented on such a host: a true there keeps tags
# signed, and the host is not opted out. See "Keep a host from signing" in
# docs/signing-key.md.
#
# Set by install.sh identity, unless this host opted out; uncomment only to
# set by hand.
# [tag]
# 	gpgsign = true

# The allowed-signers file, one `<email> <keytype> <key>` line per trusted
# key: git verifies signatures against it (`git log --show-signature`), and
# install.sh identity reads it to find this host's identity. Untracked, like
# this file. Set by install.sh identity; uncomment only to set by hand.
# [gpg "ssh"]
# 	allowedSignersFile = ~/.config/git/allowed_signers
# 	# Keys that must never verify again (a lost or compromised key), one public
# 	# key per line. Create the file before you uncomment this: an unreadable
# 	# revocation file makes install.sh identity refuse to write.
# 	revocationFile = ~/.config/git/revoked_signers

# If this host fetches a PRIVATE repo over HTTPS, git needs a credential helper to
# authenticate. dotfiles-upgrade scrubs ambient git config and re-injects ONLY the
# credential.helper it reads from THIS file, so it must live here, not
# in ~/.gitconfig. The gh CLI provides one. Uncomment if you clone/fetch over HTTPS
# (a mac that authenticates via its SSH key does NOT need this):
# [credential "https://github.com"]
# 	helper =
# 	helper = !gh auth git-credential
# [credential "https://gist.github.com"]
# 	helper =
# 	helper = !gh auth git-credential
