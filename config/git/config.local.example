# config/git/config.local.example - copy to ~/.config/git/config.local and
# edit (the checkout path below is the default one):
#     cd ~/.config/dotfiles
#     cp config/git/config.local.example ~/.config/git/config.local
# (~/.config/git is a real directory the installer writes, not a link into
# this checkout, so the example is not beside it.) Untracked, never published,
# never uninstalled. Holds THIS host's identity, its dedicated SSH signing key,
# and anything host-specific or secret. ~/.config/git/config includes it with a
# relative path, so it belongs right there.
#
# `./install.sh identity [--name "Full Name"]` fills in user.email,
# user.signingkey, the two gpgsign keys and gpg.ssh.allowedSignersFile from
# this host's allowed-signers file and ssh-agent, never overwriting a value
# already set here. On a host not yet signing, `install`, `link` and every
# dotfiles-upgrade try the same, outside an SSH session, and `link` reports a
# configured key that no longer verifies.
# `./install.sh identity --rotate` replaces a signingkey that no longer
# verifies. The rule it follows is documented once, in
# docs/shell-reference.md ("install.sh identity").

[user]
	name = Your Name
	email = you@example.com
	# The dedicated per-host SSH signing key's PUBLIC key. Host-
	# specific and absolute, so it must not be tracked. git signs with the matching
	# private key via ssh-agent or the file. Adjust the name to your key.
	signingkey = ~/.ssh/id_ed25519_dotfiles.pub

# Turn signing on once the key above exists. Kept in .local, not the
# tracked config, so cloning on a machine without a key still lets you commit.
# An explicit `gpgsign = false` here is this host's exception to signing:
# `install.sh identity` keeps it and still writes the email and the key.
[commit]
	gpgsign = true
[tag]
	gpgsign = true
	# Refuse to create an ANNOTATED tag unsigned. Per-host, not tracked: it would
	# make `git tag -a` fail outright on a clone with no signing key.
	forceSignAnnotated = true

# To VERIFY SSH-signed commits - e.g. `git log
# --show-signature` - git needs an allowed-signers file listing the keys you
# trust, one `<email> <keytype> <key>` line each. It is untracked, like this
# file.
# `install.sh identity` reads the same file to find this host's identity:
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# If this host fetches a PRIVATE repo over HTTPS, git needs a credential helper to
# authenticate. dotfiles-upgrade scrubs ambient git config and re-injects ONLY the
# credential.helper it reads from THIS file, so it must live here, not
# in ~/.gitconfig. The gh CLI provides one. Uncomment if you clone/fetch over HTTPS
# (a mac that authenticates via its SSH key does NOT need this):
# [credential "https://github.com"]
# 	helper =
# 	helper = !gh auth git-credential
# [credential "https://gist.github.com"]
# 	helper =
# 	helper = !gh auth git-credential
