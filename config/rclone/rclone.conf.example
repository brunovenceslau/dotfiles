# rclone.conf.example - placeholder template ONLY.
#
# This is NOT read by rclone. Copy it to the real, unmanaged location and edit:
#     mkdir -p ~/.config/rclone
#     cp "$DOTFILES/config/rclone/rclone.conf.example" ~/.config/rclone/rclone.conf
#     chmod 600 ~/.config/rclone/rclone.conf
# Prefer `rclone config` (interactive) to generate real, encrypted credentials.
#
# Carries no real remotes, tokens, or passwords - safe to commit. Fill in your own
# values in the copy, never here. The repo's exceptions table NEVER links this dir,
# so nothing under it reaches ~/.config.

# [example-remote]
# type = s3
# provider = AWS
# access_key_id = YOUR_ACCESS_KEY_ID
# secret_access_key = YOUR_SECRET_ACCESS_KEY
# region = us-east-1
