# Palette convention inspired by gruvbox (https://github.com/morhetz/gruvbox).
# Three of the 19 distinct hex values are borrowed tones, named in the notes
# below: #928374 (gray_245), #d5c4a1 (light2), #ebdbb2 (light1). The other 16
# are this repo's own. See THIRD-PARTY-NOTICES.md.

# config/ghostty/themes/ipe-amarelo - "Ipê Amarelo" ported from the Alacritty
# theme family (config/alacritty/themes/ipe-amarelo.toml). Colour
# only. Activated by `theme = ...,dark:ipe-amarelo`. Palette is maintainer-fixed.
#
# The identity is gruvbox-INSPIRED rather than gruvbox, so where a value has to
# move for contrast it borrows the canonical gruvbox tone instead of inventing
# one. Four entries are derived that way; every ratio below is against #15120a:
#
#   foreground   gruvbox fg2 #d5c4a1, 10.90:1. The ported #e6ddc4 sat at
#                13.81:1 - white against this background is 18:1 - so ordinary
#                typed text ran near the top of the scale and glared at a
#                normal screen brightness.
#   palette 7    fg2 as well, 10.90:1. gruvbox holds foreground == palette 7;
#                the ported #d6ccb2 (11.70:1) instead put a plain `white` ABOVE
#                the default text, which is the door TUIs bring the glare back
#                through.
#   palette 15   gruvbox fg1 #ebdbb2, 13.63:1 - one step above that pair, the
#                distance gruvbox itself keeps between fg1 and fg0.
#   palette 8    gruvbox gray #928374, 5.10:1. The ported #3f3826 was 1.61:1,
#                which is invisible, and it is what a shell comment resolves to
#                (fast-syntax-highlighting styles comments fg=black,bold, and
#                config/ghostty/config sets bold-color = bright).
#
# Measure before moving any of them, and move them DOWN: the floor is 4.5:1,
# and the light theme's header records the same floor for its own side.
background = 15120a
foreground = d5c4a1
cursor-color = f4b400
cursor-text = 15120a
selection-background = 3c3316
selection-foreground = f3ecd6
palette = 0=#2b2618
palette = 1=#d0604a
palette = 2=#93a94e
palette = 3=#f4b400
palette = 4=#52a0c4
palette = 5=#c67fa4
palette = 6=#4fb39a
palette = 7=#d5c4a1
palette = 8=#928374
palette = 9=#e87d63
palette = 10=#b0c86a
palette = 11=#ffce55
palette = 12=#74c3e6
palette = 13=#e09cbf
palette = 14=#6ed3b7
palette = 15=#ebdbb2
