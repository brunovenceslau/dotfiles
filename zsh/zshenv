# zsh/zshenv - sourced for every zsh (login, interactive, scripts).
# Linked to ~/.zshenv, the ONLY framework-managed file in $HOME.
# Keep it tiny and fork-free: it runs even for non-interactive scripts.
#
# Export the XDG base dirs, ZDOTDIR, skip_global_compinit=1, and a
#   self-resolving $DOTFILES so the rest of the config can live under $ZDOTDIR
#   (XDG) instead of cluttering $HOME.

# XDG base directories - honor a pre-set value, otherwise the spec default.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# The framework's zsh config lives under $ZDOTDIR (so ~/.zshrc et al. never
# touch $HOME); install.sh links zshrc to $ZDOTDIR/.zshrc.
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Suppress a distro's /etc/zsh/zshrc global compinit - we run our own
# cached, byte-compiled compinit in zshrc, and a duplicate on the
# startup path is pure waste.
skip_global_compinit=1

# --- Interactive-program defaults --------------------------------------------
# All plain exports: no fork, and they must hold for non-interactive shells too
# (a git hook's $EDITOR, a script's $PAGER), which is why they live here and not
# in zshrc. Each honors a pre-set value so a calling environment still wins.
#
# EDITOR, VISUAL and LESSOPEN depend on which tools are on PATH, and PATH is not
# final here: this file runs BEFORE zshrc prepends the Homebrew prefix, so on a
# GUI-launched Apple Silicon terminal (launchd PATH, no /opt/homebrew/bin) a
# brew-installed nvim or lesspipe is invisible at this point. So the defaulting is
# a function: it runs once here for every shell, and zshrc runs it AGAIN right
# after its PATH block, then removes it. The _dotfiles_own_* flags record which
# variables were unset on entry, so the second pass only ever rewrites a value
# this file chose, never one the calling environment set.
# nvim is the editor (config/nvim), with vim as the fallback so a host without it
# is not left with `ed`. `$+commands` is a zsh builtin view, NOT a subprocess.
typeset -g _dotfiles_own_editor= _dotfiles_own_visual= _dotfiles_own_lessopen=
[[ -z ${EDITOR:-} ]] && _dotfiles_own_editor=1
[[ -z ${VISUAL:-} ]] && _dotfiles_own_visual=1
[[ -z ${LESSOPEN:-} ]] && _dotfiles_own_lessopen=1
_dotfiles_tool_defaults() {
  if [[ -n $_dotfiles_own_editor ]]; then
    if (( $+commands[nvim] )); then export EDITOR=nvim; else export EDITOR=vim; fi
  fi
  [[ -n $_dotfiles_own_visual ]] && export VISUAL="$EDITOR"
  # lesspipe, when installed, teaches less to page archives and PDFs.
  if [[ -n $_dotfiles_own_lessopen ]]; then
    if (( ${+commands[lesspipe.sh]} )); then
      export LESSOPEN="| ${commands[lesspipe.sh]} %s 2>&-"
    elif (( ${+commands[lesspipe]} )); then
      export LESSOPEN="| ${commands[lesspipe]} %s 2>&-"
    fi
  fi
  return 0
}
_dotfiles_tool_defaults
# A non-interactive shell never reaches zshrc's second pass, so it keeps nothing
# of the machinery - a script's namespace stays clean.
if [[ ! -o interactive ]]; then
  unfunction _dotfiles_tool_defaults
  unset _dotfiles_own_editor _dotfiles_own_visual _dotfiles_own_lessopen
fi
export PAGER="${PAGER:-less}"
export LANG="${LANG:-en_US.UTF-8}"

# less: -g highlight only the current match, -i smart case, -M long prompt,
# -R pass colour through, -w highlight the first new line after a jump.
# Deliberately WITHOUT the old setup's -X and -S: -X left the pager output in the
# scrollback but broke mouse scrolling, and -S truncated long lines instead of
# wrapping them, which silently hides the end of a diff line.
export LESS="${LESS:--g -i -M -R -w}"

# Homebrew: no usage analytics.
export HOMEBREW_NO_ANALYTICS=1

# Go, when it is installed. Pure `-d` tests, no fork.
if [[ -d /usr/local/go/bin ]]; then path=(/usr/local/go/bin $path); fi
if [[ -d $HOME/go ]]; then
  export GOPATH="$HOME/go"
  [[ -d $GOPATH/bin ]] && path=("$GOPATH/bin" $path)
fi

# starship reads ~/.config/starship.toml by default - a loose FILE, which the
# link engine's config/<prog>/ -> ~/.config/<prog> convention cannot produce. So
# the config is a normal linked DIR (~/.config/starship) and this points starship
# at the file inside it. A plain export: no fork, and it is needed by
# non-interactive `starship` invocations too, which is why it lives here rather
# than in zshrc.
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

# starship creates $STARSHIP_CACHE on every call, `starship init` included, and
# keeps its session logs there. Its default is ~/.cache/starship: it ignores
# XDG_CACHE_HOME (src/logger.rs upstream). That is outside $XDG_CACHE_HOME/zsh,
# the only cache tree `dotfiles-uninstall --purge` sweeps, so the purge left it
# behind. Pointing it under $XDG_CACHE_HOME/zsh makes the purge cover it
# with no new path to teach uninstall. install.sh's _cache_shell_inits runs
# starship from bash, which never reads this file, so it sets the same value
# itself. A plain export: no fork.
export STARSHIP_CACHE="$XDG_CACHE_HOME/zsh/starship"

# Self-resolving repo root. %N is the path of the file being sourced; :A
# canonicalizes it (following the ~/.zshenv symlink into the repo), and :h:h
# strips the trailing zsh/zshenv. No fork - pure zsh modifiers.
export DOTFILES="${${(%):-%N}:A:h:h}"

# BROWSER is macOS-only (`open` is not a portable command name).
[[ -z ${BROWSER:-} && $OSTYPE == darwin* ]] && export BROWSER=open

